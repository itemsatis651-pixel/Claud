         text_color = mtfAgreement == MtfAgreement.AGREE ? color.lime : mtfAgreement == MtfAgreement.CONFLICT ? color.orange : color.gray,
         text_halign = text.align_left)

    table.cell(debugTable, 0, 14, "RISK LONG", text_size = size.tiny, text_halign = text.align_left)
    table.cell(debugTable, 1, 14, riskLongText, text_size = size.tiny, text_color = longStatus == "OK" ? color.lime : longStatus == "ALREADY INVALIDATED" ? color.orange : color.gray, text_halign = text.align_left)

