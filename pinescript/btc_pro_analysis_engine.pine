//@version=6

// =============================================================================
// BTC PRO ANALYSIS ENGINE
// PHASE A (Data Gate) + PHASE B (Market Regime) + PHASE C (Structure + Zones)
// — built incrementally, one module at a time, each confirmed working before
// the next is added (Madde 122).
//
// MODULES INCLUDED SO FAR:
//   1. DATA GATE + SYMBOL VALIDATION + STATE MACHINE SKELETON (Madde 7, 1, 8, 55)
//      — confirmed working by user on OKX:BTCUSDT and TVC:DEU40.
//   2. MARKET REGIME + VOLATILITY REGIME + REGIME CONFIDENCE (Madde 9, 10, 11)
//      — confirmed working by user (TRANSITION/LOW confidence in a chop zone;
//      persistence/hysteresis held through Replay without flip-flopping).
//   3. MARKET STRUCTURE — CENTRAL CONFIRMED-SWING FUNCTION + HH/HL/LH/LL +
//      BOS/CHoCH (Madde 14, 61) — confirmed working by user, including that
//      swing markers only appear ~pivotRight bars after the fact (KNOWN_TIME
//      vs SWING_TIME, Madde 14) and are stable across reload/replay (no repaint).
//   4. SUPPORT/RESISTANCE ZONE ENGINE + CLUSTERING (Madde 15, 16) — next module
//      per the master hierarchy (Madde 4 groups this stage as "LOCATION /
//      ZONE", directly after MARKET STRUCTURE). Zones are built EXCLUSIVELY
//      from the central confirmed-swing function above (Madde 14 v3.1 EK) —
//      no separate pivot logic was invented here. Zone body = wick-to-body of
//      the swing's own candle (no arbitrary ATR-width guess). Nearby zones are
//      merged using ATR-relative distance (Madde 16); broken zones are flagged,
//      not deleted; freshness degrades with age and with repeated touches
//      ("exhausted", Madde 16).
//
// EXPLICITLY DEFERRED (not yet built — no silent/fake behavior, Madde 139/140):
//   - Fibonacci (Madde 17) and the full breakout/retest state machine (Madde
//     20-21) — next items in Phase C, separate modules from Zones.
//   - Full REACTION QUALITY per touch (needs Price Action + Participation/
//     volume evidence, Phase D) and HTF_IMPORTANCE (needs MTF, Phase E) are
//     NOT computed — Zone exposes freshness/touch-count/EMA-confluence only,
//     not a fabricated single "quality score".
//   - Regime Confidence's "structure agreement" factor (Madde 11) still NOT
//     wired up, same as before — deferred to its own reviewable step.
//   - Full Evidence Family aggregation / family caps (Madde 42) — deferred
//     until scoring/normalization (Madde 41) exists.
//   - MTF (request budget still 0/40, Madde 110), Compact panel (Madde 114),
//     Alert engine (Madde 116-117), Setup/Trigger/Risk/Veto/Decision engines,
//     WATCH/SETUP/... state transitions (state machine still only reaches
//     DATA_INVALID/FLAT — Setup Classifier, which would unlock WATCH, does
//     not exist yet).
//
// Non-repaint policy unchanged (Madde 33-34): all diagnostics are computed
// live every tick (clearly marked), but `currentState`, `primaryRegime`,
// `barsInRegime`, Structure state, and all Zone state only ever advance on
// barstate.isconfirmed. ta.* functions (pivots, crossover/crossunder) are
// called unconditionally every bar; only the resulting STATE UPDATE is gated.
// =============================================================================

indicator("BTC PRO ANALYSIS ENGINE — Phase A/B/C: Data Gate + Regime + Structure + Zones", shorttitle = "BTC-PRO-ABCD", overlay = true, max_labels_count = 200, max_boxes_count = 50)

var string ENGINE_VERSION = "v0.4.0-phaseC-zones"

// -----------------------------------------------------------------------------
// STATE MACHINE SKELETON (Madde 55)
// -----------------------------------------------------------------------------
enum EngineState
    DATA_INVALID
    FLAT
    WATCH
    SETUP
    ENTRY_PENDING
    CONFIRMED_LONG
    CONFIRMED_SHORT
    IN_POSITION
    EXIT
    COOLDOWN

f_stateLabel(EngineState s) =>
    switch s
        EngineState.DATA_INVALID   => "DATA_INVALID"
        EngineState.FLAT           => "FLAT"
        EngineState.WATCH          => "WATCH"
        EngineState.SETUP          => "SETUP"
        EngineState.ENTRY_PENDING  => "ENTRY_PENDING"
        EngineState.CONFIRMED_LONG => "CONFIRMED_LONG"
        EngineState.CONFIRMED_SHORT => "CONFIRMED_SHORT"
        EngineState.IN_POSITION    => "IN_POSITION"
        EngineState.EXIT           => "EXIT"
        EngineState.COOLDOWN       => "COOLDOWN"
        =>                             "UNKNOWN"

var EngineState currentState = EngineState.DATA_INVALID

// -----------------------------------------------------------------------------
// EVIDENCE FAMILY TAXONOMY (Madde 5) — documentation-only at this stage.
// No scoring/aggregation engine exists yet; this enum exists so each module's
// output can be explicitly tagged with the family it belongs to as it is
// built, instead of retrofitting the taxonomy later.
// Producers so far: CONTEXT_REGIME + VOLATILITY (Market Regime), STRUCTURE
// (also standing in for "Dow" per Madde 61), LOCATION (this Zone module —
// Madde 4 names the combined hierarchy stage "LOCATION / ZONE").
// -----------------------------------------------------------------------------
enum EvidenceFamily
    CONTEXT_REGIME
    DIRECTION
    STRUCTURE
    LOCATION
    TRIGGER
    PARTICIPATION
    MOMENTUM
    VOLATILITY
    MTF
    RISK
    EXECUTION

// -----------------------------------------------------------------------------
// MARKET REGIME ENUMS (Madde 9)
// -----------------------------------------------------------------------------
enum RegimeType
    BULL_TREND
    BEAR_TREND
    RANGE
    TRANSITION

enum VolRegime
    LOW_VOL
    NORMAL_VOL
    HIGH_VOL
    EXTREME_VOL

enum ConfidenceLevel
    LOW
    MEDIUM
    HIGH

f_regimeLabel(RegimeType r) =>
    switch r
        RegimeType.BULL_TREND => "BULL_TREND"
        RegimeType.BEAR_TREND => "BEAR_TREND"
        RegimeType.RANGE      => "RANGE"
        RegimeType.TRANSITION => "TRANSITION"
        =>                        "UNKNOWN"

f_volLabel(VolRegime v) =>
    switch v
        VolRegime.LOW_VOL     => "LOW_VOL"
        VolRegime.NORMAL_VOL  => "NORMAL_VOL"
        VolRegime.HIGH_VOL    => "HIGH_VOL"
        VolRegime.EXTREME_VOL => "EXTREME_VOL"
        =>                        "UNKNOWN"

f_confLabel(ConfidenceLevel c) =>
    switch c
        ConfidenceLevel.LOW    => "LOW"
        ConfidenceLevel.MEDIUM => "MEDIUM"
        ConfidenceLevel.HIGH   => "HIGH"
        =>                         "UNKNOWN"

// -----------------------------------------------------------------------------
// MARKET STRUCTURE ENUMS (Madde 14, 61)
// -----------------------------------------------------------------------------
enum SwingLabel
    NONE
    HH
    LH
    HL
    LL

enum StructureBias
    NEUTRAL
    BULLISH
    BEARISH

enum StructureEvent
    NONE
    BOS_UP
    BOS_DOWN
    CHOCH_UP
    CHOCH_DOWN

f_swingLabel(SwingLabel s) =>
    switch s
        SwingLabel.HH => "HH"
        SwingLabel.LH => "LH"
        SwingLabel.HL => "HL"
        SwingLabel.LL => "LL"
        =>                "N/A"

f_biasLabel(StructureBias b) =>
    switch b
        StructureBias.BULLISH => "BULLISH"
        StructureBias.BEARISH => "BEARISH"
        =>                        "NEUTRAL"

f_structEventLabel(StructureEvent e) =>
    switch e
        StructureEvent.BOS_UP    => "BOS UP"
        StructureEvent.BOS_DOWN  => "BOS DOWN"
        StructureEvent.CHOCH_UP  => "CHoCH UP"
        StructureEvent.CHOCH_DOWN => "CHoCH DOWN"
        =>                            "NONE"

// -----------------------------------------------------------------------------
// SUPPORT/RESISTANCE ZONE TYPE + HELPERS (Madde 15, 16) — built ONLY on top of
// the central confirmed-swing function; no separate pivot logic here. All
// helpers take their thresholds as explicit parameters (never read inputs or
// later-declared globals directly) so they stay safe to define this early.
// -----------------------------------------------------------------------------
type Zone
    float zoneHigh
    float zoneLow
    int   createdBar    // SWING_TIME of the swing that created/last extended it
    int   knownBar      // KNOWN_TIME the zone (or its last merge) became known
    int   lastTouchBar
    int   touchCount
    bool  broken
    int   brokenBar

f_upsertZone(array<Zone> zones, float zHigh, float zLow, int swingBar, int knownBar, float atrVal, float clusterMult, int maxZones) =>
    float newCenter = (zHigh + zLow) / 2
    int mergedIndex = -1
    if atrVal > 0
        for i = 0 to array.size(zones) - 1
            Zone z = array.get(zones, i)
            if not z.broken
                float zCenter = (z.zoneHigh + z.zoneLow) / 2
                if math.abs(newCenter - zCenter) <= atrVal * clusterMult
                    mergedIndex := i
                    break
    if mergedIndex >= 0
        Zone existing = array.get(zones, mergedIndex)
        existing.zoneHigh := math.max(existing.zoneHigh, zHigh)
        existing.zoneLow  := math.min(existing.zoneLow, zLow)
        existing.touchCount := existing.touchCount + 1
        existing.lastTouchBar := knownBar
    else
        Zone newZone = Zone.new(zoneHigh = zHigh, zoneLow = zLow, createdBar = swingBar, knownBar = knownBar, lastTouchBar = knownBar, touchCount = 1, broken = false, brokenBar = na)
        array.push(zones, newZone)
        if array.size(zones) > maxZones
            array.remove(zones, 0)
    true

f_updateZones(array<Zone> zones, bool isResistance, float barHigh, float barLow, float barClose, int curBar) =>
    for i = 0 to array.size(zones) - 1
        Zone z = array.get(zones, i)
        if not z.broken
            bool touched = barHigh >= z.zoneLow and barLow <= z.zoneHigh
            if touched and z.lastTouchBar != curBar
                z.touchCount := z.touchCount + 1
                z.lastTouchBar := curBar
            if isResistance and barClose > z.zoneHigh
                z.broken := true
                z.brokenBar := curBar
            if not isResistance and barClose < z.zoneLow
                z.broken := true
                z.brokenBar := curBar
    true

f_nearestZone(array<Zone> zones, float refPrice) =>
    float bestDist = na
    int bestIdx = -1
    for i = 0 to array.size(zones) - 1
        Zone z = array.get(zones, i)
        if not z.broken
            float center = (z.zoneHigh + z.zoneLow) / 2
            float dist = math.abs(refPrice - center)
            if na(bestDist) or dist < bestDist
                bestDist := dist
                bestIdx := i
    bestIdx

f_zoneFreshness(Zone z, int curBar, int freshAgeBars, int staleAgeBars, int exhaustTouches) =>
    age = curBar - z.createdBar
    z.touchCount >= exhaustTouches ? "EXHAUSTED" : age > staleAgeBars ? "STALE" : age <= freshAgeBars ? "FRESH" : "AGING"

f_emaConfluence(Zone z, float ef, float em, float es, float atrVal, float mult) =>
    float lo = z.zoneLow - atrVal * mult
    float hi = z.zoneHigh + atrVal * mult
    (ef >= lo and ef <= hi) or (em >= lo and em <= hi) or (es >= lo and es <= hi)

f_zoneSummary(array<Zone> zones, int idx, float ef, float em, float es, float atrVal, float confMult, int curBar, int freshAge, int staleAge, int exhaustN) =>
    string result = "NONE"
    if idx >= 0
        Zone z = array.get(zones, idx)
        string fresh = f_zoneFreshness(z, curBar, freshAge, staleAge, exhaustN)
        bool conf = f_emaConfluence(z, ef, em, es, atrVal, confMult)
        result := fresh + "  " + str.tostring(z.zoneLow) + "-" + str.tostring(z.zoneHigh) + " (" + str.tostring(z.touchCount) + "x)" + (conf ? " EMA" : "")
    result

// -----------------------------------------------------------------------------
// INPUTS — DATA GATE
// -----------------------------------------------------------------------------
grpSymbol = "Data Gate — Symbol & Source Validation"
i_expectedExchange = input.string("OKX", "Expected Exchange (syminfo.prefix)", group = grpSymbol,
     tooltip = "Uyuşmazsa DATA SOURCE WARNING üretilir (soft) — sistem otomatik durdurulmaz.")
i_expectedBase  = input.string("BTC",  "Expected Base Currency",  group = grpSymbol,
     tooltip = "Uyuşmazsa DATA INVALID üretilir (hard) — bu sistem yalnızca BTC içindir.")
i_expectedQuote = input.string("USDT", "Expected Quote Currency", group = grpSymbol)

grpGate = "Data Gate — Thresholds"
i_minBars = input.int(210, "Minimum Required Historical Bars", minval = 1, group = grpGate,
     tooltip = "EMA200 gibi göstergeler için gereken minimum geçmiş bar sayısı.")
i_gapMult = input.float(3.0, "Data Gap Multiplier (x expected bar interval)", minval = 1.1, group = grpGate)
i_abnormalAtrMult = input.float(8.0, "Abnormal Bar Range Multiplier (x ATR14)", minval = 1.0, group = grpGate)
i_staleBarsThreshold = input.int(10, "Stale Feed — Consecutive Identical Bars", minval = 2, group = grpGate)

// -----------------------------------------------------------------------------
// INPUTS — MARKET REGIME (Madde 9, 10, 13)
// -----------------------------------------------------------------------------
grpTrend = "Market Regime — Trend"
i_emaFastLen = input.int(20, "EMA Fast", minval = 1, group = grpTrend)
i_emaMidLen  = input.int(50, "EMA Mid", minval = 1, group = grpTrend)
i_emaSlowLen = input.int(200, "EMA Slow", minval = 1, group = grpTrend)
i_slopeLookback = input.int(10, "EMA Mid Slope Lookback (bars)", minval = 1, group = grpTrend)
i_adxLen = input.int(14, "ADX/DMI Length", minval = 1, group = grpTrend)
i_adxTrendThreshold = input.float(20.0, "ADX Trend Threshold", minval = 1, group = grpTrend,
     tooltip = "Başlangıç hipotezi — optimize edilmedi (Madde 10, 47).")

grpRange = "Market Regime — Range Detection"
i_rangeLookback = input.int(20, "Range Containment Lookback (bars)", minval = 2, group = grpRange)
i_rangeAtrThreshold = input.float(2.5, "Range Containment Threshold (band width / ATR)", minval = 0.5, group = grpRange)

grpRegimePersist = "Market Regime — Persistence"
i_regimeConfirmBars = input.int(3, "Regime Confirmation Bars (hysteresis)", minval = 1, group = grpRegimePersist,
     tooltip = "Tek barlık flip-flop'u önlemek için minimum onay bar sayısı (Madde 10).")

grpVol = "Volatility Regime"
i_volLookback = input.int(100, "ATR% Percentile Lookback (bars)", minval = 10, group = grpVol)
i_volLowPct = input.float(25.0, "Low Vol Percentile Ceiling", minval = 0, maxval = 100, group = grpVol)
i_volHighPct = input.float(75.0, "High Vol Percentile Floor", minval = 0, maxval = 100, group = grpVol)
i_volExtremePct = input.float(90.0, "Extreme Vol Percentile Floor", minval = 0, maxval = 100, group = grpVol)

// -----------------------------------------------------------------------------
// INPUTS — MARKET STRUCTURE (Madde 14)
// -----------------------------------------------------------------------------
grpStructure = "Market Structure — Swing Detection"
i_pivotLeft  = input.int(5, "Pivot Left Bars", minval = 1, group = grpStructure)
i_pivotRight = input.int(5, "Pivot Right Bars", minval = 1, group = grpStructure,
     tooltip = "Bir swing yalnızca sağında bu kadar bar oluştuktan sonra 'bilinir' (KNOWN_TIME != SWING_TIME, Madde 14). Repaint yok.")
i_showStructureMarks = input.bool(true, "Show Swing/BOS/CHoCH Markers", group = grpStructure)

// -----------------------------------------------------------------------------
// INPUTS — SUPPORT/RESISTANCE ZONES (Madde 15, 16)
// -----------------------------------------------------------------------------
grpZone = "Support/Resistance Zones"
i_maxZonesPerSide = input.int(6, "Max Zones per Side", minval = 1, maxval = 20, group = grpZone)
i_clusterAtrMult = input.float(1.0, "Cluster Merge Distance (x ATR)", minval = 0.1, group = grpZone,
     tooltip = "Madde 16 — yakın seviyeler tek zone'a birleştirilir, yüzlerce ayrı çizgi oluşmaz.")
i_freshAgeBars = input.int(20, "Fresh Zone Age Ceiling (bars)", minval = 1, group = grpZone)
i_staleAgeBars = input.int(150, "Stale Zone Age Floor (bars)", minval = 1, group = grpZone)
i_exhaustTouches = input.int(4, "Exhausted After N Touches", minval = 1, group = grpZone,
     tooltip = "Madde 16 — touch sayısı tek başına kalite değildir; çok test edilen zone exhausted sayılır.")
i_emaConfluenceAtrMult = input.float(0.5, "EMA Confluence Distance (x ATR)", minval = 0.05, group = grpZone)
i_showZones = input.bool(true, "Show Zones on Chart", group = grpZone)

grpDebug = "Diagnostics (temporary — replaced by the compact panel in a later phase)"
i_showDebug = input.bool(true, "Show Diagnostics Table", group = grpDebug)
i_showBg    = input.bool(true, "Highlight DATA_INVALID bars", group = grpDebug)

// -----------------------------------------------------------------------------
// SYMBOL / DATA SOURCE VALIDATION (Madde 1, 8)
// -----------------------------------------------------------------------------
exchangeOK   = str.upper(syminfo.prefix)      == str.upper(i_expectedExchange)
baseOK       = str.upper(syminfo.basecurrency) == str.upper(i_expectedBase)
quoteOK      = str.upper(syminfo.currency)     == str.upper(i_expectedQuote)
instrumentOK = baseOK and quoteOK   // hard: wrong instrument entirely (not BTC/USDT)

// Spot vs perpetual: never asserted with false confidence (Madde 1, 127, 139, 140).
tickerUpper     = str.upper(syminfo.ticker)
isPerpByType    = syminfo.type == "swap"
isPerpByTicker  = str.contains(tickerUpper, ".P") or str.contains(tickerUpper, "SWAP") or str.contains(tickerUpper, "PERP")
isSpotByType    = syminfo.type == "spot" or syminfo.type == "crypto"
marketTypeGuess = isPerpByType or isPerpByTicker ? "PERPETUAL (heuristic — verify)" :
                   isSpotByType and not isPerpByTicker ? "SPOT (heuristic — verify)" :
                   "UNKNOWN — VERIFY MANUALLY"

// -----------------------------------------------------------------------------
// DATA GATE CHECKS (Madde 7) — computed every tick for live diagnostics
// -----------------------------------------------------------------------------
ohlcValid = not na(open) and not na(high) and not na(low) and not na(close) and
             high >= low and high >= open and high >= close and low <= open and low <= close

volumeValid = not na(volume)   // NA stays NA — never silently treated as 0 (Madde 7)

sufficientHistory = bar_index >= (i_minBars - 1)

atrValue = ta.atr(14)
atrValid = not na(atrValue) and atrValue > 0

expectedIntervalMs = timeframe.in_seconds() * 1000
chartTypeOK = not na(expectedIntervalMs) and expectedIntervalMs > 0
dataGapDetected = chartTypeOK and bar_index > 0 and not na(time[1]) and
     (time - time[1]) > expectedIntervalMs * i_gapMult

barRange = high - low
abnormalBar = atrValid and barRange > atrValue * i_abnormalAtrMult

var int staleBars = 0
if barstate.isconfirmed
    isStaleRepeat = bar_index > 0 and open == open[1] and high == high[1] and low == low[1] and close == close[1]
    staleBars := isStaleRepeat ? staleBars + 1 : 0
staleDataDetected = staleBars >= i_staleBarsThreshold

// Aggregate — LIVE (not yet confirmed, for immediate diagnostics only; Madde 34)
liveDataValid = instrumentOK and ohlcValid and volumeValid and sufficientHistory and
     atrValid and not dataGapDetected and not abnormalBar and not staleDataDetected

// -----------------------------------------------------------------------------
// STATE TRANSITION — CONFIRMED BAR ONLY (Madde 33-34, non-repainting standard)
// -----------------------------------------------------------------------------
if barstate.isconfirmed
    if not liveDataValid
        currentState := EngineState.DATA_INVALID
    else if currentState == EngineState.DATA_INVALID
        currentState := EngineState.FLAT
    // else: currentState is FLAT (or, once later phases exist, a state those
    // modules manage) and data remains valid — nothing to do here. WATCH/SETUP/
    // ENTRY_PENDING/CONFIRMED_LONG/CONFIRMED_SHORT/IN_POSITION/EXIT/COOLDOWN
    // transitions are added when Setup/Trigger/Risk/Veto/Decision modules
    // exist (Phase C+/F onward).

// -----------------------------------------------------------------------------
// MARKET REGIME — TREND (Madde 10, 13). Structure/Zone exist now (below) but
// are NOT yet wired into Regime Confidence — see header note.
// -----------------------------------------------------------------------------
emaFast = ta.ema(close, i_emaFastLen)
emaMid  = ta.ema(close, i_emaMidLen)
emaSlow = ta.ema(close, i_emaSlowLen)

emaAlignmentBull = emaFast > emaMid and emaMid > emaSlow
emaAlignmentBear = emaFast < emaMid and emaMid < emaSlow
priceAboveAll = close > emaFast and close > emaMid and close > emaSlow
priceBelowAll = close < emaFast and close < emaMid and close < emaSlow
slopeUp   = emaMid > emaMid[i_slopeLookback]
slopeDown = emaMid < emaMid[i_slopeLookback]

[diPlus, diMinus, adxValue] = ta.dmi(i_adxLen, i_adxLen)
diBullish   = diPlus > diMinus
trendStrong = not na(adxValue) and adxValue >= i_adxTrendThreshold

bullVotes = (emaAlignmentBull ? 1 : 0) + (priceAboveAll ? 1 : 0) + (slopeUp ? 1 : 0) + (diBullish ? 1 : 0)
bearVotes = (emaAlignmentBear ? 1 : 0) + (priceBelowAll ? 1 : 0) + (slopeDown ? 1 : 0) + (not diBullish ? 1 : 0)

rangeBandWidth = ta.highest(high, i_rangeLookback) - ta.lowest(low, i_rangeLookback)
priceContained = atrValid and rangeBandWidth < atrValue * i_rangeAtrThreshold

rawRegime = trendStrong and bullVotes >= 3 ? RegimeType.BULL_TREND :
             trendStrong and bearVotes >= 3 ? RegimeType.BEAR_TREND :
             not trendStrong and priceContained ? RegimeType.RANGE :
             RegimeType.TRANSITION

// Persistence / hysteresis (Madde 10) — only advances on confirmed, data-valid bars.
var RegimeType primaryRegime = RegimeType.TRANSITION
var RegimeType pendingRegime = RegimeType.TRANSITION
var int pendingBars  = 0
var int barsInRegime = 0

if barstate.isconfirmed and currentState != EngineState.DATA_INVALID
    pendingBars  := rawRegime == pendingRegime ? pendingBars + 1 : 1
    pendingRegime := rawRegime

    if pendingBars >= i_regimeConfirmBars and primaryRegime != pendingRegime
        primaryRegime := pendingRegime
        barsInRegime  := 1
    else
        barsInRegime := barsInRegime + 1

// -----------------------------------------------------------------------------
// VOLATILITY REGIME (Madde 9, 26) — separate overlay, never mixed with primaryRegime.
// -----------------------------------------------------------------------------
atrPct     = atrValid ? (atrValue / close) * 100 : na
atrPctRank = na(atrPct) ? na : ta.percentrank(atrPct, i_volLookback)

volRegime = na(atrPctRank) ? VolRegime.NORMAL_VOL :
             atrPctRank >= i_volExtremePct ? VolRegime.EXTREME_VOL :
             atrPctRank >= i_volHighPct ? VolRegime.HIGH_VOL :
             atrPctRank <= i_volLowPct ? VolRegime.LOW_VOL :
             VolRegime.NORMAL_VOL

// -----------------------------------------------------------------------------
// REGIME CONFIDENCE (Madde 11 + v3.1 EK) — NOT a binding gate yet (that belongs
// to the Decision Engine, Madde 37, Phase F); exposed here for later use.
// Structure-agreement factor still NOT included (see header note).
// -----------------------------------------------------------------------------
maxVotes = math.max(bullVotes, bearVotes)
trendAgreementScore = maxVotes >= 4 ? 2 : maxVotes == 3 ? 1 : 0
volStabilityScore   = volRegime == VolRegime.EXTREME_VOL ? 0 : 1
persistenceScore    = barsInRegime >= i_regimeConfirmBars * 2 ? 1 : 0
confidenceScoreRaw  = trendAgreementScore + volStabilityScore + persistenceScore

regimeConfidence = primaryRegime == RegimeType.TRANSITION ? ConfidenceLevel.LOW :
                     confidenceScoreRaw >= 3 ? ConfidenceLevel.HIGH :
                     confidenceScoreRaw == 2 ? ConfidenceLevel.MEDIUM :
                     ConfidenceLevel.LOW

// -----------------------------------------------------------------------------
// MARKET STRUCTURE — CENTRAL CONFIRMED-SWING FUNCTION (Madde 14 v3.1 EK)
// ta.pivothigh/low are called UNCONDITIONALLY every bar (required for correct
// internal history tracking); only the resulting state update is gated on
// barstate.isconfirmed below.
// -----------------------------------------------------------------------------
pivotHighPrice = ta.pivothigh(i_pivotLeft, i_pivotRight)
pivotLowPrice  = ta.pivotlow(i_pivotLeft, i_pivotRight)

var float lastSwingHighPrice    = na   // last CONFIRMED swing high (KNOWN at lastSwingHighKnownBar)
var int   lastSwingHighSwingBar = na   // SWING_TIME (bar it actually occurred)
var int   lastSwingHighKnownBar = na   // KNOWN_TIME (bar the script learned about it)
var float prevSwingHighPrice    = na

var float lastSwingLowPrice    = na
var int   lastSwingLowSwingBar = na
var int   lastSwingLowKnownBar = na
var float prevSwingLowPrice    = na

var SwingLabel lastHighLabel = SwingLabel.NONE
var SwingLabel lastLowLabel  = SwingLabel.NONE
var StructureBias structureBias = StructureBias.NEUTRAL
var StructureEvent lastStructureEvent = StructureEvent.NONE
var int lastStructureEventBar = na

// Zone stores (Madde 15, 16) — resistance from confirmed swing highs, support
// from confirmed swing lows.
var array<Zone> resistanceZones = array.new<Zone>()
var array<Zone> supportZones    = array.new<Zone>()

// Break-of-level checks against the most recently CONFIRMED swing levels.
// Called UNCONDITIONALLY every bar (ta.crossover/crossunder must not be
// called inside an `if` — Madde 124 syntax/logic QA); only the resulting
// state update (below) is confirmed-bar-gated, so no repaint/future leak.
crossedAboveLastHigh = ta.crossover(close, lastSwingHighPrice)
crossedBelowLastLow  = ta.crossunder(close, lastSwingLowPrice)

bosUpEvent    = false
bosDownEvent  = false
chochUpEvent  = false
chochDownEvent = false

if barstate.isconfirmed
    // 1) Register new confirmed swings (Madde 14 — KNOWN_TIME vs SWING_TIME)
    //    and create/cluster the corresponding zone (Madde 15, 16). Zone body
    //    is the swing candle's wick-to-body span — no arbitrary ATR guess.
    if not na(pivotHighPrice)
        prevSwingHighPrice := lastSwingHighPrice
        lastHighLabel := na(prevSwingHighPrice) ? SwingLabel.NONE : (pivotHighPrice > prevSwingHighPrice ? SwingLabel.HH : SwingLabel.LH)
        lastSwingHighPrice := pivotHighPrice
        lastSwingHighSwingBar := bar_index - i_pivotRight
        lastSwingHighKnownBar := bar_index
        zoneLowBoundHigh = math.max(open[i_pivotRight], close[i_pivotRight])
        f_upsertZone(resistanceZones, pivotHighPrice, zoneLowBoundHigh, bar_index - i_pivotRight, bar_index, atrValue, i_clusterAtrMult, i_maxZonesPerSide)

    if not na(pivotLowPrice)
        prevSwingLowPrice := lastSwingLowPrice
        lastLowLabel := na(prevSwingLowPrice) ? SwingLabel.NONE : (pivotLowPrice > prevSwingLowPrice ? SwingLabel.HL : SwingLabel.LL)
        lastSwingLowPrice := pivotLowPrice
        lastSwingLowSwingBar := bar_index - i_pivotRight
        lastSwingLowKnownBar := bar_index
        zoneHighBoundLow = math.min(open[i_pivotRight], close[i_pivotRight])
        f_upsertZone(supportZones, zoneHighBoundLow, pivotLowPrice, bar_index - i_pivotRight, bar_index, atrValue, i_clusterAtrMult, i_maxZonesPerSide)

    // 2) BOS / CHoCH — break of a previously CONFIRMED swing level (Madde 14, 61).
    // First break after NEUTRAL establishes initial bias (treated as CHoCH);
    // a break agreeing with current bias is BOS (continuation), a break
    // against it is CHoCH (reversal).
    if crossedAboveLastHigh
        if structureBias == StructureBias.BULLISH
            bosUpEvent := true
            lastStructureEvent := StructureEvent.BOS_UP
        else
            chochUpEvent := true
            structureBias := StructureBias.BULLISH
            lastStructureEvent := StructureEvent.CHOCH_UP
        lastStructureEventBar := bar_index

    if crossedBelowLastLow
        if structureBias == StructureBias.BEARISH
            bosDownEvent := true
            lastStructureEvent := StructureEvent.BOS_DOWN
        else
            chochDownEvent := true
            structureBias := StructureBias.BEARISH
            lastStructureEvent := StructureEvent.CHOCH_DOWN
        lastStructureEventBar := bar_index

    // 3) Ongoing touch-count / broken-status maintenance for ALL existing
    //    zones, every confirmed bar (Madde 15, 16) — independent of whether
    //    a new swing formed this bar.
    f_updateZones(resistanceZones, true, high, low, close, bar_index)
    f_updateZones(supportZones, false, high, low, close, bar_index)

swingHighAgeText = na(lastSwingHighSwingBar) ? "N/A" : str.tostring(bar_index - lastSwingHighSwingBar) + " bars ago"
swingLowAgeText  = na(lastSwingLowSwingBar) ? "N/A" : str.tostring(bar_index - lastSwingLowSwingBar) + " bars ago"
lastEventAgeText = na(lastStructureEventBar) ? "" : " (" + str.tostring(bar_index - lastStructureEventBar) + " bars ago)"

nearestResIdx = f_nearestZone(resistanceZones, close)
nearestSupIdx = f_nearestZone(supportZones, close)
resZoneText = f_zoneSummary(resistanceZones, nearestResIdx, emaFast, emaMid, emaSlow, atrValue, i_emaConfluenceAtrMult, bar_index, i_freshAgeBars, i_staleAgeBars, i_exhaustTouches)
supZoneText = f_zoneSummary(supportZones, nearestSupIdx, emaFast, emaMid, emaSlow, atrValue, i_emaConfluenceAtrMult, bar_index, i_freshAgeBars, i_staleAgeBars, i_exhaustTouches)

// -----------------------------------------------------------------------------
// DIAGNOSTICS (temporary — NOT the Madde 114 panel)
// -----------------------------------------------------------------------------
reasons = array.new<string>()
if not instrumentOK
    array.push(reasons, "INSTRUMENT MISMATCH")
if not exchangeOK
    array.push(reasons, "EXCHANGE WARNING")
if not ohlcValid
    array.push(reasons, "OHLC INVALID")
if not volumeValid
    array.push(reasons, "VOLUME NA")
if not sufficientHistory
    array.push(reasons, "INSUFFICIENT HISTORY")
if not atrValid
    array.push(reasons, "ATR UNAVAILABLE")
if not chartTypeOK
    array.push(reasons, "NON-TIME-BASED CHART (GAP CHECK DISABLED)")
if dataGapDetected
    array.push(reasons, "DATA GAP")
if abnormalBar
    array.push(reasons, "ABNORMAL BAR")
if staleDataDetected
    array.push(reasons, "STALE FEED")
reasonsText = array.size(reasons) > 0 ? array.join(reasons, ", ") : "NONE"

var table debugTable = table.new(position.top_right, 2, 24, border_width = 1)

if i_showDebug and barstate.islast
    table.cell(debugTable, 0, 0, "ENGINE", text_color = color.white, bgcolor = color.new(color.navy, 0), text_halign = text.align_left)
    table.cell(debugTable, 1, 0, ENGINE_VERSION, text_color = color.white, bgcolor = color.new(color.navy, 0), text_halign = text.align_left)

    table.cell(debugTable, 0, 1, "STATE", text_halign = text.align_left)
    table.cell(debugTable, 1, 1, f_stateLabel(currentState), text_color = currentState == EngineState.DATA_INVALID ? color.red : color.lime, text_halign = text.align_left)

    table.cell(debugTable, 0, 2, "DATA GATE (live)", text_halign = text.align_left)
    table.cell(debugTable, 1, 2, liveDataValid ? "VALID" : "INVALID", text_color = liveDataValid ? color.lime : color.red, text_halign = text.align_left)

    table.cell(debugTable, 0, 3, "SYMBOL", text_halign = text.align_left)
    table.cell(debugTable, 1, 3, syminfo.tickerid, text_halign = text.align_left)

    table.cell(debugTable, 0, 4, "EXCHANGE", text_halign = text.align_left)
    table.cell(debugTable, 1, 4, syminfo.prefix + (exchangeOK ? "" : " (expected " + i_expectedExchange + ")"), text_color = exchangeOK ? color.gray : color.orange, text_halign = text.align_left)

    table.cell(debugTable, 0, 5, "INSTRUMENT", text_halign = text.align_left)
    table.cell(debugTable, 1, 5, syminfo.basecurrency + "/" + syminfo.currency, text_color = instrumentOK ? color.gray : color.red, text_halign = text.align_left)

    table.cell(debugTable, 0, 6, "MARKET TYPE", text_halign = text.align_left)
    table.cell(debugTable, 1, 6, marketTypeGuess, text_halign = text.align_left)

    table.cell(debugTable, 0, 7, "BARS", text_halign = text.align_left)
    table.cell(debugTable, 1, 7, str.tostring(bar_index + 1) + " / " + str.tostring(i_minBars), text_color = sufficientHistory ? color.gray : color.red, text_halign = text.align_left)

    table.cell(debugTable, 0, 8, "OHLC / VOLUME", text_halign = text.align_left)
    table.cell(debugTable, 1, 8, (ohlcValid ? "OK" : "INVALID") + " / " + (volumeValid ? "OK" : "NA"), text_color = (ohlcValid and volumeValid) ? color.gray : color.red, text_halign = text.align_left)

    table.cell(debugTable, 0, 9, "GAP / ABNORMAL / STALE", text_halign = text.align_left)
    table.cell(debugTable, 1, 9, (dataGapDetected or abnormalBar or staleDataDetected) ?
         ((dataGapDetected ? "GAP " : "") + (abnormalBar ? "ABN " : "") + (staleDataDetected ? "STALE" : "")) : "OK",
         text_color = (dataGapDetected or abnormalBar or staleDataDetected) ? color.red : color.gray, text_halign = text.align_left)

    table.cell(debugTable, 0, 10, "ISSUES", text_halign = text.align_left)
    table.cell(debugTable, 1, 10, reasonsText, text_color = array.size(reasons) > 0 ? color.orange : color.gray, text_halign = text.align_left)

    table.cell(debugTable, 0, 11, "REGIME", text_halign = text.align_left)
    table.cell(debugTable, 1, 11, f_regimeLabel(primaryRegime) + " (" + str.tostring(barsInRegime) + " bars)",
         text_color = primaryRegime == RegimeType.BULL_TREND ? color.lime : primaryRegime == RegimeType.BEAR_TREND ? color.red : primaryRegime == RegimeType.RANGE ? color.yellow : color.gray,
         text_halign = text.align_left)

    table.cell(debugTable, 0, 12, "REGIME CONFIDENCE", text_halign = text.align_left)
    table.cell(debugTable, 1, 12, f_confLabel(regimeConfidence),
         text_color = regimeConfidence == ConfidenceLevel.HIGH ? color.lime : regimeConfidence == ConfidenceLevel.MEDIUM ? color.yellow : color.red,
         text_halign = text.align_left)

    table.cell(debugTable, 0, 13, "TREND VOTES (bull/bear)", text_halign = text.align_left)
    table.cell(debugTable, 1, 13, str.tostring(bullVotes) + "/4  " + str.tostring(bearVotes) + "/4", text_halign = text.align_left)

    table.cell(debugTable, 0, 14, "ADX(" + str.tostring(i_adxLen) + ")", text_halign = text.align_left)
    table.cell(debugTable, 1, 14, not na(adxValue) ? str.tostring(adxValue, "#.##") + (trendStrong ? " (strong)" : " (weak)") : "N/A",
         text_color = trendStrong ? color.gray : color.silver, text_halign = text.align_left)

    table.cell(debugTable, 0, 15, "VOLATILITY", text_halign = text.align_left)
    table.cell(debugTable, 1, 15, f_volLabel(volRegime) + (not na(atrPctRank) ? " (" + str.tostring(atrPctRank, "#") + "pct)" : ""),
         text_color = volRegime == VolRegime.EXTREME_VOL ? color.red : volRegime == VolRegime.HIGH_VOL ? color.orange : color.gray,
         text_halign = text.align_left)

    table.cell(debugTable, 0, 16, "STRUCTURE BIAS", text_halign = text.align_left)
    table.cell(debugTable, 1, 16, f_biasLabel(structureBias),
         text_color = structureBias == StructureBias.BULLISH ? color.lime : structureBias == StructureBias.BEARISH ? color.red : color.gray,
         text_halign = text.align_left)

    table.cell(debugTable, 0, 17, "LAST SWING HIGH", text_halign = text.align_left)
    table.cell(debugTable, 1, 17, f_swingLabel(lastHighLabel) + " " + (na(lastSwingHighPrice) ? "N/A" : str.tostring(lastSwingHighPrice)) + " (" + swingHighAgeText + ")",
         text_halign = text.align_left)

    table.cell(debugTable, 0, 18, "LAST SWING LOW", text_halign = text.align_left)
    table.cell(debugTable, 1, 18, f_swingLabel(lastLowLabel) + " " + (na(lastSwingLowPrice) ? "N/A" : str.tostring(lastSwingLowPrice)) + " (" + swingLowAgeText + ")",
         text_halign = text.align_left)

    table.cell(debugTable, 0, 19, "LAST EVENT", text_halign = text.align_left)
    table.cell(debugTable, 1, 19, f_structEventLabel(lastStructureEvent) + lastEventAgeText,
         text_color = lastStructureEvent == StructureEvent.BOS_UP or lastStructureEvent == StructureEvent.CHOCH_UP ? color.lime :
                       lastStructureEvent == StructureEvent.BOS_DOWN or lastStructureEvent == StructureEvent.CHOCH_DOWN ? color.red : color.gray,
         text_halign = text.align_left)

    table.cell(debugTable, 0, 20, "ZONES (R/S)", text_halign = text.align_left)
    table.cell(debugTable, 1, 20, str.tostring(array.size(resistanceZones)) + " / " + str.tostring(array.size(supportZones)), text_halign = text.align_left)

    table.cell(debugTable, 0, 21, "NEAREST RESISTANCE", text_halign = text.align_left)
    table.cell(debugTable, 1, 21, resZoneText, text_color = resZoneText == "NONE" ? color.gray : color.red, text_halign = text.align_left)

    table.cell(debugTable, 0, 22, "NEAREST SUPPORT", text_halign = text.align_left)
    table.cell(debugTable, 1, 22, supZoneText, text_color = supZoneText == "NONE" ? color.gray : color.lime, text_halign = text.align_left)

    table.cell(debugTable, 0, 23, "REQUEST BUDGET", text_halign = text.align_left)
    table.cell(debugTable, 1, 23, "0 / 40 (no request.* used yet)", text_color = color.gray, text_halign = text.align_left)

// -----------------------------------------------------------------------------
// VISUAL CONFIRMATION (minimal — no panel/alert module yet)
// -----------------------------------------------------------------------------
bgcolor(i_showBg and currentState == EngineState.DATA_INVALID ? color.new(color.red, 90) : na)

plot(emaFast, "EMA Fast", color = color.new(color.teal, 30))
plot(emaMid,  "EMA Mid",  color = color.new(color.orange, 30))
plot(emaSlow, "EMA Slow", color = color.new(color.purple, 30))

plotshape(i_showStructureMarks and not na(pivotHighPrice) ? pivotHighPrice : na, title = "Swing High",
     style = shape.triangledown, location = location.absolute, offset = -i_pivotRight, color = color.red, size = size.tiny)
plotshape(i_showStructureMarks and not na(pivotLowPrice) ? pivotLowPrice : na, title = "Swing Low",
     style = shape.triangleup, location = location.absolute, offset = -i_pivotRight, color = color.lime, size = size.tiny)

if i_showStructureMarks and barstate.isconfirmed and (bosUpEvent or chochUpEvent)
    label.new(bar_index, high, bosUpEvent ? "BOS" : "CHoCH", style = label.style_label_down,
         color = bosUpEvent ? color.new(color.lime, 0) : color.new(color.blue, 0), textcolor = color.white, size = size.tiny)
if i_showStructureMarks and barstate.isconfirmed and (bosDownEvent or chochDownEvent)
    label.new(bar_index, low, bosDownEvent ? "BOS" : "CHoCH", style = label.style_label_up,
         color = bosDownEvent ? color.new(color.red, 0) : color.new(color.orange, 0), textcolor = color.white, size = size.tiny)

var array<box> zoneBoxes = array.new<box>()

if i_showZones and barstate.islast
    for i = 0 to array.size(zoneBoxes) - 1
        box.delete(array.get(zoneBoxes, i))
    array.clear(zoneBoxes)

    for i = 0 to array.size(resistanceZones) - 1
        Zone z = array.get(resistanceZones, i)
        bx = box.new(left = z.createdBar, top = z.zoneHigh, right = bar_index + 10, bottom = z.zoneLow,
             border_color = z.broken ? color.new(color.red, 70) : color.red,
             bgcolor = z.broken ? color.new(color.red, 95) : color.new(color.red, 85),
             border_style = z.broken ? line.style_dashed : line.style_solid)
        array.push(zoneBoxes, bx)

    for i = 0 to array.size(supportZones) - 1
        Zone z = array.get(supportZones, i)
        bx = box.new(left = z.createdBar, top = z.zoneHigh, right = bar_index + 10, bottom = z.zoneLow,
             border_color = z.broken ? color.new(color.lime, 70) : color.lime,
             bgcolor = z.broken ? color.new(color.lime, 95) : color.new(color.lime, 85),
             border_style = z.broken ? line.style_dashed : line.style_solid)
        array.push(zoneBoxes, bx)
