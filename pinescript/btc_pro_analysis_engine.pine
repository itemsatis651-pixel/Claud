// -----------------------------------------------------------------------------
grpSetupExtra = "Setup Classifier — Pullback / Range Rejection / Mean Reversion"
i_reactionPendingMaxBars = input.int(10, "Reaction Setup PENDING Timeout (bars)", minval = 1, group = grpSetupExtra,
     tooltip = "Zone/koşul dokunuşundan sonra tetikleyici (trigger) bu bar sayısı içinde gelmezse STALE olur.")

// v0.15.1 QA FIX (🤍, Madde 125): user reported the two-table split
// (top_right/bottom_right, v0.15.0) still overlapped on a tablet. Replaced
// with a genuine pagination system — one comprehensive row list (the old
// COMPACT/FULL split is retired; COMPACT was a different curated subset,
// which only adds maintenance burden once pages exist), one small table,
// shows i_diagRowsPerPage rows at a time, "PAGE" input picks which slice.
// This is now the PERMANENT mechanism until the real Madde 114 panel
// exists: any future module's new diagnostics row is added via
// f_addDiagRow (see DIAGNOSTICS section) — never a new table, never a
// manually-sized single block again.
grpDebug = "Diagnostics (temporary — replaced by the compact panel in a later phase)"
i_showDebug = input.bool(true, "Show Diagnostics Table", group = grpDebug)
i_diagRowsPerPage = input.int(11, "Diagnostics Rows per Page", minval = 4, maxval = 30, group = grpDebug,
     tooltip = "Taşma olmadan sığan satır sayısı — kendi ekranınızda test edip ayarlayın (düşürmek daha kısa/daha çok sayfa demektir).")
i_diagPage = input.int(1, "Diagnostics Page", minval = 1, maxval = 10, group = grpDebug,
     tooltip = "Toplam sayfa sayısı satır sayısına göre otomatik hesaplanır ve panelin başlığında (PAGE x/y) gösterilir; bu değer o aralığın dışındaysa son sayfada kalınır.")
i_showBg    = input.bool(true, "Highlight DATA_INVALID bars", group = grpDebug)

// -----------------------------------------------------------------------------
// SYMBOL / DATA SOURCE VALIDATION (Madde 1, 8)
// -----------------------------------------------------------------------------
exchangeOK   = str.upper(syminfo.prefix)      == str.upper(i_expectedExchange)
baseOK       = str.upper(syminfo.basecurrency) == str.upper(i_expectedBase)
quoteOK      = str.upper(syminfo.currency)     == str.upper(i_expectedQuote)
instrumentOK = baseOK and quoteOK   // hard: wrong instrument entirely (not BTC/USDT)

// Spot vs perpetual: never asserted with false confidence (Madde 1, 127, 139, 140).
tickerUpper     = str.upper(syminfo.ticker)
isPerpByType    = syminfo.type == "swap"
isPerpByTicker  = str.contains(tickerUpper, ".P") or str.contains(tickerUpper, "SWAP") or str.contains(tickerUpper, "PERP")
isSpotByType    = syminfo.type == "spot" or syminfo.type == "crypto"
marketTypeGuess = isPerpByType or isPerpByTicker ? "PERPETUAL (heuristic — verify)" :
                   isSpotByType and not isPerpByTicker ? "SPOT (heuristic — verify)" :
                   "UNKNOWN — VERIFY MANUALLY"

// -----------------------------------------------------------------------------
// DATA GATE CHECKS (Madde 7) — computed every tick for live diagnostics
// -----------------------------------------------------------------------------
ohlcValid = not na(open) and not na(high) and not na(low) and not na(close) and
             high >= low and high >= open and high >= close and low <= open and low <= close

volumeValid = not na(volume)   // NA stays NA — never silently treated as 0 (Madde 7)

sufficientHistory = bar_index >= (i_minBars - 1)

atrValue = ta.atr(14)
atrValid = not na(atrValue) and atrValue > 0

expectedIntervalMs = timeframe.in_seconds() * 1000
chartTypeOK = not na(expectedIntervalMs) and expectedIntervalMs > 0
dataGapDetected = chartTypeOK and bar_index > 0 and not na(time[1]) and
     (time - time[1]) > expectedIntervalMs * i_gapMult

barRange = high - low
abnormalBar = atrValid and barRange > atrValue * i_abnormalAtrMult

var int staleBars = 0
if barstate.isconfirmed
    isStaleRepeat = bar_index > 0 and open == open[1] and high == high[1] and low == low[1] and close == close[1]
    staleBars := isStaleRepeat ? staleBars + 1 : 0
staleDataDetected = staleBars >= i_staleBarsThreshold

// Aggregate — LIVE (not yet confirmed, for immediate diagnostics only; Madde 34)
liveDataValid = instrumentOK and ohlcValid and volumeValid and sufficientHistory and
     atrValid and not dataGapDetected and not abnormalBar and not staleDataDetected

// -----------------------------------------------------------------------------
// STATE TRANSITION — CONFIRMED BAR ONLY (Madde 33-34, non-repainting standard)
// -----------------------------------------------------------------------------
if barstate.isconfirmed
    if not liveDataValid
        currentState := EngineState.DATA_INVALID
    else if currentState == EngineState.DATA_INVALID
        currentState := EngineState.FLAT
    // else: currentState stays whatever it already was here — the actual
    // FLAT/WATCH/SETUP/ENTRY_PENDING refinement now happens in a SECOND
    // confirmed-bar block, further down, once the Setup Classifier's inputs
    // (breakoutState, primaryRegime) are computed (Madde 18-19). This block
    // only owns the DATA_INVALID gate. CONFIRMED_LONG/CONFIRMED_SHORT/
    // IN_POSITION/EXIT/COOLDOWN still do NOT exist — those require the Veto
    // Engine (Madde 52-53) and Final Decision Engine (Madde 37), neither of
    // which is built yet.

// -----------------------------------------------------------------------------
// MARKET REGIME — TREND (Madde 10, 13). Structure/Zone exist now (below) but
// are NOT yet wired into Regime Confidence — see header note.
// -----------------------------------------------------------------------------
emaFast = ta.ema(close, i_emaFastLen)
emaMid  = ta.ema(close, i_emaMidLen)
emaSlow = ta.ema(close, i_emaSlowLen)

emaAlignmentBull = emaFast > emaMid and emaMid > emaSlow
emaAlignmentBear = emaFast < emaMid and emaMid < emaSlow
priceAboveAll = close > emaFast and close > emaMid and close > emaSlow
priceBelowAll = close < emaFast and close < emaMid and close < emaSlow
slopeUp   = emaMid > emaMid[i_slopeLookback]
slopeDown = emaMid < emaMid[i_slopeLookback]

[diPlus, diMinus, adxValue] = ta.dmi(i_adxLen, i_adxLen)
diBullish   = diPlus > diMinus
trendStrong = not na(adxValue) and adxValue >= i_adxTrendThreshold

bullVotes = (emaAlignmentBull ? 1 : 0) + (priceAboveAll ? 1 : 0) + (slopeUp ? 1 : 0) + (diBullish ? 1 : 0)
bearVotes = (emaAlignmentBear ? 1 : 0) + (priceBelowAll ? 1 : 0) + (slopeDown ? 1 : 0) + (not diBullish ? 1 : 0)

rangeBandWidth = ta.highest(high, i_rangeLookback) - ta.lowest(low, i_rangeLookback)
priceContained = atrValid and rangeBandWidth < atrValue * i_rangeAtrThreshold

rawRegime = trendStrong and bullVotes >= 3 ? RegimeType.BULL_TREND :
             trendStrong and bearVotes >= 3 ? RegimeType.BEAR_TREND :
             not trendStrong and priceContained ? RegimeType.RANGE :
             RegimeType.TRANSITION

// Persistence / hysteresis (Madde 10) — only advances on confirmed, data-valid bars.
var RegimeType primaryRegime = RegimeType.TRANSITION
var RegimeType pendingRegime = RegimeType.TRANSITION
var int pendingBars  = 0
var int barsInRegime = 0

if barstate.isconfirmed and currentState != EngineState.DATA_INVALID
    pendingBars  := rawRegime == pendingRegime ? pendingBars + 1 : 1
    pendingRegime := rawRegime

    if pendingBars >= i_regimeConfirmBars and primaryRegime != pendingRegime
        primaryRegime := pendingRegime
        barsInRegime  := 1
    else
        barsInRegime := barsInRegime + 1

// -----------------------------------------------------------------------------
// VOLATILITY REGIME (Madde 9, 26) — separate overlay, never mixed with primaryRegime.
// -----------------------------------------------------------------------------
atrPct     = atrValid ? (atrValue / close) * 100 : na
atrPctRank = na(atrPct) ? na : ta.percentrank(atrPct, i_volLookback)

volRegime = na(atrPctRank) ? VolRegime.NORMAL_VOL :
             atrPctRank >= i_volExtremePct ? VolRegime.EXTREME_VOL :
             atrPctRank >= i_volHighPct ? VolRegime.HIGH_VOL :
             atrPctRank <= i_volLowPct ? VolRegime.LOW_VOL :
             VolRegime.NORMAL_VOL

// -----------------------------------------------------------------------------
// REGIME CONFIDENCE (Madde 11 + v3.1 EK) — NOT a binding gate yet (that belongs
// to the Decision Engine, Madde 37, Phase F); exposed here for later use.
// Structure-agreement factor still NOT included (see header note).
// -----------------------------------------------------------------------------
maxVotes = math.max(bullVotes, bearVotes)
trendAgreementScore = maxVotes >= 4 ? 2 : maxVotes == 3 ? 1 : 0
volStabilityScore   = volRegime == VolRegime.EXTREME_VOL ? 0 : 1
persistenceScore    = barsInRegime >= i_regimeConfirmBars * 2 ? 1 : 0
confidenceScoreRaw  = trendAgreementScore + volStabilityScore + persistenceScore

regimeConfidence = primaryRegime == RegimeType.TRANSITION ? ConfidenceLevel.LOW :
                     confidenceScoreRaw >= 3 ? ConfidenceLevel.HIGH :
                     confidenceScoreRaw == 2 ? ConfidenceLevel.MEDIUM :
                     ConfidenceLevel.LOW

// -----------------------------------------------------------------------------
// MARKET STRUCTURE — CENTRAL CONFIRMED-SWING FUNCTION (Madde 14 v3.1 EK)
// ta.pivothigh/low are called UNCONDITIONALLY every bar (required for correct
// internal history tracking); only the resulting state update is gated on
// barstate.isconfirmed below.
// -----------------------------------------------------------------------------
pivotHighPrice = ta.pivothigh(i_pivotLeft, i_pivotRight)
pivotLowPrice  = ta.pivotlow(i_pivotLeft, i_pivotRight)

// Computed here (unconditional, top-level, before Momentum's own section
// further below) SOLELY so the swing-registration blocks below can snapshot
// RSI-at-swing-bar for divergence detection (Madde 23) — divergence must
// reuse the SAME central swing function rather than inventing its own pivot
// search (Madde 14 v3.1 EK). The full Momentum state classification lives in
// its own section later, after Price Action.
rsiValue = ta.rsi(close, i_rsiLen)

var float lastSwingHighPrice    = na   // last CONFIRMED swing high (KNOWN at lastSwingHighKnownBar)
var int   lastSwingHighSwingBar = na   // SWING_TIME (bar it actually occurred)
var int   lastSwingHighKnownBar = na   // KNOWN_TIME (bar the script learned about it)
var float prevSwingHighPrice    = na
var float lastSwingHighRSI      = na   // RSI value AT the swing bar (SWING_TIME), for divergence
var float prevSwingHighRSI      = na

var float lastSwingLowPrice    = na
var int   lastSwingLowSwingBar = na
var int   lastSwingLowKnownBar = na
var float prevSwingLowPrice    = na
var float lastSwingLowRSI      = na
var float prevSwingLowRSI      = na

var SwingLabel lastHighLabel = SwingLabel.NONE
var SwingLabel lastLowLabel  = SwingLabel.NONE
var StructureBias structureBias = StructureBias.NEUTRAL
var StructureEvent lastStructureEvent = StructureEvent.NONE
var int lastStructureEventBar = na

// Zone stores (Madde 15, 16) — resistance from confirmed swing highs, support
// from confirmed swing lows.
var array<Zone> resistanceZones = array.new<Zone>()
var array<Zone> supportZones    = array.new<Zone>()

// Break-of-level checks against the most recently CONFIRMED swing levels.
// Called UNCONDITIONALLY every bar (ta.crossover/crossunder must not be
// called inside an `if` — Madde 124 syntax/logic QA); only the resulting
// state update (below) is confirmed-bar-gated, so no repaint/future leak.
crossedAboveLastHigh = ta.crossover(close, lastSwingHighPrice)
crossedBelowLastLow  = ta.crossunder(close, lastSwingLowPrice)

// Captured BEFORE this bar's swing registration below can mutate
// lastSwingHighPrice/lastSwingLowPrice — the Breakout FSM (further below)
// needs the level as it stood WHEN the cross happened, not a possibly
// already-updated value from later in this same confirmed bar.
brokenHighLevel = lastSwingHighPrice
brokenLowLevel  = lastSwingLowPrice

bosUpEvent    = false
bosDownEvent  = false
chochUpEvent  = false
chochDownEvent = false

if barstate.isconfirmed
    // 1) Register new confirmed swings (Madde 14 — KNOWN_TIME vs SWING_TIME)
    //    and create/cluster the corresponding zone (Madde 15, 16). Zone body
    //    is the swing candle's wick-to-body span — no arbitrary ATR guess.
    if not na(pivotHighPrice)
        prevSwingHighPrice := lastSwingHighPrice
        prevSwingHighRSI := lastSwingHighRSI
        lastHighLabel := na(prevSwingHighPrice) ? SwingLabel.NONE : (pivotHighPrice > prevSwingHighPrice ? SwingLabel.HH : SwingLabel.LH)
        lastSwingHighPrice := pivotHighPrice
        lastSwingHighRSI := rsiValue[i_pivotRight]   // RSI AT the swing bar, matching pivotHighPrice's own SWING_TIME
        lastSwingHighSwingBar := bar_index - i_pivotRight
        lastSwingHighKnownBar := bar_index
        zoneLowBoundHigh = math.max(open[i_pivotRight], close[i_pivotRight])
        f_upsertZone(resistanceZones, pivotHighPrice, zoneLowBoundHigh, bar_index - i_pivotRight, bar_index, atrValue, i_clusterAtrMult, i_maxZonesPerSide)

    if not na(pivotLowPrice)
        prevSwingLowPrice := lastSwingLowPrice
        prevSwingLowRSI := lastSwingLowRSI
        lastLowLabel := na(prevSwingLowPrice) ? SwingLabel.NONE : (pivotLowPrice > prevSwingLowPrice ? SwingLabel.HL : SwingLabel.LL)
        lastSwingLowPrice := pivotLowPrice
        lastSwingLowRSI := rsiValue[i_pivotRight]
        lastSwingLowSwingBar := bar_index - i_pivotRight
        lastSwingLowKnownBar := bar_index
        zoneHighBoundLow = math.min(open[i_pivotRight], close[i_pivotRight])
        f_upsertZone(supportZones, zoneHighBoundLow, pivotLowPrice, bar_index - i_pivotRight, bar_index, atrValue, i_clusterAtrMult, i_maxZonesPerSide)

    // 2) BOS / CHoCH — break of a previously CONFIRMED swing level (Madde 14, 61).
    // First break after NEUTRAL establishes initial bias (treated as CHoCH);
    // a break agreeing with current bias is BOS (continuation), a break
    // against it is CHoCH (reversal).
    if crossedAboveLastHigh
        if structureBias == StructureBias.BULLISH
            bosUpEvent := true
            lastStructureEvent := StructureEvent.BOS_UP
        else
            chochUpEvent := true
            structureBias := StructureBias.BULLISH
            lastStructureEvent := StructureEvent.CHOCH_UP
        lastStructureEventBar := bar_index

    if crossedBelowLastLow
        if structureBias == StructureBias.BEARISH
            bosDownEvent := true
            lastStructureEvent := StructureEvent.BOS_DOWN
        else
            chochDownEvent := true
            structureBias := StructureBias.BEARISH
            lastStructureEvent := StructureEvent.CHOCH_DOWN
        lastStructureEventBar := bar_index

    // 3) Ongoing touch-count / broken-status maintenance for ALL existing
    //    zones, every confirmed bar (Madde 15, 16) — independent of whether
    //    a new swing formed this bar.
    f_updateZones(resistanceZones, true, high, low, close, bar_index)
    f_updateZones(supportZones, false, high, low, close, bar_index)

swingHighAgeText = na(lastSwingHighSwingBar) ? "N/A" : str.tostring(bar_index - lastSwingHighSwingBar) + " bars ago"
swingLowAgeText  = na(lastSwingLowSwingBar) ? "N/A" : str.tostring(bar_index - lastSwingLowSwingBar) + " bars ago"
lastEventAgeText = na(lastStructureEventBar) ? "" : " (" + str.tostring(bar_index - lastStructureEventBar) + " bars ago)"

nearestResIdx = f_nearestZone(resistanceZones, close)
nearestSupIdx = f_nearestZone(supportZones, close)
resZoneText = f_zoneSummary(resistanceZones, nearestResIdx, emaFast, emaMid, emaSlow, atrValue, i_emaConfluenceAtrMult, bar_index, i_freshAgeBars, i_staleAgeBars, i_exhaustTouches)
supZoneText = f_zoneSummary(supportZones, nearestSupIdx, emaFast, emaMid, emaSlow, atrValue, i_emaConfluenceAtrMult, bar_index, i_freshAgeBars, i_staleAgeBars, i_exhaustTouches)

// -----------------------------------------------------------------------------
// FIBONACCI (Madde 17) — active leg = the two most recently confirmed swings
// (central swing function above); level(ratio) is a pure derivation of those
// already-confirmed prices, so no separate confirmed-bar gate is needed here.
// -----------------------------------------------------------------------------
legIsUp   = not na(lastSwingHighSwingBar) and not na(lastSwingLowSwingBar) and lastSwingHighSwingBar > lastSwingLowSwingBar
legIsDown = not na(lastSwingHighSwingBar) and not na(lastSwingLowSwingBar) and lastSwingLowSwingBar > lastSwingHighSwingBar
fibValid  = legIsUp or legIsDown
legStartBar = legIsUp ? lastSwingLowSwingBar : legIsDown ? lastSwingHighSwingBar : na

fib236 = fibValid ? f_fibLevel(legIsUp, lastSwingHighPrice, lastSwingLowPrice, 0.236) : na
fib382 = fibValid ? f_fibLevel(legIsUp, lastSwingHighPrice, lastSwingLowPrice, 0.382) : na
fib500 = fibValid ? f_fibLevel(legIsUp, lastSwingHighPrice, lastSwingLowPrice, 0.5)   : na
fib618 = fibValid ? f_fibLevel(legIsUp, lastSwingHighPrice, lastSwingLowPrice, 0.618) : na
fib786 = fibValid ? f_fibLevel(legIsUp, lastSwingHighPrice, lastSwingLowPrice, 0.786) : na

// Diagnostic only — Madde 17: FIB TOUCH ≠ ENTRY. Real confirmation still
// needs STRUCTURE + ZONE + TRIGGER + MOMENTUM, none combined yet.
fibTouchLabel = f_fibTouchLabel(close, fib236, fib382, fib500, fib618, fib786, atrValue * i_fibTouchAtrMult)
fibLegText = not fibValid ? "N/A (need 2 opposite confirmed swings)" :
     legIsUp ? "UP: " + str.tostring(lastSwingLowPrice) + " -> " + str.tostring(lastSwingHighPrice) :
     "DOWN: " + str.tostring(lastSwingHighPrice) + " -> " + str.tostring(lastSwingLowPrice)

// -----------------------------------------------------------------------------
// BREAKOUT / RETEST STATE MACHINE (Madde 20-21) — reuses crossedAboveLastHigh/
// crossedBelowLastLow (already computed above for BOS/CHoCH) as the break
// trigger; no new level logic. Only STRUCTURE-family evidence (price vs.
// level) is used — no fabricated volume/momentum "quality" (Madde 21, those
// modules don't exist yet).
// -----------------------------------------------------------------------------
var BreakoutFSMState breakoutState = BreakoutFSMState.PRE_BREAKOUT
var BreakoutDirection breakoutDir  = BreakoutDirection.NONE
var float breakoutLevel    = na
var int   breakoutBar      = na   // bar the candidate started
var int   breakoutConfBar  = na   // bar displacement was confirmed
var int   breakoutStateBar = na   // bar of the last state change (for age display)

if barstate.isconfirmed
    if crossedAboveLastHigh and f_isIdleBreakoutState(breakoutState)
        breakoutState := BreakoutFSMState.BREAKOUT_CANDIDATE
        breakoutDir := BreakoutDirection.UP
        breakoutLevel := brokenHighLevel
        breakoutBar := bar_index
        breakoutConfBar := na
        breakoutStateBar := bar_index
    else if crossedBelowLastLow and f_isIdleBreakoutState(breakoutState)
        breakoutState := BreakoutFSMState.BREAKOUT_CANDIDATE
        breakoutDir := BreakoutDirection.DOWN
        breakoutLevel := brokenLowLevel
        breakoutBar := bar_index
        breakoutConfBar := na
        breakoutStateBar := bar_index

    else if breakoutState == BreakoutFSMState.BREAKOUT_CANDIDATE
        candDisplacement = breakoutDir == BreakoutDirection.UP ? close - breakoutLevel : breakoutLevel - close
        candFailed = breakoutDir == BreakoutDirection.UP ? close < breakoutLevel : close > breakoutLevel
        if candFailed
            breakoutState := BreakoutFSMState.FAILED_BREAKOUT
            breakoutStateBar := bar_index
        else if atrValid and candDisplacement >= atrValue * i_confirmDisplacementAtrMult
            breakoutState := BreakoutFSMState.CONFIRMED_BREAKOUT
            breakoutConfBar := bar_index
            breakoutStateBar := bar_index
        else if (bar_index - breakoutBar) > i_candidateMaxBars
            breakoutState := BreakoutFSMState.STALE
            breakoutStateBar := bar_index

    else if breakoutState == BreakoutFSMState.CONFIRMED_BREAKOUT
        confFailed = breakoutDir == BreakoutDirection.UP ? close < breakoutLevel : close > breakoutLevel
        touchedLevel = atrValid and (breakoutDir == BreakoutDirection.UP ?
             low <= breakoutLevel + atrValue * i_retestAtrMult :
             high >= breakoutLevel - atrValue * i_retestAtrMult)
        if confFailed
            breakoutState := BreakoutFSMState.FAILED_BREAKOUT
            breakoutStateBar := bar_index
        else if touchedLevel
            breakoutState := BreakoutFSMState.RETEST_PENDING
            breakoutStateBar := bar_index
        else if not na(breakoutConfBar) and (bar_index - breakoutConfBar) > i_retestMaxBars
            breakoutState := BreakoutFSMState.STALE
            breakoutStateBar := bar_index

    else if breakoutState == BreakoutFSMState.RETEST_PENDING
        retestRejected = breakoutDir == BreakoutDirection.UP ? close < breakoutLevel : close > breakoutLevel
        retestAccepted = breakoutDir == BreakoutDirection.UP ? close > breakoutLevel : close < breakoutLevel
        if retestRejected
            breakoutState := BreakoutFSMState.REVERSAL_CANDIDATE
            breakoutStateBar := bar_index
        else if retestAccepted
            breakoutState := BreakoutFSMState.ENTRY
            breakoutStateBar := bar_index
        else if not na(breakoutConfBar) and (bar_index - breakoutConfBar) > i_retestMaxBars
            breakoutState := BreakoutFSMState.STALE
            breakoutStateBar := bar_index

breakoutStateAgeText = na(breakoutStateBar) ? "" : " (" + str.tostring(bar_index - breakoutStateBar) + " bars ago)"
breakoutStateText = f_breakoutStateLabel(breakoutState) + (breakoutDir == BreakoutDirection.NONE ? "" : " " + f_breakoutDirLabel(breakoutDir)) + breakoutStateAgeText
breakoutLevelText = na(breakoutLevel) ? "N/A" : str.tostring(breakoutLevel)

// -----------------------------------------------------------------------------
// PRICE ACTION ENGINE (Madde 22) — mathematical primitives first (BODY/RANGE,
// WICK/BODY, CLOSE LOCATION, RANGE/ATR), then a minimal named-pattern set
// derived from them. `barRange` reused from the Data Gate section above (no
// duplicate calculation, Madde 111). Computed live every bar but only
// SNAPSHOTTED into the displayed var strings on confirmed bars (Madde 33-34),
// same pattern as Structure's lastHighLabel/lastLowLabel.
// -----------------------------------------------------------------------------
paBodySize  = math.abs(close - open)
paBodyHigh  = math.max(open, close)
paBodyLow   = math.min(open, close)
paUpperWick = high - paBodyHigh
paLowerWick = paBodyLow - low

paBodyToRange   = barRange > 0 ? paBodySize / barRange : na
paCloseLocation = barRange > 0 ? (close - low) / barRange : na   // 0 = closed at low, 1 = closed at high
paRangeToAtr    = atrValid ? barRange / atrValue : na

paBullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
paBearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

paHammerShape = not na(paBodyToRange) and paLowerWick >= i_wickBodyMult * paBodySize and
     paUpperWick <= paBodySize * i_smallWickMaxMult and paBodyToRange <= i_smallBodyMaxRatio
paStarShape = not na(paBodyToRange) and paUpperWick >= i_wickBodyMult * paBodySize and
     paLowerWick <= paBodySize * i_smallWickMaxMult and paBodyToRange <= i_smallBodyMaxRatio

paUpperRejection = barRange > 0 and paUpperWick >= i_rejectionRangeMult * barRange
paLowerRejection = barRange > 0 and paLowerWick >= i_rejectionRangeMult * barRange

paInsideBar  = high <= high[1] and low >= low[1]
paOutsideBar = high >= high[1] and low <= low[1]

paStrongCloseUp   = not na(paCloseLocation) and paCloseLocation >= i_strongCloseThreshold
paStrongCloseDown = not na(paCloseLocation) and paCloseLocation <= (1 - i_strongCloseThreshold)

var string lastPriceActionPatterns = "NONE"
var int    lastPriceActionBar      = na
var float  lastBodyToRange         = na
var float  lastCloseLocation       = na
var float  lastRangeToAtr          = na

if barstate.isconfirmed
    paPatterns = array.new<string>()
    if paBullEngulf
        array.push(paPatterns, "BULL ENGULF")
    if paBearEngulf
        array.push(paPatterns, "BEAR ENGULF")
    if paHammerShape
        array.push(paPatterns, "HAMMER")
    if paStarShape
        array.push(paPatterns, "SHOOTING STAR")
    if paUpperRejection
        array.push(paPatterns, "UPPER REJECTION")
    if paLowerRejection
        array.push(paPatterns, "LOWER REJECTION")
    if paInsideBar
        array.push(paPatterns, "INSIDE BAR")
    if paOutsideBar
        array.push(paPatterns, "OUTSIDE BAR")
    if paStrongCloseUp
        array.push(paPatterns, "STRONG CLOSE UP")
    if paStrongCloseDown
        array.push(paPatterns, "STRONG CLOSE DOWN")
    lastPriceActionPatterns := array.size(paPatterns) > 0 ? array.join(paPatterns, ", ") : "NONE"
    lastPriceActionBar := bar_index
    lastBodyToRange := paBodyToRange
    lastCloseLocation := paCloseLocation
    lastRangeToAtr := paRangeToAtr

priceActionMetricsText = (na(lastBodyToRange) ? "N/A" : "body/range " + str.tostring(lastBodyToRange, "#.##")) +
     "  close@" + (na(lastCloseLocation) ? "N/A" : str.tostring(lastCloseLocation, "#.##")) +
     "  range/ATR " + (na(lastRangeToAtr) ? "N/A" : str.tostring(lastRangeToAtr, "#.##"))

// -----------------------------------------------------------------------------
// MOMENTUM ENGINE (Madde 23) — RSI + MACD histogram only (not also Stochastic/
// CCI, Madde 6 double-counting ban). Goal is a STATE label, never "RSI level
// = direction" (rsiValue/macdHist never feed any entry/direction logic here).
// -----------------------------------------------------------------------------
rsiRising  = rsiValue > rsiValue[i_momSlopeLookback]
rsiFalling = rsiValue < rsiValue[i_momSlopeLookback]
rsiOverboughtNow = rsiValue >= i_rsiOverbought
rsiOversoldNow   = rsiValue <= i_rsiOversold

[macdLine, macdSignal, macdHist] = ta.macd(close, i_macdFast, i_macdSlow, i_macdSignal)
histRising  = macdHist > macdHist[i_momSlopeLookback]
histFalling = macdHist < macdHist[i_momSlopeLookback]

momDirection = macdHist > 0 ? MomentumDirection.BULLISH : macdHist < 0 ? MomentumDirection.BEARISH : MomentumDirection.NONE

momState = rsiOversoldNow and rsiRising ? MomentumState.RECOVERING :
     rsiOverboughtNow and rsiFalling ? MomentumState.WEAKENING :
     momDirection == MomentumDirection.BULLISH and histRising ? MomentumState.ACCELERATING :
     momDirection == MomentumDirection.BULLISH and histFalling ? MomentumState.DECELERATING :
     momDirection == MomentumDirection.BEARISH and histFalling ? MomentumState.ACCELERATING :
     momDirection == MomentumDirection.BEARISH and histRising ? MomentumState.DECELERATING :
     MomentumState.NEUTRAL

var MomentumState     lastMomentumState = MomentumState.NEUTRAL
var MomentumDirection lastMomentumDir   = MomentumDirection.NONE
var float             lastRsiSnapshot   = na
var DivergenceType    lastDivergence    = DivergenceType.NONE
var int               lastDivergenceBar = na

if barstate.isconfirmed
    lastMomentumState := momState
    lastMomentumDir := momDirection
    lastRsiSnapshot := rsiValue

    // Divergence (Madde 23): reuses the SAME confirmed swings Structure just
    // registered above in this same bar — a new HH with LOWER RSI-at-swing
    // than the previous HH is bearish divergence; a new LL with HIGHER
    // RSI-at-swing is bullish divergence. Reported as DETECTED only, never a
    // guaranteed reversal.
    if not na(pivotHighPrice) and not na(prevSwingHighRSI) and not na(prevSwingHighPrice) and
         lastSwingHighPrice > prevSwingHighPrice and lastSwingHighRSI < prevSwingHighRSI
        lastDivergence := DivergenceType.BEARISH
        lastDivergenceBar := bar_index
    if not na(pivotLowPrice) and not na(prevSwingLowRSI) and not na(prevSwingLowPrice) and
         lastSwingLowPrice < prevSwingLowPrice and lastSwingLowRSI > prevSwingLowRSI
        lastDivergence := DivergenceType.BULLISH
        lastDivergenceBar := bar_index

divergenceAgeText = na(lastDivergenceBar) ? "" : " (" + str.tostring(bar_index - lastDivergenceBar) + " bars ago)"
divergenceText = f_divergenceLabel(lastDivergence) + (lastDivergence == DivergenceType.NONE ? "" : divergenceAgeText)
momentumText = f_momStateLabel(lastMomentumState) + (lastMomentumDir == MomentumDirection.NONE ? "" : " " + f_momDirLabel(lastMomentumDir)) +
     "  RSI " + (na(lastRsiSnapshot) ? "N/A" : str.tostring(lastRsiSnapshot, "#.#"))

// -----------------------------------------------------------------------------
// PARTICIPATION ENGINE (Madde 24) — RVOL + OBV alignment only, not every
// volume-flavored indicator at once (Madde 6). VWAP is a FIXED N-bar rolling
// average, NOT session-anchored (Madde 24: BTC is 24/7, no session-open
// concept assumed, consistent with Madde 1/107).
// -----------------------------------------------------------------------------
volAvg = ta.sma(volume, i_rvolLookback)
rvol = volumeValid and not na(volAvg) and volAvg > 0 ? volume / volAvg : na
rvolExpanding   = not na(rvol) and rvol >= i_expansionRvolMult
rvolContracting = not na(rvol) and rvol <= i_contractionRvolMult

// OBV built manually from ta.cum/ta.change/math.sign — Pine's ta.* namespace
// has no bare ta.obv series to call, unlike ta.tr (Madde 127: verify, don't
// assume). Standard OBV definition: cumulative sum of volume signed by the
// direction of each bar's close-to-close change.
obvValue   = ta.cum(volume * math.sign(ta.change(close)))
obvRising  = obvValue > obvValue[i_obvSlopeLookback]
obvFalling = obvValue < obvValue[i_obvSlopeLookback]

barBullish = close > open
barBearish = close < open

alignedBullish = barBullish and obvRising
alignedBearish = barBearish and obvFalling
misaligned     = (barBullish and obvFalling) or (barBearish and obvRising)

partDirection = alignedBullish ? ParticipationDirection.BULLISH : alignedBearish ? ParticipationDirection.BEARISH : ParticipationDirection.NONE

partState = rvolExpanding and (alignedBullish or alignedBearish) ? ParticipationState.CONFIRMING :
     rvolExpanding and misaligned ? ParticipationState.DIVERGING :
     rvolContracting ? ParticipationState.CONTRACTING :
     rvolExpanding ? ParticipationState.EXPANDING :
     ParticipationState.NORMAL

rollingVwapNum = ta.sma(close * volume, i_vwapLookback)
rollingVwapDen = ta.sma(volume, i_vwapLookback)
rollingVwap = volumeValid and not na(rollingVwapDen) and rollingVwapDen > 0 ? rollingVwapNum / rollingVwapDen : na
priceAboveVwap = not na(rollingVwap) and close > rollingVwap

var ParticipationState     lastParticipationState = ParticipationState.NORMAL
var ParticipationDirection lastParticipationDir   = ParticipationDirection.NONE
var float                  lastRvol               = na
var float                  lastVwap               = na
var bool                   lastPriceAboveVwap      = bool(na)

if barstate.isconfirmed
    lastParticipationState := partState
    lastParticipationDir := partDirection
    lastRvol := rvol
    lastVwap := rollingVwap
    lastPriceAboveVwap := priceAboveVwap

participationText = f_partStateLabel(lastParticipationState) + (lastParticipationDir == ParticipationDirection.NONE ? "" : " " + f_partDirLabel(lastParticipationDir)) +
     "  RVOL " + (na(lastRvol) ? "N/A" : str.tostring(lastRvol, "#.##"))
vwapText = na(lastVwap) ? "N/A" : str.tostring(lastVwap) + (lastPriceAboveVwap ? " (price above)" : " (price below)")

// -----------------------------------------------------------------------------
// MTF REFINEMENT (Madde 28-32) — first item of Phase E. Exactly ONE HTF,
// exactly ONE request.security() call (1/40 budget). HTF resolution is built
// entirely from `input.*` values and `timeframe.in_seconds(timeframe.period)`
// (all "simple", never "series" qualified), so the resulting timeframe string
// stays valid as request.security()'s (simple-string-only) second argument
// even though it depends on a ternary chain.
// -----------------------------------------------------------------------------
chartTfSeconds = timeframe.in_seconds(timeframe.period)
manualTfSeconds = timeframe.in_seconds(i_mtfManualTf)

// "One level up" from Madde 28's default role table, collapsed to a single
// HTF (the full 1D/4H/1H/15m cascade is deferred, see header note). Falls
// back to the chart's own timeframe.period when no higher default role
// exists — a always-valid, non-empty string to hand to request.security();
// mtfAvailable (below) is what actually gates whether this is trusted/shown,
// so no fabricated data reaches the diagnostics table (Madde 139/140).
autoHtf = chartTfSeconds <= 900 ? "60" : chartTfSeconds <= 3600 ? "240" : chartTfSeconds <= 14400 ? "1D" : timeframe.period
autoHtfAvailable = chartTfSeconds <= 14400

mtfResolvedTf = i_mtfMode == "MANUAL" ? i_mtfManualTf : autoHtf
mtfAvailable = chartTypeOK and (i_mtfMode == "MANUAL" ? manualTfSeconds > chartTfSeconds : autoHtfAvailable)

// Non-repainting HTF access (Madde 29): every value in the tuple is offset by
// `[1]` (the slope reference by `[i_mtfSlopeLookback + 1]`) AND the call uses
// `lookahead = barmerge.lookahead_on` together — the official TradingView
// non-repainting pattern. Bare `lookahead_on` without an offset expression is
// forbidden by Madde 29 and is never used. One HTF bar of lag is accepted on
// purpose (Madde 29: no future leak for an earlier signal).
[htfClose, htfEma, htfEmaSlopeRef] = request.security(syminfo.tickerid, mtfResolvedTf,
     [close[1], ta.ema(close, i_mtfEmaLen)[1], ta.ema(close, i_mtfEmaLen)[i_mtfSlopeLookback + 1]],
     lookahead = barmerge.lookahead_on)

htfBiasRaw = htfClose > htfEma and htfEma > htfEmaSlopeRef ? StructureBias.BULLISH :
     htfClose < htfEma and htfEma < htfEmaSlopeRef ? StructureBias.BEARISH :
     StructureBias.NEUTRAL

mtfAgreement = not mtfAvailable ? MtfAgreement.UNAVAILABLE :
     htfBiasRaw == StructureBias.NEUTRAL or structureBias == StructureBias.NEUTRAL ? MtfAgreement.NEUTRAL :
     htfBiasRaw == structureBias ? MtfAgreement.AGREE :
     MtfAgreement.CONFLICT

mtfHtfText = mtfAvailable ? mtfResolvedTf + (i_mtfMode == "MANUAL" ? " (manual)" : " (auto)") :
     "N/A" + (i_mtfMode == "MANUAL" ? " (manual HTF <= chart TF)" : " (chart already >= 1D)")
mtfBiasText = mtfAvailable ? f_biasLabel(htfBiasRaw) + " vs chart " + f_biasLabel(structureBias) : "N/A"

// -----------------------------------------------------------------------------
// RISK ENGINE (Madde 44-49) — first item of Phase F. DIAGNOSTIC ONLY: no
// Setup Classifier exists yet, so this is not wired to any actual entry. It
// reuses the SAME nearestResIdx/nearestSupIdx the Zone module already
// computed (Madde 111 — no new zone search) as the structural stop/target
// reference; falls back to the last confirmed swing when no zone exists yet,
// and to a genuine "NO STRUCTURAL STOP" (never a fabricated number, Madde
// 139/140) when neither is available.
// -----------------------------------------------------------------------------
riskEntry = close

// array.get() must NEVER be called with an out-of-range index (-1 = "no
// zone yet"). Pine's ternary evaluates BOTH branches eagerly (same lesson
// as the v0.4.1 RE10045 fix — see header), so `idx >= 0 ? array.get(...) :
// fallback` would still call array.get() on -1 and crash. Explicit if/else
// statements are used instead so the invalid branch is never evaluated.

// LONG idea: invalidated below the nearest SUPPORT, targets the nearest
// RESISTANCE (its near edge, not a blind "entry + 2 ATR", Madde 46).
float longStopRaw = na
float longTargetRaw = na
if nearestSupIdx >= 0
    longStopRaw := array.get(supportZones, nearestSupIdx).zoneLow
else
    longStopRaw := lastSwingLowPrice
if nearestResIdx >= 0
    longTargetRaw := array.get(resistanceZones, nearestResIdx).zoneLow

// SHORT idea: invalidated above the nearest RESISTANCE, targets the nearest
// SUPPORT (its near edge). Same f_riskCalc function, just isLong=false
// (Madde 50 — no asymmetric long/short logic).
float shortStopRaw = na
float shortTargetRaw = na
if nearestResIdx >= 0
    shortStopRaw := array.get(resistanceZones, nearestResIdx).zoneHigh
else
    shortStopRaw := lastSwingHighPrice
if nearestSupIdx >= 0
    shortTargetRaw := array.get(supportZones, nearestSupIdx).zoneHigh

[longStopLevel, longTargetLevel, longStopDist, longRewardDist, longRR, longStatus] =
     f_riskCalc(true, riskEntry, longStopRaw, longTargetRaw, atrValue, i_riskAtrBufferMult, i_maxStopDistancePct, i_minRR)
[shortStopLevel, shortTargetLevel, shortStopDist, shortRewardDist, shortRR, shortStatus] =
     f_riskCalc(false, riskEntry, shortStopRaw, shortTargetRaw, atrValue, i_riskAtrBufferMult, i_maxStopDistancePct, i_minRR)

[longRiskAmount, longPosSize, longNotional, longMargin] = f_positionSize(i_accountEquity, i_riskPctPerTrade, longStopDist, riskEntry, i_leverage)
[shortRiskAmount, shortPosSize, shortNotional, shortMargin] = f_positionSize(i_accountEquity, i_riskPctPerTrade, shortStopDist, riskEntry, i_leverage)

riskLongText  = f_riskLine(longStopLevel, longTargetLevel, longRR, longStatus)
riskShortText = f_riskLine(shortStopLevel, shortTargetLevel, shortRR, shortStatus)

posSizeLongText  = f_posSizeLine(longPosSize, longNotional, longMargin)
posSizeShortText = f_posSizeLine(shortPosSize, shortNotional, shortMargin)

// -----------------------------------------------------------------------------
// SETUP CLASSIFIER (Madde 18-19) — "setup-specific decision rules", Phase F.
// BREAKOUT_RETEST reuses the Breakout FSM (Madde 20-21) as its entire
// trigger/confirmation/invalidation/expiry machinery — no new state machine
// invented (Madde 111). Eligibility (Madde 19) is computed by
// f_breakoutRetestEligible above, purely from breakoutDir vs primaryRegime.
// -----------------------------------------------------------------------------
setupEligible = f_breakoutRetestEligible(breakoutDir, primaryRegime)

setupEligibilityText = breakoutDir == BreakoutDirection.NONE ? "N/A (no breakout attempt)" :
     setupEligible ? "ELIGIBLE (" + f_regimeLabel(primaryRegime) + ")" :
     "NOT ELIGIBLE (" + f_breakoutDirLabel(breakoutDir) + " vs " + f_regimeLabel(primaryRegime) + ", Madde 19)"

// FAILED_BREAKOUT_REVERSAL (Madde 18) — pure reinterpretation of the
// Breakout FSM's own REVERSAL_CANDIDATE state (see the REMAINING SETUP
// ARCHETYPES header comment near f_failedReversalEligible). Reversal
// direction = opposite of the failed breakout's own direction.
failedReversalDir = breakoutDir == BreakoutDirection.UP ? BreakoutDirection.DOWN :
     breakoutDir == BreakoutDirection.DOWN ? BreakoutDirection.UP : BreakoutDirection.NONE
failedReversalEligible = breakoutState == BreakoutFSMState.REVERSAL_CANDIDATE and
     f_failedReversalEligible(breakoutDir, primaryRegime)

// PULLBACK_CONTINUATION (Madde 18) — a pullback INTO a zone in the direction
// of an established trend, followed by a reversal-style trigger resuming
// that trend. Eligibility is re-checked LIVE every bar (pullbackDir vs
// current structureBias/primaryRegime), same as setupEligible above, so a
// regime flip mid-flight correctly de-eligibilizes it instead of freezing a
// stale eligibility.
var ReactionFSMState pullbackState = ReactionFSMState.IDLE
var BreakoutDirection pullbackDir  = BreakoutDirection.NONE
var int pullbackPendingBars = 0

pullbackWantLong  = structureBias == StructureBias.BULLISH and primaryRegime == RegimeType.BULL_TREND
pullbackWantShort = structureBias == StructureBias.BEARISH and primaryRegime == RegimeType.BEAR_TREND
pullbackTouch = pullbackWantLong ? f_zoneTouch(supportZones, nearestSupIdx, high, low) :
     pullbackWantShort ? f_zoneTouch(resistanceZones, nearestResIdx, high, low) : false
pullbackTrigger = pullbackDir == BreakoutDirection.UP ?
     (paBullEngulf or paHammerShape or paLowerRejection or paStrongCloseUp) and momDirection != MomentumDirection.BEARISH :
     pullbackDir == BreakoutDirection.DOWN ?
     (paBearEngulf or paStarShape or paUpperRejection or paStrongCloseDown) and momDirection != MomentumDirection.BULLISH :
     false
pullbackInvalidated = pullbackDir == BreakoutDirection.UP ? f_zoneBrokenBelow(supportZones, nearestSupIdx, close) :
     pullbackDir == BreakoutDirection.DOWN ? f_zoneBrokenAbove(resistanceZones, nearestResIdx, close) : false

if barstate.isconfirmed
    pullbackPendingBars := pullbackState == ReactionFSMState.PENDING ? pullbackPendingBars + 1 : 0
    pullbackTimedOut = pullbackPendingBars > i_reactionPendingMaxBars
    pullbackTouchNow = pullbackTouch and (pullbackWantLong or pullbackWantShort)
    if f_isIdleReactionState(pullbackState) and pullbackTouchNow
        pullbackDir := pullbackWantLong ? BreakoutDirection.UP : BreakoutDirection.DOWN
    pullbackState := f_reactionFSMStep(pullbackState, pullbackTouchNow, pullbackTrigger, pullbackInvalidated, pullbackTimedOut)

pullbackActiveEligible = (pullbackState == ReactionFSMState.PENDING or pullbackState == ReactionFSMState.CONFIRMED) and
     (pullbackDir == BreakoutDirection.UP ? pullbackWantLong : pullbackDir == BreakoutDirection.DOWN ? pullbackWantShort : false)

// RANGE_REJECTION (Madde 18) — same reaction mechanism as Pullback
// Continuation (Madde 111 — one mechanism, not near-duplicates), but gated
// to RANGE regime only (Madde 19's own worked example) and open to EITHER
// direction (a range has two edges, unlike a trend pullback).
var ReactionFSMState rangeRejState = ReactionFSMState.IDLE
var BreakoutDirection rangeRejDir  = BreakoutDirection.NONE
var int rangeRejPendingBars = 0

rangeRejRegimeOK  = primaryRegime == RegimeType.RANGE
rangeRejTouchLong  = rangeRejRegimeOK and f_zoneTouch(supportZones, nearestSupIdx, high, low)
rangeRejTouchShort = rangeRejRegimeOK and f_zoneTouch(resistanceZones, nearestResIdx, high, low)
rangeRejTrigger = rangeRejDir == BreakoutDirection.UP ? (paBullEngulf or paHammerShape or paLowerRejection) :
     rangeRejDir == BreakoutDirection.DOWN ? (paBearEngulf or paStarShape or paUpperRejection) :
     false
rangeRejInvalidated = rangeRejDir == BreakoutDirection.UP ? f_zoneBrokenBelow(supportZones, nearestSupIdx, close) :
     rangeRejDir == BreakoutDirection.DOWN ? f_zoneBrokenAbove(resistanceZones, nearestResIdx, close) : false

if barstate.isconfirmed
    rangeRejPendingBars := rangeRejState == ReactionFSMState.PENDING ? rangeRejPendingBars + 1 : 0
    rangeRejTimedOut = rangeRejPendingBars > i_reactionPendingMaxBars
    rangeRejTouchNow = rangeRejTouchLong or rangeRejTouchShort
    if f_isIdleReactionState(rangeRejState) and rangeRejTouchNow
        rangeRejDir := rangeRejTouchLong ? BreakoutDirection.UP : BreakoutDirection.DOWN
    rangeRejState := f_reactionFSMStep(rangeRejState, rangeRejTouchNow, rangeRejTrigger, rangeRejInvalidated, rangeRejTimedOut)

rangeRejActiveEligible = (rangeRejState == ReactionFSMState.PENDING or rangeRejState == ReactionFSMState.CONFIRMED) and rangeRejRegimeOK

// MEAN_REVERSION (Madde 18) — RSI-extreme based rather than zone-based
// (genuine differentiation from Range Rejection, not a duplicate): "touch"
// is RSI oversold/overbought (already-computed booleans, Momentum module,
// Madde 111), "trigger" adds RSI turning back plus a reversal Price Action
// pattern, "invalidated" is a new swing extreme in the adverse direction
// (reusing the central swing function's own last-swing prices, Madde 14).
var ReactionFSMState meanRevState = ReactionFSMState.IDLE
var BreakoutDirection meanRevDir  = BreakoutDirection.NONE
var int meanRevPendingBars = 0

meanRevRegimeOK  = primaryRegime == RegimeType.RANGE or primaryRegime == RegimeType.TRANSITION
meanRevTouchLong  = meanRevRegimeOK and rsiOversoldNow
meanRevTouchShort = meanRevRegimeOK and rsiOverboughtNow
meanRevTrigger = meanRevDir == BreakoutDirection.UP ? (rsiRising and (paBullEngulf or paHammerShape or paLowerRejection)) :
     meanRevDir == BreakoutDirection.DOWN ? (rsiFalling and (paBearEngulf or paStarShape or paUpperRejection)) :
     false
meanRevInvalidated = meanRevDir == BreakoutDirection.UP ? (not na(lastSwingLowPrice) and close < lastSwingLowPrice) :
     meanRevDir == BreakoutDirection.DOWN ? (not na(lastSwingHighPrice) and close > lastSwingHighPrice) : false

if barstate.isconfirmed
    meanRevPendingBars := meanRevState == ReactionFSMState.PENDING ? meanRevPendingBars + 1 : 0
    meanRevTimedOut = meanRevPendingBars > i_reactionPendingMaxBars
    meanRevTouchNow = meanRevTouchLong or meanRevTouchShort
    if f_isIdleReactionState(meanRevState) and meanRevTouchNow
        meanRevDir := meanRevTouchLong ? BreakoutDirection.UP : BreakoutDirection.DOWN
    meanRevState := f_reactionFSMStep(meanRevState, meanRevTouchNow, meanRevTrigger, meanRevInvalidated, meanRevTimedOut)

meanRevActiveEligible = (meanRevState == ReactionFSMState.PENDING or meanRevState == ReactionFSMState.CONFIRMED) and meanRevRegimeOK

// PRIORITY RESOLUTION — exactly ONE archetype drives the state machine at a
// time (Madde 51 v3.1.1 EK single-state invariant, satisfied by
// construction). Order: BREAKOUT_RETEST > FAILED_BREAKOUT_REVERSAL >
// PULLBACK_CONTINUATION > RANGE_REJECTION > MEAN_REVERSION —
// trend/breakout-oriented setups take priority over range/reversion ones,
// matching this project's OWN backtest research (README, Adım 3: Donchian
// trend-following demonstrably more robust than mean-reversion for BTC).
// Regime-gating already keeps these mostly mutually exclusive in practice;
// this order only matters for the rarer TRANSITION-regime overlap.
SetupType setupType = SetupType.NONE
SetupStage setupStage = SetupStage.IDLE
BreakoutDirection setupDir = BreakoutDirection.NONE
bool setupPromotable = false

if setupEligible and f_isActiveSetupState(breakoutState)
    setupType := SetupType.BREAKOUT_RETEST
    setupDir := breakoutDir
    setupStage := breakoutState == BreakoutFSMState.BREAKOUT_CANDIDATE ? SetupStage.FORMING :
         breakoutState == BreakoutFSMState.CONFIRMED_BREAKOUT ? SetupStage.CONFIRMED :
         SetupStage.READY
    setupPromotable := breakoutState == BreakoutFSMState.ENTRY
else if failedReversalEligible
    setupType := SetupType.FAILED_BREAKOUT_REVERSAL
    setupDir := failedReversalDir
    setupStage := SetupStage.READY
    setupPromotable := true
else if pullbackActiveEligible
    setupType := SetupType.PULLBACK_CONTINUATION
    setupDir := pullbackDir
    setupStage := pullbackState == ReactionFSMState.PENDING ? SetupStage.FORMING : SetupStage.READY
    setupPromotable := pullbackState == ReactionFSMState.CONFIRMED
else if rangeRejActiveEligible
    setupType := SetupType.RANGE_REJECTION
    setupDir := rangeRejDir
    setupStage := rangeRejState == ReactionFSMState.PENDING ? SetupStage.FORMING : SetupStage.READY
    setupPromotable := rangeRejState == ReactionFSMState.CONFIRMED
else if meanRevActiveEligible
    setupType := SetupType.MEAN_REVERSION
    setupDir := meanRevDir
    setupStage := meanRevState == ReactionFSMState.PENDING ? SetupStage.FORMING : SetupStage.READY
    setupPromotable := meanRevState == ReactionFSMState.CONFIRMED

// SIGNAL QUALITY GATE (Madde 37 v3.1 EK) — "REGIME ACCEPTABLE" is regime-TYPE
// compatibility (already inside each archetype's own eligibility check
// above) PLUS regimeConfidence >= MEDIUM. If confidence is LOW, the spec is
// explicit: "en fazla WATCH" (at most WATCH) — never SETUP/ENTRY_PENDING/
// CONFIRMED, regardless of how far the underlying FSM itself has
// progressed. This is a real, EXPLICITLY specified threshold (MEDIUM, the
// existing ConfidenceLevel enum) — not a guessed number, so it is
// implemented as a hard clamp. Contrast with Madde 38 (Minimum Independent
// Evidence) just below setupRiskText, which the spec itself says must NOT
// be guessed — that one is deliberately NOT gated yet.
regimeAcceptable = regimeConfidence != ConfidenceLevel.LOW
if setupType != SetupType.NONE and not regimeAcceptable
    setupStage := SetupStage.FORMING
    setupPromotable := false

setupText = setupType != SetupType.NONE ?
     f_setupTypeLabel(setupType) + " " + f_breakoutDirLabel(setupDir) + "  [ELIGIBLE]" :
     (f_isActiveSetupState(breakoutState) and not setupEligible) ?
     "BREAKOUT ATTEMPT (" + f_breakoutDirLabel(breakoutDir) + ")  [" + setupEligibilityText + "]" :
     "NONE"

// Other archetypes' raw FSM state, even when NOT the one currently winning
// priority resolution — otherwise a forming Pullback/Range/Mean-Reversion
// setup would be entirely invisible whenever Breakout Retest happens to be
// active at the same time (Madde 139/140 — no silent behavior).
otherSetupsText = "PB:" + f_reactionLabel(pullbackState) + (pullbackDir == BreakoutDirection.NONE ? "" : "(" + f_breakoutDirLabel(pullbackDir) + ")") +
     "  RR:" + f_reactionLabel(rangeRejState) + (rangeRejDir == BreakoutDirection.NONE ? "" : "(" + f_breakoutDirLabel(rangeRejDir) + ")") +
     "  MR:" + f_reactionLabel(meanRevState) + (meanRevDir == BreakoutDirection.NONE ? "" : "(" + f_breakoutDirLabel(meanRevDir) + ")")

// Whichever Risk Engine side actually corresponds to this live setup's
// direction (Madde 111 — reuse the already-computed LONG/SHORT numbers,
// don't recompute a third time).
setupRiskText = setupType == SetupType.NONE ? "N/A" :
     setupDir == BreakoutDirection.UP ? riskLongText : riskShortText

// -----------------------------------------------------------------------------
// VETO ENGINE (Madde 52-53) — Phase F, the piece that finally lets the chain
// (Regime -> Structure -> Zone -> Breakout FSM -> Setup Classifier -> Risk
// Engine) reach a real CONFIRMED_LONG/CONFIRMED_SHORT. Runs INDEPENDENTLY
// of score (Madde 52 — no scoring engine exists anyway, so this is
// trivially satisfied). Only the HARD VETO / SOFT PENALTY categories this
// script has actual evidence for are implemented (Madde 139/140 — no
// fabricated checks for EXECUTION INVALID, LEVERAGE CASCADE RISK, ACCOUNT
// CIRCUIT BREAKER, position/exposure violation, etc., none of which exist
// yet), evaluated in Madde 53's PRECEDENCE order:
//   RISK INVALID      = the live setup's Risk Engine status != OK (Madde
//                        111 — reuses f_riskCalc's status, already covers
//                        Madde 52's "poor R:R", stop/target problems,
//                        "entry too close"/already-invalidated cases).
//   STRUCTURE INVALID = severe MTF conflict (mtfAgreement == CONFLICT,
//                        Madde 52's explicit "severe MTF conflict" item).
//   SETUP INVALID     = Setup Classifier says not eligible, or the
//                        Breakout FSM already failed/is idle (Madde 19,
//                        Madde 52's "failed setup").
// A separate, EXPLICIT gate (not part of the precedence list above, applied
// earlier in the Setup Classifier section — see regimeAcceptable):
// REGIME CONFIDENCE < MEDIUM caps the state at WATCH per Madde 37 v3.1 EK
// ("REGIME ACCEPTABLE" = regime-type compatibility, already covered by each
// archetype's own eligibility, PLUS confidence >= MEDIUM). Also surfaced
// here as a hard-veto reason for visibility, since it has the same
// practical effect (no CONFIRMED this bar).
// SOFT PENALTIES (Madde 52) are informational only, never block CONFIRMED:
// weak participation, weak momentum, MTF NEUTRAL (as opposed to the hard
// CONFLICT), elevated volatility. Low regime confidence is now a HARD gate
// (Madde 37 v3.1 EK, see below), not a soft penalty.
//
// Per explicit user instruction: no NEW magic-number threshold is
// hardcoded here — R:R is already i_minRR (Risk Engine's own input), and
// the one new threshold this module introduces (the ENTRY_PENDING
// veto-blocked timeout, Madde 55 v3.1.1 EK) is i_entryPendingMaxBars
// below. A hard-vetoed setup is NEVER silently hidden: it stays visible at
// its current WATCH/SETUP/ENTRY_PENDING state with the reason shown in the
// VETO diagnostics row, only falling back to FLAT if fully expired.
// -----------------------------------------------------------------------------
liveRiskStatus = setupDir == BreakoutDirection.UP ? longStatus : shortStatus
riskInvalid = setupType != SetupType.NONE and liveRiskStatus != "OK"
structureInvalid = setupType != SetupType.NONE and mtfAgreement == MtfAgreement.CONFLICT
setupInvalid = setupType == SetupType.NONE

hardVetoReasons = array.new<string>()
if riskInvalid
    array.push(hardVetoReasons, "RISK INVALID (" + liveRiskStatus + ")")
if structureInvalid
    array.push(hardVetoReasons, "STRUCTURE INVALID (severe MTF conflict)")
if setupInvalid
    array.push(hardVetoReasons, "SETUP INVALID (no active/eligible setup, Madde 18-19)")
if setupType != SetupType.NONE and not regimeAcceptable
    array.push(hardVetoReasons, "REGIME CONFIDENCE LOW (Madde 37 v3.1 EK — capped at WATCH)")
hardVetoActive = array.size(hardVetoReasons) > 0

softPenalties = array.new<string>()
if lastParticipationState == ParticipationState.CONTRACTING
    array.push(softPenalties, "weak participation")
if lastMomentumState == MomentumState.WEAKENING or lastMomentumState == MomentumState.NEUTRAL
    array.push(softPenalties, "weak momentum")
if mtfAgreement == MtfAgreement.NEUTRAL
    array.push(softPenalties, "MTF unclear")
// Low regime confidence is now a HARD gate above (Madde 37 v3.1 EK,
// "REGIME ACCEPTABLE" = type compatibility + confidence >= MEDIUM), not a
// soft penalty — listing it here too would just duplicate the same reason
// under both HARD and SOFT (Madde 6 double-counting spirit, applied to
// the diagnostics themselves).
if volRegime == VolRegime.HIGH_VOL or volRegime == VolRegime.EXTREME_VOL
    array.push(softPenalties, "elevated volatility")

softPenaltyText = array.size(softPenalties) > 0 ? array.join(softPenalties, ", ") : "none"
hardVetoText = array.size(hardVetoReasons) > 0 ? array.join(hardVetoReasons, "; ") : "none"
// Full text collapses to a plain "N/A" while nothing is even attempting a
// setup — showing "HARD VETO: SETUP INVALID" through every idle FLAT bar
// would be technically true but pure noise (Madde 10).
vetoText = setupType == SetupType.NONE ? "N/A (no active setup)" :
     hardVetoActive ? "HARD VETO: " + hardVetoText + (array.size(softPenalties) > 0 ? "  [soft: " + softPenaltyText + "]" : "") :
     array.size(softPenalties) > 0 ? "no hard veto  [soft: " + softPenaltyText + "]" :
     "CLEAN"

// -----------------------------------------------------------------------------
// STATE MACHINE — WATCH/SETUP/ENTRY_PENDING/CONFIRMED_LONG/CONFIRMED_SHORT
// (Madde 18-19, 52-53, 55). Second confirmed-bar block (the first, above,
// only owns the DATA_INVALID gate — see its comment) since it needs
// setupType/setupStage/setupPromotable/hardVetoActive, all computed later
// in the script than that block. Drives ONLY off the Setup Classifier's
// generic setupStage/setupPromotable — genuinely archetype-agnostic, so
// whichever of the five archetypes won priority resolution (BREAKOUT_RETEST
// or one of the other four) is handled identically here (Madde 111). A
// setup reaching its own "fully confirmed" moment (setupPromotable) becomes
// a real CONFIRMED_LONG/CONFIRMED_SHORT only when the Veto Engine has NO
// hard veto — this is the module where that transition first became
// possible at all. If hard-vetoed, state stays at ENTRY_PENDING (never
// silently hidden, see VETO row) until i_entryPendingMaxBars bars pass,
// then reverts to FLAT (Madde 55 v3.1.1 EK's previously-open question:
// WATCH or FLAT — FLAT chosen for consistency with how a failed/stale
// setup already resolves, Madde 10 simplicity). The single currentState
// variable can only ever hold ONE value, so CONFIRMED_LONG and
// CONFIRMED_SHORT can structurally never coexist on the same bar (Madde 51
// v3.1.1 EK invariant, satisfied by construction).
// -----------------------------------------------------------------------------
var int entryPendingBlockedBars = 0
bool newlyConfirmed = false

// Guard extended (Madde 56, Phase G): once a position is actually open
// (IN_POSITION/EXIT/COOLDOWN), this setup-driven block must NOT keep
// overwriting currentState from fresh structural signals — the position
// lifecycle block below owns currentState exclusively until COOLDOWN
// resolves back to FLAT, at which point this block resumes normally.
if barstate.isconfirmed and currentState != EngineState.DATA_INVALID and
     currentState != EngineState.IN_POSITION and currentState != EngineState.EXIT and currentState != EngineState.COOLDOWN
    provisionalState = setupType == SetupType.NONE ? EngineState.FLAT :
         setupStage == SetupStage.FORMING ? EngineState.WATCH :
         setupStage == SetupStage.CONFIRMED ? EngineState.SETUP :
         setupStage == SetupStage.READY ? EngineState.ENTRY_PENDING :
         EngineState.FLAT

    if provisionalState == EngineState.ENTRY_PENDING and setupPromotable and not hardVetoActive
        wasAlreadyConfirmed = currentState == EngineState.CONFIRMED_LONG or currentState == EngineState.CONFIRMED_SHORT
        currentState := setupDir == BreakoutDirection.UP ? EngineState.CONFIRMED_LONG : EngineState.CONFIRMED_SHORT
        newlyConfirmed := not wasAlreadyConfirmed
        entryPendingBlockedBars := 0
    else if provisionalState == EngineState.ENTRY_PENDING and setupPromotable and hardVetoActive
        entryPendingBlockedBars := entryPendingBlockedBars + 1
        currentState := entryPendingBlockedBars > i_entryPendingMaxBars ? EngineState.FLAT : EngineState.ENTRY_PENDING
    else
        entryPendingBlockedBars := 0
        currentState := provisionalState

// -----------------------------------------------------------------------------
// POSITION LIFECYCLE / EXIT ENGINE (Madde 56-58) — Phase G, part 1. Only
// INITIAL STOP + TARGET are implemented as exits (Madde 57 also lists
// structure invalidation, break-even, trailing, time stop, partial exit,
// emergency exit — all explicitly deferred, see header). One stage advance
// per confirmed bar (mutually exclusive if/else-if on currentState AS IT
// STOOD entering this bar) — so CONFIRMED_LONG/SHORT (set just above, same
// bar) immediately becomes IN_POSITION also within this same bar (the
// chart label below uses posDirection, not currentState, for exactly this
// reason — currentState has already moved on by the time it draws); EXIT
// is then genuinely visible for one full bar before advancing to COOLDOWN
// on the NEXT bar, and COOLDOWN counts down before returning to FLAT.
// -----------------------------------------------------------------------------
var float posEntryPrice  = na
var float posStopLevel   = na
var float posTargetLevel = na
var BreakoutDirection posDirection = BreakoutDirection.NONE
var int posEntryBar = na
var string posExitReason = "N/A"
var int cooldownBarsLeft = 0

if barstate.isconfirmed and currentState != EngineState.DATA_INVALID
    if currentState == EngineState.CONFIRMED_LONG or currentState == EngineState.CONFIRMED_SHORT
        if na(posEntryPrice)
            posEntryPrice  := riskEntry
            posDirection   := setupDir
            posStopLevel   := setupDir == BreakoutDirection.UP ? longStopLevel : shortStopLevel
            posTargetLevel := setupDir == BreakoutDirection.UP ? longTargetLevel : shortTargetLevel
            posEntryBar    := bar_index
            currentState   := EngineState.IN_POSITION
    else if currentState == EngineState.IN_POSITION
        // Madde 57: if a bar touches BOTH stop and target, OHLC alone can't
        // tell us which happened first — never assume the optimistic
        // outcome. stopHit is checked FIRST and takes precedence.
        stopHit   = posDirection == BreakoutDirection.UP ? low <= posStopLevel : high >= posStopLevel
        targetHit = posDirection == BreakoutDirection.UP ? high >= posTargetLevel : low <= posTargetLevel
        if stopHit
            posExitReason := "STOP HIT"
            currentState  := EngineState.EXIT
        else if targetHit
            posExitReason := "TARGET HIT"
            currentState  := EngineState.EXIT
    else if currentState == EngineState.EXIT
        cooldownBarsLeft := i_cooldownBars
        currentState     := EngineState.COOLDOWN
        posEntryPrice    := na
        posStopLevel     := na
        posTargetLevel   := na
        posDirection     := BreakoutDirection.NONE
    else if currentState == EngineState.COOLDOWN
        cooldownBarsLeft := cooldownBarsLeft - 1
        if cooldownBarsLeft <= 0
            currentState := EngineState.FLAT

positionText = currentState == EngineState.IN_POSITION ?
     f_breakoutDirLabel(posDirection) + "  entry " + str.tostring(posEntryPrice) + "  stop " + str.tostring(posStopLevel) + "  target " + str.tostring(posTargetLevel) :
     currentState == EngineState.EXIT ? "EXIT (" + posExitReason + ")" :
     currentState == EngineState.COOLDOWN ? "COOLDOWN (" + str.tostring(math.max(cooldownBarsLeft, 0)) + " bars left, last: " + posExitReason + ")" :
     "N/A"

// -----------------------------------------------------------------------------
// ALERT ENGINE (Madde 116-117) — Phase G, part 2. State-transition/event
// based, never re-firing for the same state on consecutive bars (Madde
// 116). Fires on the confirmed bar — but see the TIMING NOTE in this
// turn's delivery message: per TradingView's own official docs (verified
// this turn, Madde 127) and this spec's own EK-H, the actual alert()
// notification is NOT delivered at the exact instant of confirmed bar
// close — it is delivered on the next possible tick (server waits for the
// first trade of the following bar to confirm no late trades, with a
// documented ~1-minute worst-case fallback during illiquid periods). The
// SCRIPT's own decision (which state to alert, computed from
// barstate.isconfirmed data) is still fully non-repainting; only the
// notification's real-world DELIVERY time lags slightly (Madde 136
// backtest/live parity — the gap is real, not ignored).
//
// SCORE and CONFIDENCE appear in Madde 117's example alert format, but
// NEITHER exists in this script — no scoring/aggregation engine (Madde 41)
// and no composite Signal Confidence (Madde 39) have been built. Per
// explicit user instruction: NOT fabricated. Shown as "N/A (not
// implemented)" rather than silently dropped, so the field's absence is
// visible and explained, not just missing (Madde 139/140).
// -----------------------------------------------------------------------------
alertLocationText = setupDir == BreakoutDirection.UP ? supZoneText : setupDir == BreakoutDirection.DOWN ? resZoneText : "N/A"
alertRRText = currentState == EngineState.IN_POSITION or currentState == EngineState.EXIT or currentState == EngineState.COOLDOWN ?
     (na(posEntryPrice) or na(posStopLevel) or posEntryPrice == posStopLevel ? "N/A" : str.tostring(math.abs(posTargetLevel - posEntryPrice) / math.abs(posEntryPrice - posStopLevel), "#.##")) :
     setupDir == BreakoutDirection.UP ? (na(longRR) ? "N/A" : str.tostring(longRR, "#.##")) :
     setupDir == BreakoutDirection.DOWN ? (na(shortRR) ? "N/A" : str.tostring(shortRR, "#.##")) :
     "N/A"
alertEntryText  = currentState == EngineState.IN_POSITION or currentState == EngineState.EXIT or currentState == EngineState.COOLDOWN ? (na(posEntryPrice) ? "N/A" : str.tostring(posEntryPrice)) : str.tostring(riskEntry)
alertStopText   = currentState == EngineState.IN_POSITION or currentState == EngineState.EXIT or currentState == EngineState.COOLDOWN ? (na(posStopLevel) ? "N/A" : str.tostring(posStopLevel)) :
     setupDir == BreakoutDirection.UP ? (na(longStopLevel) ? "N/A" : str.tostring(longStopLevel)) : setupDir == BreakoutDirection.DOWN ? (na(shortStopLevel) ? "N/A" : str.tostring(shortStopLevel)) : "N/A"
alertTargetText = currentState == EngineState.IN_POSITION or currentState == EngineState.EXIT or currentState == EngineState.COOLDOWN ? (na(posTargetLevel) ? "N/A" : str.tostring(posTargetLevel)) :
     setupDir == BreakoutDirection.UP ? (na(longTargetLevel) ? "N/A" : str.tostring(longTargetLevel)) : setupDir == BreakoutDirection.DOWN ? (na(shortTargetLevel) ? "N/A" : str.tostring(shortTargetLevel)) : "N/A"

alertMessage = "BTC PRO ENGINE\n\n" +
     "REGIME: " + f_regimeLabel(primaryRegime) + "\n" +
     "STRUCTURE: " + f_biasLabel(structureBias) + "\n" +
     "LOCATION: " + alertLocationText + "\n" +
     "SETUP: " + f_setupTypeLabel(setupType) + (setupType == SetupType.NONE ? "" : " " + f_breakoutDirLabel(setupDir)) + "\n" +
     "MOMENTUM: " + momentumText + "\n" +
     "PARTICIPATION: " + participationText + "\n" +
     "MTF: " + f_mtfAgreementLabel(mtfAgreement) + "\n" +
     "VOLATILITY: " + f_volLabel(volRegime) + "\n\n" +
     "ENTRY: " + alertEntryText + "\n" +
     "STOP: " + alertStopText + "\n" +
     "TARGET: " + alertTargetText + "\n" +
     "R:R: " + alertRRText + "\n\n" +
     "SCORE: N/A (not implemented)\n" +
     "CONFIDENCE: N/A (not implemented)\n" +
     "VETO: " + (hardVetoActive ? hardVetoText : "NONE")

var EngineState lastAlertedState = EngineState.DATA_INVALID
var bool lastAlertedHardVeto = false

// WATCH ENTER / SETUP ENTER / EXIT / COOLDOWN: currentState genuinely
// RESTS at these values across bars, so comparing against the last
// alerted state correctly catches the transition and never repeats
// (Madde 116). CONFIRMED_LONG/CONFIRMED_SHORT deliberately excluded here
// and handled separately below via `newlyConfirmed` — currentState
// advances to IN_POSITION within the SAME bar it becomes CONFIRMED (Phase
// G part 1), so it would never actually be observed resting at
// CONFIRMED_LONG/SHORT by this comparison (same lesson as the chart
// label's posDirection fix).
stateChangedForAlert = barstate.isconfirmed and currentState != lastAlertedState and currentState != EngineState.DATA_INVALID
if i_enableAlerts and stateChangedForAlert and
     (currentState == EngineState.WATCH or currentState == EngineState.SETUP or currentState == EngineState.EXIT or currentState == EngineState.COOLDOWN)
    alertStateLabel = currentState == EngineState.WATCH ? "WATCH ENTER" :
         currentState == EngineState.SETUP ? "SETUP ENTER" :
         currentState == EngineState.EXIT ? "EXIT (" + posExitReason + ")" :
         "COOLDOWN"
    alert(alertStateLabel + "\n\n" + alertMessage, freq = alert.freq_once_per_bar_close)

if i_enableAlerts and barstate.isconfirmed and newlyConfirmed
    alert((posDirection == BreakoutDirection.UP ? "CONFIRMED LONG" : "CONFIRMED SHORT") + "\n\n" + alertMessage, freq = alert.freq_once_per_bar_close)

if i_enableAlerts and barstate.isconfirmed and hardVetoActive and not lastAlertedHardVeto and setupType != SetupType.NONE
    alert("HARD VETO\n\n" + alertMessage, freq = alert.freq_once_per_bar_close)

if barstate.isconfirmed
    lastAlertedState    := currentState
    lastAlertedHardVeto := hardVetoActive

// -----------------------------------------------------------------------------
// DIAGNOSTICS (temporary — NOT the Madde 114 panel)
// -----------------------------------------------------------------------------
reasons = array.new<string>()
if not instrumentOK
    array.push(reasons, "INSTRUMENT MISMATCH")
if not exchangeOK
    array.push(reasons, "EXCHANGE WARNING")
if not ohlcValid
    array.push(reasons, "OHLC INVALID")
if not volumeValid
    array.push(reasons, "VOLUME NA")
if not sufficientHistory
    array.push(reasons, "INSUFFICIENT HISTORY")
if not atrValid
    array.push(reasons, "ATR UNAVAILABLE")
if not chartTypeOK
    array.push(reasons, "NON-TIME-BASED CHART (GAP CHECK DISABLED)")
if dataGapDetected
    array.push(reasons, "DATA GAP")
if abnormalBar
    array.push(reasons, "ABNORMAL BAR")
if staleDataDetected
    array.push(reasons, "STALE FEED")
reasonsText = array.size(reasons) > 0 ? array.join(reasons, ", ") : "NONE"

// PAGINATED DIAGNOSTICS (Madde 125 v0.15.1 fix) — ONE growing list of rows,
// ONE small table, sliced by i_diagPage/i_diagRowsPerPage. f_addDiagRow is
// the PERMANENT way any future module adds a diagnostics row: push a
// label/value/color triple here, never write a new table.cell block or a
// new table object. Arrays are mutated in place (Madde 111 — same pattern
// as f_upsertZone/f_updateZones taking array<Zone>).
f_addDiagRow(array<string> labels, array<string> values, array<color> colors, string label, string value, color col) =>
    array.push(labels, label)
    array.push(values, value)
    array.push(colors, col)
    true

diagLabels = array.new<string>()
diagValues = array.new<string>()
diagColors = array.new<color>()

f_addDiagRow(diagLabels, diagValues, diagColors, "STATE", f_stateLabel(currentState), f_stateColor(currentState))
f_addDiagRow(diagLabels, diagValues, diagColors, "DATA GATE (live)", liveDataValid ? "VALID" : "INVALID", liveDataValid ? color.lime : color.red)
f_addDiagRow(diagLabels, diagValues, diagColors, "SYMBOL", syminfo.tickerid, color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "EXCHANGE", syminfo.prefix + (exchangeOK ? "" : " (expected " + i_expectedExchange + ")"), exchangeOK ? color.gray : color.orange)
f_addDiagRow(diagLabels, diagValues, diagColors, "INSTRUMENT", syminfo.basecurrency + "/" + syminfo.currency, instrumentOK ? color.gray : color.red)
f_addDiagRow(diagLabels, diagValues, diagColors, "MARKET TYPE", marketTypeGuess, color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "BARS", str.tostring(bar_index + 1) + " / " + str.tostring(i_minBars), sufficientHistory ? color.gray : color.red)
f_addDiagRow(diagLabels, diagValues, diagColors, "OHLC / VOLUME", (ohlcValid ? "OK" : "INVALID") + " / " + (volumeValid ? "OK" : "NA"), (ohlcValid and volumeValid) ? color.gray : color.red)
f_addDiagRow(diagLabels, diagValues, diagColors, "GAP / ABNORMAL / STALE",
     (dataGapDetected or abnormalBar or staleDataDetected) ? ((dataGapDetected ? "GAP " : "") + (abnormalBar ? "ABN " : "") + (staleDataDetected ? "STALE" : "")) : "OK",
     (dataGapDetected or abnormalBar or staleDataDetected) ? color.red : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "ISSUES", reasonsText, array.size(reasons) > 0 ? color.orange : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "REGIME", f_regimeLabel(primaryRegime) + " (" + str.tostring(barsInRegime) + " bars)",
     primaryRegime == RegimeType.BULL_TREND ? color.lime : primaryRegime == RegimeType.BEAR_TREND ? color.red : primaryRegime == RegimeType.RANGE ? color.yellow : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "REGIME CONFIDENCE", f_confLabel(regimeConfidence),
     regimeConfidence == ConfidenceLevel.HIGH ? color.lime : regimeConfidence == ConfidenceLevel.MEDIUM ? color.yellow : color.red)
f_addDiagRow(diagLabels, diagValues, diagColors, "TREND VOTES (bull/bear)", str.tostring(bullVotes) + "/4  " + str.tostring(bearVotes) + "/4", color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "ADX(" + str.tostring(i_adxLen) + ")",
     not na(adxValue) ? str.tostring(adxValue, "#.##") + (trendStrong ? " (strong)" : " (weak)") : "N/A", trendStrong ? color.gray : color.silver)
f_addDiagRow(diagLabels, diagValues, diagColors, "VOLATILITY", f_volLabel(volRegime) + (not na(atrPctRank) ? " (" + str.tostring(atrPctRank, "#") + "pct)" : ""),
     volRegime == VolRegime.EXTREME_VOL ? color.red : volRegime == VolRegime.HIGH_VOL ? color.orange : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "STRUCTURE BIAS", f_biasLabel(structureBias),
     structureBias == StructureBias.BULLISH ? color.lime : structureBias == StructureBias.BEARISH ? color.red : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "LAST SWING HIGH", f_swingLabel(lastHighLabel) + " " + (na(lastSwingHighPrice) ? "N/A" : str.tostring(lastSwingHighPrice)) + " (" + swingHighAgeText + ")", color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "LAST SWING LOW", f_swingLabel(lastLowLabel) + " " + (na(lastSwingLowPrice) ? "N/A" : str.tostring(lastSwingLowPrice)) + " (" + swingLowAgeText + ")", color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "LAST EVENT", f_structEventLabel(lastStructureEvent) + lastEventAgeText,
     lastStructureEvent == StructureEvent.BOS_UP or lastStructureEvent == StructureEvent.CHOCH_UP ? color.lime :
      lastStructureEvent == StructureEvent.BOS_DOWN or lastStructureEvent == StructureEvent.CHOCH_DOWN ? color.red : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "BREAKOUT STATE", breakoutStateText,
     breakoutState == BreakoutFSMState.ENTRY ? color.lime : breakoutState == BreakoutFSMState.FAILED_BREAKOUT or breakoutState == BreakoutFSMState.REVERSAL_CANDIDATE ? color.red : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "BREAKOUT LEVEL", breakoutLevelText, color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "ZONES (R/S)", str.tostring(array.size(resistanceZones)) + " / " + str.tostring(array.size(supportZones)), color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "NEAREST RESISTANCE", resZoneText, resZoneText == "NONE" ? color.gray : color.red)
f_addDiagRow(diagLabels, diagValues, diagColors, "NEAREST SUPPORT", supZoneText, supZoneText == "NONE" ? color.gray : color.lime)
f_addDiagRow(diagLabels, diagValues, diagColors, "FIB LEG", fibLegText, fibValid ? color.gray : color.silver)
f_addDiagRow(diagLabels, diagValues, diagColors, "FIB TOUCH", fibTouchLabel, fibTouchLabel == "NONE" ? color.gray : color.yellow)
f_addDiagRow(diagLabels, diagValues, diagColors, "PRICE ACTION", lastPriceActionPatterns, lastPriceActionPatterns == "NONE" ? color.gray : color.yellow)
f_addDiagRow(diagLabels, diagValues, diagColors, "CANDLE METRICS", priceActionMetricsText, color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "MOMENTUM", momentumText,
     lastMomentumState == MomentumState.RECOVERING or lastMomentumState == MomentumState.ACCELERATING ? color.lime :
      lastMomentumState == MomentumState.WEAKENING ? color.orange : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "DIVERGENCE", divergenceText, lastDivergence == DivergenceType.NONE ? color.gray : color.fuchsia)
f_addDiagRow(diagLabels, diagValues, diagColors, "PARTICIPATION", participationText,
     lastParticipationState == ParticipationState.CONFIRMING ? color.lime : lastParticipationState == ParticipationState.DIVERGING ? color.orange : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "VWAP (rolling)", vwapText, color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "MTF HTF", mtfHtfText, mtfAvailable ? color.gray : color.silver)
f_addDiagRow(diagLabels, diagValues, diagColors, "MTF AGREEMENT", f_mtfAgreementLabel(mtfAgreement) + (mtfAvailable ? "  (" + mtfBiasText + ")" : ""),
     mtfAgreement == MtfAgreement.AGREE ? color.lime : mtfAgreement == MtfAgreement.CONFLICT ? color.orange : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "RISK LONG", riskLongText, longStatus == "OK" ? color.lime : longStatus == "ALREADY INVALIDATED" ? color.orange : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "RISK SHORT", riskShortText, shortStatus == "OK" ? color.lime : shortStatus == "ALREADY INVALIDATED" ? color.orange : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "POSITION SIZE (LONG)", posSizeLongText, color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "POSITION SIZE (SHORT)", posSizeShortText, color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "SETUP CLASSIFIER", setupText, setupType != SetupType.NONE ? color.yellow : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "OTHER SETUPS", otherSetupsText, color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "SETUP RISK", setupRiskText, color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "VETO (HARD)", hardVetoActive ? hardVetoText : (setupType == SetupType.NONE ? "N/A" : "none"), hardVetoActive ? color.red : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "VETO (SOFT)", array.size(softPenalties) > 0 ? softPenaltyText : (setupType == SetupType.NONE ? "N/A" : "none"), array.size(softPenalties) > 0 ? color.orange : color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "REQUEST BUDGET", "1 / 40 (MTF: 1 tuple request.security call)", color.gray)
f_addDiagRow(diagLabels, diagValues, diagColors, "POSITION", positionText,
     currentState == EngineState.IN_POSITION ? color.yellow : currentState == EngineState.EXIT ? (posExitReason == "TARGET HIT" ? color.lime : color.red) : color.gray)

// Slice: page 1 = rows 0..(N-1), page 2 = rows N..(2N-1), etc. Division by
// i_diagRowsPerPage promotes to float in Pine, so math.ceil gives the true
// page count; i_diagPage is clamped into [1, totalDiagPages] so an
// out-of-range page (e.g. content shrinks after a settings change) falls
// back to the last valid page instead of rendering nothing.
totalDiagRows = array.size(diagLabels)
// int()-wrapped throughout: math.ceil() returns float, and array.get()
// further below requires an int index — mixing float back in here would
// either fail to compile or (worse) silently coerce and risk an off-by-one
// that hides rows, exactly the kind of thing Madde 139/140 warns against.
totalDiagPages = math.max(1, int(math.ceil(float(totalDiagRows) / i_diagRowsPerPage)))
currentDiagPage = math.min(i_diagPage, totalDiagPages)
diagStartIdx = (currentDiagPage - 1) * i_diagRowsPerPage
diagEndIdx = math.min(diagStartIdx + i_diagRowsPerPage - 1, totalDiagRows - 1)
diagRowsShown = math.max(0, diagEndIdx - diagStartIdx + 1)

// +1 row reserved for the header (ENGINE version + PAGE x/y) shown on
// every page for orientation — never part of the paginated content itself.
var table debugTable = table.new(position.top_right, 2, i_diagRowsPerPage + 1, border_width = 1)

if i_showDebug and barstate.islast
    table.cell(debugTable, 0, 0, "ENGINE", text_size = size.tiny, text_color = color.white, bgcolor = color.new(color.navy, 0), text_halign = text.align_left)
    table.cell(debugTable, 1, 0, ENGINE_VERSION + "  PAGE " + str.tostring(currentDiagPage) + "/" + str.tostring(totalDiagPages),
         text_size = size.tiny, text_color = color.white, bgcolor = color.new(color.navy, 0), text_halign = text.align_left)
    if diagRowsShown > 0
        for i = 0 to diagRowsShown - 1
            idx = diagStartIdx + i
            table.cell(debugTable, 0, i + 1, array.get(diagLabels, idx), text_size = size.tiny, text_halign = text.align_left)
            table.cell(debugTable, 1, i + 1, array.get(diagValues, idx), text_size = size.tiny, text_color = array.get(diagColors, idx), text_halign = text.align_left)

// -----------------------------------------------------------------------------
// VISUAL CONFIRMATION (minimal — no panel/alert module yet)
// -----------------------------------------------------------------------------
bgcolor(i_showBg and currentState == EngineState.DATA_INVALID ? color.new(color.red, 90) : na)

plot(emaFast, "EMA Fast", color = color.new(color.teal, 30))
plot(emaMid,  "EMA Mid",  color = color.new(color.orange, 30))
plot(emaSlow, "EMA Slow", color = color.new(color.purple, 30))

plotshape(i_showStructureMarks and not na(pivotHighPrice) ? pivotHighPrice : na, title = "Swing High",
     style = shape.triangledown, location = location.absolute, offset = -i_pivotRight, color = color.red, size = size.tiny)
plotshape(i_showStructureMarks and not na(pivotLowPrice) ? pivotLowPrice : na, title = "Swing Low",
     style = shape.triangleup, location = location.absolute, offset = -i_pivotRight, color = color.lime, size = size.tiny)

if i_showStructureMarks and barstate.isconfirmed and (bosUpEvent or chochUpEvent)
    label.new(bar_index, high, bosUpEvent ? "BOS" : "CHoCH", style = label.style_label_down,
         color = bosUpEvent ? color.new(color.lime, 0) : color.new(color.blue, 0), textcolor = color.white, size = size.tiny)
if i_showStructureMarks and barstate.isconfirmed and (bosDownEvent or chochDownEvent)
    label.new(bar_index, low, bosDownEvent ? "BOS" : "CHoCH", style = label.style_label_up,
         color = bosDownEvent ? color.new(color.red, 0) : color.new(color.orange, 0), textcolor = color.white, size = size.tiny)

// Breakout FSM: only shown while an attempt is active (na while idle, via
// plot.style_linebr so the line breaks cleanly instead of dragging a stale
// level across idle periods).
plot(i_showBreakoutMarks and not f_isIdleBreakoutState(breakoutState) ? breakoutLevel : na, "Breakout Level",
     color = color.new(color.fuchsia, 40), style = plot.style_linebr, linewidth = 1)

if i_showBreakoutMarks and barstate.isconfirmed and breakoutStateBar == bar_index
    breakoutMarkColor = breakoutState == BreakoutFSMState.CONFIRMED_BREAKOUT ? color.blue :
         breakoutState == BreakoutFSMState.RETEST_PENDING ? color.orange :
         breakoutState == BreakoutFSMState.ENTRY ? color.lime :
         breakoutState == BreakoutFSMState.FAILED_BREAKOUT ? color.red :
         breakoutState == BreakoutFSMState.REVERSAL_CANDIDATE ? color.maroon :
         breakoutState == BreakoutFSMState.STALE ? color.gray :
         color.silver
    label.new(bar_index, breakoutDir == BreakoutDirection.UP ? high : low, f_breakoutStateLabel(breakoutState),
         style = breakoutDir == BreakoutDirection.UP ? label.style_label_down : label.style_label_up,
         color = color.new(breakoutMarkColor, 0), textcolor = color.white, size = size.tiny)

// Veto Engine (Madde 52-53): a distinct, larger marker ONLY on the bar a
// CONFIRMED_LONG/CONFIRMED_SHORT is first reached (newlyConfirmed, edge-
// triggered — not redrawn every bar it persists), separate from the
// Breakout FSM's own "ENTRY (structural only)" label above since this one
// means the Veto Engine found no hard veto, a materially different claim.
// v0.16.0 QA FIX caught before delivery (Madde 125): now that CONFIRMED_LONG/
// SHORT immediately advances to IN_POSITION within the SAME bar (Phase G
// position lifecycle, below), currentState no longer RESTS at CONFIRMED_LONG/
// SHORT by the time this visual code runs later in the same bar's execution
// — checking `currentState == EngineState.CONFIRMED_LONG` here would always
// be false, silently mislabeling every LONG confirmation as SHORT. Use
// posDirection instead, which is set in the same transition and persists
// through to this point (only cleared on the EXIT->COOLDOWN transition, a
// later bar).
if i_showBreakoutMarks and barstate.isconfirmed and newlyConfirmed
    label.new(bar_index, posDirection == BreakoutDirection.UP ? low : high,
         "CONFIRMED " + (posDirection == BreakoutDirection.UP ? "LONG" : "SHORT"),
         style = posDirection == BreakoutDirection.UP ? label.style_label_up : label.style_label_down,
         color = color.new(posDirection == BreakoutDirection.UP ? color.lime : color.red, 0),
         textcolor = color.white, size = size.small)

// Position Lifecycle (Madde 56-58): stop/target lines while IN_POSITION
// (na while idle, via plot.style_linebr so the line breaks cleanly rather
// than dragging a stale level across idle periods — same pattern as the
// Breakout Level plot above), and an EXIT marker on the bar the position
// actually closes (currentState rests at EXIT for exactly one bar, see the
// POSITION LIFECYCLE section's own comment).
plot(i_showPositionMarks and currentState == EngineState.IN_POSITION ? posStopLevel : na, "Position Stop",
     color = color.new(color.red, 20), style = plot.style_linebr, linewidth = 1)
plot(i_showPositionMarks and currentState == EngineState.IN_POSITION ? posTargetLevel : na, "Position Target",
     color = color.new(color.lime, 20), style = plot.style_linebr, linewidth = 1)

if i_showPositionMarks and barstate.isconfirmed and currentState == EngineState.EXIT
    label.new(bar_index, posDirection == BreakoutDirection.UP ? high : low, "EXIT: " + posExitReason,
         style = posDirection == BreakoutDirection.UP ? label.style_label_down : label.style_label_up,
         color = color.new(posExitReason == "TARGET HIT" ? color.lime : color.red, 0), textcolor = color.white, size = size.small)

// Price Action (Madde 22): small dots on the confirmed bar, bullish patterns
// below the bar, bearish above — diagnostic only, not a trigger/entry.
plotshape(i_showPriceActionMarks and barstate.isconfirmed and (paBullEngulf or paHammerShape),
     title = "Bullish Price Action", style = shape.circle, location = location.belowbar, color = color.lime, size = size.tiny)
plotshape(i_showPriceActionMarks and barstate.isconfirmed and (paBearEngulf or paStarShape),
     title = "Bearish Price Action", style = shape.circle, location = location.abovebar, color = color.red, size = size.tiny)

// Momentum divergence (Madde 23): label at the swing bar itself (using the
// central swing function's own SWING_TIME), not the current bar — "DIVERGENCE
// DETECTED" only, never presented as a guaranteed reversal.
if i_showMomentumMarks and barstate.isconfirmed and lastDivergenceBar == bar_index
    if lastDivergence == DivergenceType.BEARISH
        label.new(lastSwingHighSwingBar, lastSwingHighPrice, "DIV", style = label.style_label_down,
             color = color.new(color.fuchsia, 0), textcolor = color.white, size = size.tiny)
    if lastDivergence == DivergenceType.BULLISH
        label.new(lastSwingLowSwingBar, lastSwingLowPrice, "DIV", style = label.style_label_up,
             color = color.new(color.fuchsia, 0), textcolor = color.white, size = size.tiny)

// Participation (Madde 24): rolling VWAP line + a small marker only on
// CONFIRMING/DIVERGING bars (the two states worth flagging visually).
plot(i_showParticipationMarks ? rollingVwap : na, "Rolling VWAP", color = color.new(color.yellow, 20), linewidth = 1)

plotshape(i_showParticipationMarks and barstate.isconfirmed and partState == ParticipationState.CONFIRMING,
     title = "Participation Confirming", style = shape.triangleup, location = location.belowbar, color = color.lime, size = size.tiny)
plotshape(i_showParticipationMarks and barstate.isconfirmed and partState == ParticipationState.DIVERGING,
     title = "Participation Diverging", style = shape.xcross, location = location.abovebar, color = color.orange, size = size.tiny)

var array<box> zoneBoxes = array.new<box>()

if i_showZones and barstate.islast
    // Same empty-array guard as f_upsertZone above — Pine's `for a to b`
    // still runs once at index 0 when b < a (e.g. array.size()-1 == -1 on an
    // empty array), which crashed array.get()/array.delete() on bar 0.
    if array.size(zoneBoxes) > 0
        for i = 0 to array.size(zoneBoxes) - 1
            box.delete(array.get(zoneBoxes, i))
    array.clear(zoneBoxes)

    if array.size(resistanceZones) > 0
        for i = 0 to array.size(resistanceZones) - 1
            Zone z = array.get(resistanceZones, i)
            bx = box.new(left = z.createdBar, top = z.zoneHigh, right = bar_index + 10, bottom = z.zoneLow,
                 border_color = z.broken ? color.new(color.red, 70) : color.red,
                 bgcolor = z.broken ? color.new(color.red, 95) : color.new(color.red, 85),
                 border_style = z.broken ? line.style_dashed : line.style_solid)
            array.push(zoneBoxes, bx)

    if array.size(supportZones) > 0
        for i = 0 to array.size(supportZones) - 1
            Zone z = array.get(supportZones, i)
            bx = box.new(left = z.createdBar, top = z.zoneHigh, right = bar_index + 10, bottom = z.zoneLow,
                 border_color = z.broken ? color.new(color.lime, 70) : color.lime,
                 bgcolor = z.broken ? color.new(color.lime, 95) : color.new(color.lime, 85),
                 border_style = z.broken ? line.style_dashed : line.style_solid)
            array.push(zoneBoxes, bx)

// -----------------------------------------------------------------------------
// FIBONACCI VISUAL (Madde 17) — redrawn only on the last bar, same pattern as
// the zone boxes above. Empty-array guards are not needed here (arrays are
// cleared then filled unconditionally in the same block), but each level's
// existence is still checked by f_drawFibLevel via `not na(level)`.
// -----------------------------------------------------------------------------
var array<line> fibLines = array.new<line>()
var array<label> fibLabels = array.new<label>()

if i_showFib and barstate.islast
    if array.size(fibLines) > 0
        for i = 0 to array.size(fibLines) - 1
            line.delete(array.get(fibLines, i))
    array.clear(fibLines)
    if array.size(fibLabels) > 0
        for i = 0 to array.size(fibLabels) - 1
            label.delete(array.get(fibLabels, i))
    array.clear(fibLabels)

    if fibValid
        fibColor = color.new(color.aqua, 30)
        f_drawFibLevel(fibLines, fibLabels, legStartBar, bar_index + 10, fib236, "0.236", fibColor)
        f_drawFibLevel(fibLines, fibLabels, legStartBar, bar_index + 10, fib382, "0.382", fibColor)
        f_drawFibLevel(fibLines, fibLabels, legStartBar, bar_index + 10, fib500, "0.5",   fibColor)
        f_drawFibLevel(fibLines, fibLabels, legStartBar, bar_index + 10, fib618, "0.618", fibColor)
        f_drawFibLevel(fibLines, fibLabels, legStartBar, bar_index + 10, fib786, "0.786", fibColor)
