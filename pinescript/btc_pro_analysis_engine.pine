i_rsiLen = input.int(14, "RSI Length", minval = 1, group = grpMomentum)
i_rsiOverbought = input.float(70, "RSI Overbought", minval = 50, maxval = 100, group = grpMomentum)
i_rsiOversold = input.float(30, "RSI Oversold", minval = 0, maxval = 50, group = grpMomentum)
i_macdFast = input.int(12, "MACD Fast Length", minval = 1, group = grpMomentum)
i_macdSlow = input.int(26, "MACD Slow Length", minval = 1, group = grpMomentum)
i_macdSignal = input.int(9, "MACD Signal Length", minval = 1, group = grpMomentum)
i_momSlopeLookback = input.int(3, "Slope Lookback (bars)", minval = 1, group = grpMomentum)
i_showMomentumMarks = input.bool(true, "Show Divergence Markers", group = grpMomentum)

// -----------------------------------------------------------------------------
// INPUTS — PARTICIPATION (Madde 24)
// -----------------------------------------------------------------------------
grpParticipation = "Participation"
i_rvolLookback = input.int(20, "RVOL Average Volume Lookback (bars)", minval = 1, group = grpParticipation)
i_expansionRvolMult = input.float(1.5, "Volume Expansion Threshold (x avg)", minval = 1.0, group = grpParticipation)
i_contractionRvolMult = input.float(0.5, "Volume Contraction Threshold (x avg)", minval = 0.05, maxval = 1.0, group = grpParticipation)
i_obvSlopeLookback = input.int(3, "OBV Slope Lookback (bars)", minval = 1, group = grpParticipation)
i_vwapLookback = input.int(20, "Rolling VWAP Lookback (bars)", minval = 1, group = grpParticipation,
     tooltip = "N-bar rolling volume-weighted average, NOT session-anchored — Madde 24: BTC 24/7, session-open kavramı yok.")
i_showParticipationMarks = input.bool(true, "Show Participation Markers / VWAP", group = grpParticipation)

// -----------------------------------------------------------------------------
// INPUTS — MTF REFINEMENT (Madde 28-32)
// -----------------------------------------------------------------------------
grpMtf = "MTF Refinement"
i_mtfMode = input.string("AUTO", "HTF Selection", options = ["AUTO", "MANUAL"], group = grpMtf,
     tooltip = "AUTO: Madde 28 varsayılan rollerinin basitleştirilmiş hali (chart <=15m->1H, <=1H->4H, <=4H->1D, >=1D->N/A). MANUAL: aşağıdaki HTF'i kullan.")
i_mtfManualTf = input.timeframe("240", "Manual HTF (only used if AUTO is off)", group = grpMtf)
i_mtfEmaLen = input.int(50, "HTF Trend EMA Length", minval = 1, group = grpMtf)
i_mtfSlopeLookback = input.int(5, "HTF EMA Slope Lookback (HTF bars)", minval = 1, group = grpMtf)

// -----------------------------------------------------------------------------
// INPUTS — RISK ENGINE (Madde 44-49) — diagnostic calculator only, no
// setup/trigger exists yet to actually place a trade against these numbers.
// -----------------------------------------------------------------------------
grpRisk = "Risk Engine — diagnostic only (no live setup/trigger yet)"
i_riskAtrBufferMult = input.float(0.5, "Stop ATR Buffer (x ATR beyond structural level)", minval = 0, group = grpRisk,
     tooltip = "Madde 44-45: stop = STRUCTURAL INVALIDATION + ATR BUFFER, asla rastgele %.")
i_maxStopDistancePct = input.float(5.0, "Max Acceptable Stop Distance (% of price)", minval = 0.1, group = grpRisk,
     tooltip = "Madde 45 — stop bu mesafeden uzaksa STOP TOO WIDE.")
i_minRR = input.float(1.5, "Minimum R:R (hard gate)", minval = 0.1, group = grpRisk,
     tooltip = "Madde 47 — başlangıç hipotezi, optimize edilmedi (Madde 10). Tercih edilen: 2.0+.")
i_accountEquity = input.float(10000, "Account Equity (USDT, diagnostic only)", minval = 0, group = grpRisk)
i_riskPctPerTrade = input.float(1.0, "Risk % per Trade", minval = 0.01, maxval = 100, group = grpRisk,
     tooltip = "Madde 48: Risk Amount = Equity x Risk%.")
i_leverage = input.float(1.0, "Leverage (1.0 = spot / no leverage)", minval = 1.0, group = grpRisk,
     tooltip = "Madde 48 — leverage açıkça belirtilmeden varsayılmaz; varsayılan 1.0 (spot, kaldıraçsız).")

// -----------------------------------------------------------------------------
// INPUTS — VETO ENGINE (Madde 52-53)
// -----------------------------------------------------------------------------
grpVeto = "Veto Engine — hard vetoes block CONFIRMED, never hidden"
i_entryPendingMaxBars = input.int(20, "ENTRY_PENDING Veto-Blocked Timeout (bars)", minval = 1, group = grpVeto,
     tooltip = "Madde 55 v3.1.1 EK — breakoutState ENTRY'ye ulaştığı ama hard veto yüzünden CONFIRMED'e geçemediği durumda, bu bar sayısından sonra FLAT'e döner (o zamana kadar ENTRY_PENDING'de görünür kalır).")

grpDebug = "Diagnostics (temporary — replaced by the compact panel in a later phase)"
i_showDebug = input.bool(true, "Show Diagnostics Table", group = grpDebug)
i_diagDetail = input.string("FULL", "Diagnostics Detail", options = ["COMPACT", "FULL"], group = grpDebug,
     tooltip = "COMPACT: yalnızca kritik özet, FULL: tüm modül çıktıları.")
i_showBg    = input.bool(true, "Highlight DATA_INVALID bars", group = grpDebug)

// -----------------------------------------------------------------------------
// SYMBOL / DATA SOURCE VALIDATION (Madde 1, 8)
// -----------------------------------------------------------------------------
exchangeOK   = str.upper(syminfo.prefix)      == str.upper(i_expectedExchange)
baseOK       = str.upper(syminfo.basecurrency) == str.upper(i_expectedBase)
quoteOK      = str.upper(syminfo.currency)     == str.upper(i_expectedQuote)
instrumentOK = baseOK and quoteOK   // hard: wrong instrument entirely (not BTC/USDT)

// Spot vs perpetual: never asserted with false confidence (Madde 1, 127, 139, 140).
tickerUpper     = str.upper(syminfo.ticker)
isPerpByType    = syminfo.type == "swap"
isPerpByTicker  = str.contains(tickerUpper, ".P") or str.contains(tickerUpper, "SWAP") or str.contains(tickerUpper, "PERP")
isSpotByType    = syminfo.type == "spot" or syminfo.type == "crypto"
marketTypeGuess = isPerpByType or isPerpByTicker ? "PERPETUAL (heuristic — verify)" :
                   isSpotByType and not isPerpByTicker ? "SPOT (heuristic — verify)" :
                   "UNKNOWN — VERIFY MANUALLY"

// -----------------------------------------------------------------------------
// DATA GATE CHECKS (Madde 7) — computed every tick for live diagnostics
// -----------------------------------------------------------------------------
ohlcValid = not na(open) and not na(high) and not na(low) and not na(close) and
             high >= low and high >= open and high >= close and low <= open and low <= close

volumeValid = not na(volume)   // NA stays NA — never silently treated as 0 (Madde 7)

sufficientHistory = bar_index >= (i_minBars - 1)

atrValue = ta.atr(14)
atrValid = not na(atrValue) and atrValue > 0

expectedIntervalMs = timeframe.in_seconds() * 1000
chartTypeOK = not na(expectedIntervalMs) and expectedIntervalMs > 0
dataGapDetected = chartTypeOK and bar_index > 0 and not na(time[1]) and
     (time - time[1]) > expectedIntervalMs * i_gapMult

barRange = high - low
abnormalBar = atrValid and barRange > atrValue * i_abnormalAtrMult

var int staleBars = 0
if barstate.isconfirmed
    isStaleRepeat = bar_index > 0 and open == open[1] and high == high[1] and low == low[1] and close == close[1]
    staleBars := isStaleRepeat ? staleBars + 1 : 0
staleDataDetected = staleBars >= i_staleBarsThreshold

// Aggregate — LIVE (not yet confirmed, for immediate diagnostics only; Madde 34)
liveDataValid = instrumentOK and ohlcValid and volumeValid and sufficientHistory and
     atrValid and not dataGapDetected and not abnormalBar and not staleDataDetected

// -----------------------------------------------------------------------------
// STATE TRANSITION — CONFIRMED BAR ONLY (Madde 33-34, non-repainting standard)
// -----------------------------------------------------------------------------
if barstate.isconfirmed
    if not liveDataValid
        currentState := EngineState.DATA_INVALID
    else if currentState == EngineState.DATA_INVALID
        currentState := EngineState.FLAT
    // else: currentState stays whatever it already was here — the actual
    // FLAT/WATCH/SETUP/ENTRY_PENDING refinement now happens in a SECOND
    // confirmed-bar block, further down, once the Setup Classifier's inputs
    // (breakoutState, primaryRegime) are computed (Madde 18-19). This block
    // only owns the DATA_INVALID gate. CONFIRMED_LONG/CONFIRMED_SHORT/
    // IN_POSITION/EXIT/COOLDOWN still do NOT exist — those require the Veto
    // Engine (Madde 52-53) and Final Decision Engine (Madde 37), neither of
    // which is built yet.

// -----------------------------------------------------------------------------
// MARKET REGIME — TREND (Madde 10, 13). Structure/Zone exist now (below) but
// are NOT yet wired into Regime Confidence — see header note.
// -----------------------------------------------------------------------------
emaFast = ta.ema(close, i_emaFastLen)
emaMid  = ta.ema(close, i_emaMidLen)
emaSlow = ta.ema(close, i_emaSlowLen)

emaAlignmentBull = emaFast > emaMid and emaMid > emaSlow
emaAlignmentBear = emaFast < emaMid and emaMid < emaSlow
priceAboveAll = close > emaFast and close > emaMid and close > emaSlow
priceBelowAll = close < emaFast and close < emaMid and close < emaSlow
slopeUp   = emaMid > emaMid[i_slopeLookback]
slopeDown = emaMid < emaMid[i_slopeLookback]

[diPlus, diMinus, adxValue] = ta.dmi(i_adxLen, i_adxLen)
diBullish   = diPlus > diMinus
trendStrong = not na(adxValue) and adxValue >= i_adxTrendThreshold

bullVotes = (emaAlignmentBull ? 1 : 0) + (priceAboveAll ? 1 : 0) + (slopeUp ? 1 : 0) + (diBullish ? 1 : 0)
bearVotes = (emaAlignmentBear ? 1 : 0) + (priceBelowAll ? 1 : 0) + (slopeDown ? 1 : 0) + (not diBullish ? 1 : 0)

rangeBandWidth = ta.highest(high, i_rangeLookback) - ta.lowest(low, i_rangeLookback)
priceContained = atrValid and rangeBandWidth < atrValue * i_rangeAtrThreshold

rawRegime = trendStrong and bullVotes >= 3 ? RegimeType.BULL_TREND :
             trendStrong and bearVotes >= 3 ? RegimeType.BEAR_TREND :
             not trendStrong and priceContained ? RegimeType.RANGE :
             RegimeType.TRANSITION

// Persistence / hysteresis (Madde 10) — only advances on confirmed, data-valid bars.
var RegimeType primaryRegime = RegimeType.TRANSITION
var RegimeType pendingRegime = RegimeType.TRANSITION
var int pendingBars  = 0
var int barsInRegime = 0

if barstate.isconfirmed and currentState != EngineState.DATA_INVALID
    pendingBars  := rawRegime == pendingRegime ? pendingBars + 1 : 1
    pendingRegime := rawRegime

    if pendingBars >= i_regimeConfirmBars and primaryRegime != pendingRegime
        primaryRegime := pendingRegime
        barsInRegime  := 1
    else
        barsInRegime := barsInRegime + 1

// -----------------------------------------------------------------------------
// VOLATILITY REGIME (Madde 9, 26) — separate overlay, never mixed with primaryRegime.
// -----------------------------------------------------------------------------
atrPct     = atrValid ? (atrValue / close) * 100 : na
atrPctRank = na(atrPct) ? na : ta.percentrank(atrPct, i_volLookback)

volRegime = na(atrPctRank) ? VolRegime.NORMAL_VOL :
             atrPctRank >= i_volExtremePct ? VolRegime.EXTREME_VOL :
             atrPctRank >= i_volHighPct ? VolRegime.HIGH_VOL :
             atrPctRank <= i_volLowPct ? VolRegime.LOW_VOL :
             VolRegime.NORMAL_VOL

// -----------------------------------------------------------------------------
// REGIME CONFIDENCE (Madde 11 + v3.1 EK) — NOT a binding gate yet (that belongs
// to the Decision Engine, Madde 37, Phase F); exposed here for later use.
// Structure-agreement factor still NOT included (see header note).
// -----------------------------------------------------------------------------
maxVotes = math.max(bullVotes, bearVotes)
trendAgreementScore = maxVotes >= 4 ? 2 : maxVotes == 3 ? 1 : 0
volStabilityScore   = volRegime == VolRegime.EXTREME_VOL ? 0 : 1
persistenceScore    = barsInRegime >= i_regimeConfirmBars * 2 ? 1 : 0
confidenceScoreRaw  = trendAgreementScore + volStabilityScore + persistenceScore

regimeConfidence = primaryRegime == RegimeType.TRANSITION ? ConfidenceLevel.LOW :
                     confidenceScoreRaw >= 3 ? ConfidenceLevel.HIGH :
                     confidenceScoreRaw == 2 ? ConfidenceLevel.MEDIUM :
                     ConfidenceLevel.LOW

// -----------------------------------------------------------------------------
// MARKET STRUCTURE — CENTRAL CONFIRMED-SWING FUNCTION (Madde 14 v3.1 EK)
// ta.pivothigh/low are called UNCONDITIONALLY every bar (required for correct
// internal history tracking); only the resulting state update is gated on
// barstate.isconfirmed below.
// -----------------------------------------------------------------------------
pivotHighPrice = ta.pivothigh(i_pivotLeft, i_pivotRight)
pivotLowPrice  = ta.pivotlow(i_pivotLeft, i_pivotRight)

// Computed here (unconditional, top-level, before Momentum's own section
// further below) SOLELY so the swing-registration blocks below can snapshot
// RSI-at-swing-bar for divergence detection (Madde 23) — divergence must
// reuse the SAME central swing function rather than inventing its own pivot
// search (Madde 14 v3.1 EK). The full Momentum state classification lives in
// its own section later, after Price Action.
rsiValue = ta.rsi(close, i_rsiLen)

var float lastSwingHighPrice    = na   // last CONFIRMED swing high (KNOWN at lastSwingHighKnownBar)
var int   lastSwingHighSwingBar = na   // SWING_TIME (bar it actually occurred)
var int   lastSwingHighKnownBar = na   // KNOWN_TIME (bar the script learned about it)
var float prevSwingHighPrice    = na
var float lastSwingHighRSI      = na   // RSI value AT the swing bar (SWING_TIME), for divergence
var float prevSwingHighRSI      = na

var float lastSwingLowPrice    = na
var int   lastSwingLowSwingBar = na
var int   lastSwingLowKnownBar = na
var float prevSwingLowPrice    = na
var float lastSwingLowRSI      = na
var float prevSwingLowRSI      = na

var SwingLabel lastHighLabel = SwingLabel.NONE
var SwingLabel lastLowLabel  = SwingLabel.NONE
var StructureBias structureBias = StructureBias.NEUTRAL
var StructureEvent lastStructureEvent = StructureEvent.NONE
var int lastStructureEventBar = na

// Zone stores (Madde 15, 16) — resistance from confirmed swing highs, support
// from confirmed swing lows.
var array<Zone> resistanceZones = array.new<Zone>()
var array<Zone> supportZones    = array.new<Zone>()

// Break-of-level checks against the most recently CONFIRMED swing levels.
// Called UNCONDITIONALLY every bar (ta.crossover/crossunder must not be
// called inside an `if` — Madde 124 syntax/logic QA); only the resulting
// state update (below) is confirmed-bar-gated, so no repaint/future leak.
crossedAboveLastHigh = ta.crossover(close, lastSwingHighPrice)
crossedBelowLastLow  = ta.crossunder(close, lastSwingLowPrice)

// Captured BEFORE this bar's swing registration below can mutate
// lastSwingHighPrice/lastSwingLowPrice — the Breakout FSM (further below)
// needs the level as it stood WHEN the cross happened, not a possibly
// already-updated value from later in this same confirmed bar.
brokenHighLevel = lastSwingHighPrice
brokenLowLevel  = lastSwingLowPrice

bosUpEvent    = false
bosDownEvent  = false
chochUpEvent  = false
chochDownEvent = false

if barstate.isconfirmed
    // 1) Register new confirmed swings (Madde 14 — KNOWN_TIME vs SWING_TIME)
    //    and create/cluster the corresponding zone (Madde 15, 16). Zone body
    //    is the swing candle's wick-to-body span — no arbitrary ATR guess.
    if not na(pivotHighPrice)
        prevSwingHighPrice := lastSwingHighPrice
        prevSwingHighRSI := lastSwingHighRSI
        lastHighLabel := na(prevSwingHighPrice) ? SwingLabel.NONE : (pivotHighPrice > prevSwingHighPrice ? SwingLabel.HH : SwingLabel.LH)
        lastSwingHighPrice := pivotHighPrice
        lastSwingHighRSI := rsiValue[i_pivotRight]   // RSI AT the swing bar, matching pivotHighPrice's own SWING_TIME
        lastSwingHighSwingBar := bar_index - i_pivotRight
        lastSwingHighKnownBar := bar_index
        zoneLowBoundHigh = math.max(open[i_pivotRight], close[i_pivotRight])
        f_upsertZone(resistanceZones, pivotHighPrice, zoneLowBoundHigh, bar_index - i_pivotRight, bar_index, atrValue, i_clusterAtrMult, i_maxZonesPerSide)

    if not na(pivotLowPrice)
        prevSwingLowPrice := lastSwingLowPrice
        prevSwingLowRSI := lastSwingLowRSI
        lastLowLabel := na(prevSwingLowPrice) ? SwingLabel.NONE : (pivotLowPrice > prevSwingLowPrice ? SwingLabel.HL : SwingLabel.LL)
        lastSwingLowPrice := pivotLowPrice
        lastSwingLowRSI := rsiValue[i_pivotRight]
        lastSwingLowSwingBar := bar_index - i_pivotRight
        lastSwingLowKnownBar := bar_index
        zoneHighBoundLow = math.min(open[i_pivotRight], close[i_pivotRight])
        f_upsertZone(supportZones, zoneHighBoundLow, pivotLowPrice, bar_index - i_pivotRight, bar_index, atrValue, i_clusterAtrMult, i_maxZonesPerSide)

    // 2) BOS / CHoCH — break of a previously CONFIRMED swing level (Madde 14, 61).
    // First break after NEUTRAL establishes initial bias (treated as CHoCH);
    // a break agreeing with current bias is BOS (continuation), a break
    // against it is CHoCH (reversal).
    if crossedAboveLastHigh
        if structureBias == StructureBias.BULLISH
            bosUpEvent := true
            lastStructureEvent := StructureEvent.BOS_UP
        else
            chochUpEvent := true
            structureBias := StructureBias.BULLISH
            lastStructureEvent := StructureEvent.CHOCH_UP
        lastStructureEventBar := bar_index

    if crossedBelowLastLow
        if structureBias == StructureBias.BEARISH
            bosDownEvent := true
            lastStructureEvent := StructureEvent.BOS_DOWN
        else
            chochDownEvent := true
            structureBias := StructureBias.BEARISH
            lastStructureEvent := StructureEvent.CHOCH_DOWN
        lastStructureEventBar := bar_index

    // 3) Ongoing touch-count / broken-status maintenance for ALL existing
    //    zones, every confirmed bar (Madde 15, 16) — independent of whether
    //    a new swing formed this bar.
    f_updateZones(resistanceZones, true, high, low, close, bar_index)
    f_updateZones(supportZones, false, high, low, close, bar_index)

swingHighAgeText = na(lastSwingHighSwingBar) ? "N/A" : str.tostring(bar_index - lastSwingHighSwingBar) + " bars ago"
swingLowAgeText  = na(lastSwingLowSwingBar) ? "N/A" : str.tostring(bar_index - lastSwingLowSwingBar) + " bars ago"
lastEventAgeText = na(lastStructureEventBar) ? "" : " (" + str.tostring(bar_index - lastStructureEventBar) + " bars ago)"

nearestResIdx = f_nearestZone(resistanceZones, close)
nearestSupIdx = f_nearestZone(supportZones, close)
resZoneText = f_zoneSummary(resistanceZones, nearestResIdx, emaFast, emaMid, emaSlow, atrValue, i_emaConfluenceAtrMult, bar_index, i_freshAgeBars, i_staleAgeBars, i_exhaustTouches)
supZoneText = f_zoneSummary(supportZones, nearestSupIdx, emaFast, emaMid, emaSlow, atrValue, i_emaConfluenceAtrMult, bar_index, i_freshAgeBars, i_staleAgeBars, i_exhaustTouches)

// -----------------------------------------------------------------------------
// FIBONACCI (Madde 17) — active leg = the two most recently confirmed swings
// (central swing function above); level(ratio) is a pure derivation of those
// already-confirmed prices, so no separate confirmed-bar gate is needed here.
// -----------------------------------------------------------------------------
legIsUp   = not na(lastSwingHighSwingBar) and not na(lastSwingLowSwingBar) and lastSwingHighSwingBar > lastSwingLowSwingBar
legIsDown = not na(lastSwingHighSwingBar) and not na(lastSwingLowSwingBar) and lastSwingLowSwingBar > lastSwingHighSwingBar
fibValid  = legIsUp or legIsDown
legStartBar = legIsUp ? lastSwingLowSwingBar : legIsDown ? lastSwingHighSwingBar : na

fib236 = fibValid ? f_fibLevel(legIsUp, lastSwingHighPrice, lastSwingLowPrice, 0.236) : na
fib382 = fibValid ? f_fibLevel(legIsUp, lastSwingHighPrice, lastSwingLowPrice, 0.382) : na
fib500 = fibValid ? f_fibLevel(legIsUp, lastSwingHighPrice, lastSwingLowPrice, 0.5)   : na
fib618 = fibValid ? f_fibLevel(legIsUp, lastSwingHighPrice, lastSwingLowPrice, 0.618) : na
fib786 = fibValid ? f_fibLevel(legIsUp, lastSwingHighPrice, lastSwingLowPrice, 0.786) : na

// Diagnostic only — Madde 17: FIB TOUCH ≠ ENTRY. Real confirmation still
// needs STRUCTURE + ZONE + TRIGGER + MOMENTUM, none combined yet.
fibTouchLabel = f_fibTouchLabel(close, fib236, fib382, fib500, fib618, fib786, atrValue * i_fibTouchAtrMult)
fibLegText = not fibValid ? "N/A (need 2 opposite confirmed swings)" :
     legIsUp ? "UP: " + str.tostring(lastSwingLowPrice) + " -> " + str.tostring(lastSwingHighPrice) :
     "DOWN: " + str.tostring(lastSwingHighPrice) + " -> " + str.tostring(lastSwingLowPrice)

// -----------------------------------------------------------------------------
// BREAKOUT / RETEST STATE MACHINE (Madde 20-21) — reuses crossedAboveLastHigh/
// crossedBelowLastLow (already computed above for BOS/CHoCH) as the break
// trigger; no new level logic. Only STRUCTURE-family evidence (price vs.
// level) is used — no fabricated volume/momentum "quality" (Madde 21, those
// modules don't exist yet).
// -----------------------------------------------------------------------------
var BreakoutFSMState breakoutState = BreakoutFSMState.PRE_BREAKOUT
var BreakoutDirection breakoutDir  = BreakoutDirection.NONE
var float breakoutLevel    = na
var int   breakoutBar      = na   // bar the candidate started
var int   breakoutConfBar  = na   // bar displacement was confirmed
var int   breakoutStateBar = na   // bar of the last state change (for age display)

if barstate.isconfirmed
    if crossedAboveLastHigh and f_isIdleBreakoutState(breakoutState)
        breakoutState := BreakoutFSMState.BREAKOUT_CANDIDATE
        breakoutDir := BreakoutDirection.UP
        breakoutLevel := brokenHighLevel
        breakoutBar := bar_index
        breakoutConfBar := na
        breakoutStateBar := bar_index
    else if crossedBelowLastLow and f_isIdleBreakoutState(breakoutState)
        breakoutState := BreakoutFSMState.BREAKOUT_CANDIDATE
        breakoutDir := BreakoutDirection.DOWN
        breakoutLevel := brokenLowLevel
        breakoutBar := bar_index
        breakoutConfBar := na
        breakoutStateBar := bar_index

    else if breakoutState == BreakoutFSMState.BREAKOUT_CANDIDATE
        candDisplacement = breakoutDir == BreakoutDirection.UP ? close - breakoutLevel : breakoutLevel - close
        candFailed = breakoutDir == BreakoutDirection.UP ? close < breakoutLevel : close > breakoutLevel
        if candFailed
            breakoutState := BreakoutFSMState.FAILED_BREAKOUT
            breakoutStateBar := bar_index
        else if atrValid and candDisplacement >= atrValue * i_confirmDisplacementAtrMult
            breakoutState := BreakoutFSMState.CONFIRMED_BREAKOUT
            breakoutConfBar := bar_index
            breakoutStateBar := bar_index
        else if (bar_index - breakoutBar) > i_candidateMaxBars
            breakoutState := BreakoutFSMState.STALE
            breakoutStateBar := bar_index

    else if breakoutState == BreakoutFSMState.CONFIRMED_BREAKOUT
        confFailed = breakoutDir == BreakoutDirection.UP ? close < breakoutLevel : close > breakoutLevel
        touchedLevel = atrValid and (breakoutDir == BreakoutDirection.UP ?
             low <= breakoutLevel + atrValue * i_retestAtrMult :
             high >= breakoutLevel - atrValue * i_retestAtrMult)
        if confFailed
            breakoutState := BreakoutFSMState.FAILED_BREAKOUT
            breakoutStateBar := bar_index
        else if touchedLevel
            breakoutState := BreakoutFSMState.RETEST_PENDING
            breakoutStateBar := bar_index
        else if not na(breakoutConfBar) and (bar_index - breakoutConfBar) > i_retestMaxBars
            breakoutState := BreakoutFSMState.STALE
            breakoutStateBar := bar_index

    else if breakoutState == BreakoutFSMState.RETEST_PENDING
        retestRejected = breakoutDir == BreakoutDirection.UP ? close < breakoutLevel : close > breakoutLevel
        retestAccepted = breakoutDir == BreakoutDirection.UP ? close > breakoutLevel : close < breakoutLevel
        if retestRejected
            breakoutState := BreakoutFSMState.REVERSAL_CANDIDATE
            breakoutStateBar := bar_index
        else if retestAccepted
            breakoutState := BreakoutFSMState.ENTRY
            breakoutStateBar := bar_index
        else if not na(breakoutConfBar) and (bar_index - breakoutConfBar) > i_retestMaxBars
            breakoutState := BreakoutFSMState.STALE
            breakoutStateBar := bar_index

breakoutStateAgeText = na(breakoutStateBar) ? "" : " (" + str.tostring(bar_index - breakoutStateBar) + " bars ago)"
breakoutStateText = f_breakoutStateLabel(breakoutState) + (breakoutDir == BreakoutDirection.NONE ? "" : " " + f_breakoutDirLabel(breakoutDir)) + breakoutStateAgeText
breakoutLevelText = na(breakoutLevel) ? "N/A" : str.tostring(breakoutLevel)

// -----------------------------------------------------------------------------
// PRICE ACTION ENGINE (Madde 22) — mathematical primitives first (BODY/RANGE,
// WICK/BODY, CLOSE LOCATION, RANGE/ATR), then a minimal named-pattern set
// derived from them. `barRange` reused from the Data Gate section above (no
// duplicate calculation, Madde 111). Computed live every bar but only
// SNAPSHOTTED into the displayed var strings on confirmed bars (Madde 33-34),
// same pattern as Structure's lastHighLabel/lastLowLabel.
// -----------------------------------------------------------------------------
paBodySize  = math.abs(close - open)
paBodyHigh  = math.max(open, close)
paBodyLow   = math.min(open, close)
paUpperWick = high - paBodyHigh
paLowerWick = paBodyLow - low

paBodyToRange   = barRange > 0 ? paBodySize / barRange : na
paCloseLocation = barRange > 0 ? (close - low) / barRange : na   // 0 = closed at low, 1 = closed at high
paRangeToAtr    = atrValid ? barRange / atrValue : na

paBullEngulf = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
paBearEngulf = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

paHammerShape = not na(paBodyToRange) and paLowerWick >= i_wickBodyMult * paBodySize and
     paUpperWick <= paBodySize * i_smallWickMaxMult and paBodyToRange <= i_smallBodyMaxRatio
paStarShape = not na(paBodyToRange) and paUpperWick >= i_wickBodyMult * paBodySize and
     paLowerWick <= paBodySize * i_smallWickMaxMult and paBodyToRange <= i_smallBodyMaxRatio

paUpperRejection = barRange > 0 and paUpperWick >= i_rejectionRangeMult * barRange
paLowerRejection = barRange > 0 and paLowerWick >= i_rejectionRangeMult * barRange

paInsideBar  = high <= high[1] and low >= low[1]
paOutsideBar = high >= high[1] and low <= low[1]

paStrongCloseUp   = not na(paCloseLocation) and paCloseLocation >= i_strongCloseThreshold
paStrongCloseDown = not na(paCloseLocation) and paCloseLocation <= (1 - i_strongCloseThreshold)

var string lastPriceActionPatterns = "NONE"
var int    lastPriceActionBar      = na
var float  lastBodyToRange         = na
var float  lastCloseLocation       = na
var float  lastRangeToAtr          = na

if barstate.isconfirmed
    paPatterns = array.new<string>()
    if paBullEngulf
        array.push(paPatterns, "BULL ENGULF")
    if paBearEngulf
        array.push(paPatterns, "BEAR ENGULF")
    if paHammerShape
        array.push(paPatterns, "HAMMER")
    if paStarShape
        array.push(paPatterns, "SHOOTING STAR")
    if paUpperRejection
        array.push(paPatterns, "UPPER REJECTION")
    if paLowerRejection
        array.push(paPatterns, "LOWER REJECTION")
    if paInsideBar
        array.push(paPatterns, "INSIDE BAR")
    if paOutsideBar
        array.push(paPatterns, "OUTSIDE BAR")
    if paStrongCloseUp
        array.push(paPatterns, "STRONG CLOSE UP")
    if paStrongCloseDown
        array.push(paPatterns, "STRONG CLOSE DOWN")
    lastPriceActionPatterns := array.size(paPatterns) > 0 ? array.join(paPatterns, ", ") : "NONE"
    lastPriceActionBar := bar_index
    lastBodyToRange := paBodyToRange
    lastCloseLocation := paCloseLocation
    lastRangeToAtr := paRangeToAtr

priceActionMetricsText = (na(lastBodyToRange) ? "N/A" : "body/range " + str.tostring(lastBodyToRange, "#.##")) +
     "  close@" + (na(lastCloseLocation) ? "N/A" : str.tostring(lastCloseLocation, "#.##")) +
     "  range/ATR " + (na(lastRangeToAtr) ? "N/A" : str.tostring(lastRangeToAtr, "#.##"))

// -----------------------------------------------------------------------------
// MOMENTUM ENGINE (Madde 23) — RSI + MACD histogram only (not also Stochastic/
// CCI, Madde 6 double-counting ban). Goal is a STATE label, never "RSI level
// = direction" (rsiValue/macdHist never feed any entry/direction logic here).
// -----------------------------------------------------------------------------
rsiRising  = rsiValue > rsiValue[i_momSlopeLookback]
rsiFalling = rsiValue < rsiValue[i_momSlopeLookback]
rsiOverboughtNow = rsiValue >= i_rsiOverbought
rsiOversoldNow   = rsiValue <= i_rsiOversold

[macdLine, macdSignal, macdHist] = ta.macd(close, i_macdFast, i_macdSlow, i_macdSignal)
histRising  = macdHist > macdHist[i_momSlopeLookback]
histFalling = macdHist < macdHist[i_momSlopeLookback]

momDirection = macdHist > 0 ? MomentumDirection.BULLISH : macdHist < 0 ? MomentumDirection.BEARISH : MomentumDirection.NONE

momState = rsiOversoldNow and rsiRising ? MomentumState.RECOVERING :
     rsiOverboughtNow and rsiFalling ? MomentumState.WEAKENING :
     momDirection == MomentumDirection.BULLISH and histRising ? MomentumState.ACCELERATING :
     momDirection == MomentumDirection.BULLISH and histFalling ? MomentumState.DECELERATING :
     momDirection == MomentumDirection.BEARISH and histFalling ? MomentumState.ACCELERATING :
     momDirection == MomentumDirection.BEARISH and histRising ? MomentumState.DECELERATING :
     MomentumState.NEUTRAL

var MomentumState     lastMomentumState = MomentumState.NEUTRAL
var MomentumDirection lastMomentumDir   = MomentumDirection.NONE
var float             lastRsiSnapshot   = na
var DivergenceType    lastDivergence    = DivergenceType.NONE
var int               lastDivergenceBar = na

if barstate.isconfirmed
    lastMomentumState := momState
    lastMomentumDir := momDirection
    lastRsiSnapshot := rsiValue

    // Divergence (Madde 23): reuses the SAME confirmed swings Structure just
    // registered above in this same bar — a new HH with LOWER RSI-at-swing
    // than the previous HH is bearish divergence; a new LL with HIGHER
    // RSI-at-swing is bullish divergence. Reported as DETECTED only, never a
    // guaranteed reversal.
    if not na(pivotHighPrice) and not na(prevSwingHighRSI) and not na(prevSwingHighPrice) and
         lastSwingHighPrice > prevSwingHighPrice and lastSwingHighRSI < prevSwingHighRSI
        lastDivergence := DivergenceType.BEARISH
        lastDivergenceBar := bar_index
    if not na(pivotLowPrice) and not na(prevSwingLowRSI) and not na(prevSwingLowPrice) and
         lastSwingLowPrice < prevSwingLowPrice and lastSwingLowRSI > prevSwingLowRSI
        lastDivergence := DivergenceType.BULLISH
        lastDivergenceBar := bar_index

divergenceAgeText = na(lastDivergenceBar) ? "" : " (" + str.tostring(bar_index - lastDivergenceBar) + " bars ago)"
divergenceText = f_divergenceLabel(lastDivergence) + (lastDivergence == DivergenceType.NONE ? "" : divergenceAgeText)
momentumText = f_momStateLabel(lastMomentumState) + (lastMomentumDir == MomentumDirection.NONE ? "" : " " + f_momDirLabel(lastMomentumDir)) +
     "  RSI " + (na(lastRsiSnapshot) ? "N/A" : str.tostring(lastRsiSnapshot, "#.#"))

// -----------------------------------------------------------------------------
// PARTICIPATION ENGINE (Madde 24) — RVOL + OBV alignment only, not every
// volume-flavored indicator at once (Madde 6). VWAP is a FIXED N-bar rolling
// average, NOT session-anchored (Madde 24: BTC is 24/7, no session-open
// concept assumed, consistent with Madde 1/107).
// -----------------------------------------------------------------------------
volAvg = ta.sma(volume, i_rvolLookback)
rvol = volumeValid and not na(volAvg) and volAvg > 0 ? volume / volAvg : na
rvolExpanding   = not na(rvol) and rvol >= i_expansionRvolMult
rvolContracting = not na(rvol) and rvol <= i_contractionRvolMult

// OBV built manually from ta.cum/ta.change/math.sign — Pine's ta.* namespace
// has no bare ta.obv series to call, unlike ta.tr (Madde 127: verify, don't
// assume). Standard OBV definition: cumulative sum of volume signed by the
// direction of each bar's close-to-close change.
obvValue   = ta.cum(volume * math.sign(ta.change(close)))
obvRising  = obvValue > obvValue[i_obvSlopeLookback]
obvFalling = obvValue < obvValue[i_obvSlopeLookback]

barBullish = close > open
barBearish = close < open

alignedBullish = barBullish and obvRising
alignedBearish = barBearish and obvFalling
misaligned     = (barBullish and obvFalling) or (barBearish and obvRising)

partDirection = alignedBullish ? ParticipationDirection.BULLISH : alignedBearish ? ParticipationDirection.BEARISH : ParticipationDirection.NONE

partState = rvolExpanding and (alignedBullish or alignedBearish) ? ParticipationState.CONFIRMING :
     rvolExpanding and misaligned ? ParticipationState.DIVERGING :
     rvolContracting ? ParticipationState.CONTRACTING :
     rvolExpanding ? ParticipationState.EXPANDING :
     ParticipationState.NORMAL

rollingVwapNum = ta.sma(close * volume, i_vwapLookback)
rollingVwapDen = ta.sma(volume, i_vwapLookback)
rollingVwap = volumeValid and not na(rollingVwapDen) and rollingVwapDen > 0 ? rollingVwapNum / rollingVwapDen : na
priceAboveVwap = not na(rollingVwap) and close > rollingVwap

var ParticipationState     lastParticipationState = ParticipationState.NORMAL
var ParticipationDirection lastParticipationDir   = ParticipationDirection.NONE
var float                  lastRvol               = na
var float                  lastVwap               = na
var bool                   lastPriceAboveVwap      = bool(na)

if barstate.isconfirmed
    lastParticipationState := partState
    lastParticipationDir := partDirection
    lastRvol := rvol
    lastVwap := rollingVwap
    lastPriceAboveVwap := priceAboveVwap

participationText = f_partStateLabel(lastParticipationState) + (lastParticipationDir == ParticipationDirection.NONE ? "" : " " + f_partDirLabel(lastParticipationDir)) +
     "  RVOL " + (na(lastRvol) ? "N/A" : str.tostring(lastRvol, "#.##"))
vwapText = na(lastVwap) ? "N/A" : str.tostring(lastVwap) + (lastPriceAboveVwap ? " (price above)" : " (price below)")

// -----------------------------------------------------------------------------
// MTF REFINEMENT (Madde 28-32) — first item of Phase E. Exactly ONE HTF,
// exactly ONE request.security() call (1/40 budget). HTF resolution is built
// entirely from `input.*` values and `timeframe.in_seconds(timeframe.period)`
// (all "simple", never "series" qualified), so the resulting timeframe string
// stays valid as request.security()'s (simple-string-only) second argument
// even though it depends on a ternary chain.
// -----------------------------------------------------------------------------
chartTfSeconds = timeframe.in_seconds(timeframe.period)
manualTfSeconds = timeframe.in_seconds(i_mtfManualTf)

// "One level up" from Madde 28's default role table, collapsed to a single
// HTF (the full 1D/4H/1H/15m cascade is deferred, see header note). Falls
// back to the chart's own timeframe.period when no higher default role
// exists — a always-valid, non-empty string to hand to request.security();
// mtfAvailable (below) is what actually gates whether this is trusted/shown,
// so no fabricated data reaches the diagnostics table (Madde 139/140).
autoHtf = chartTfSeconds <= 900 ? "60" : chartTfSeconds <= 3600 ? "240" : chartTfSeconds <= 14400 ? "1D" : timeframe.period
autoHtfAvailable = chartTfSeconds <= 14400

mtfResolvedTf = i_mtfMode == "MANUAL" ? i_mtfManualTf : autoHtf
mtfAvailable = chartTypeOK and (i_mtfMode == "MANUAL" ? manualTfSeconds > chartTfSeconds : autoHtfAvailable)

// Non-repainting HTF access (Madde 29): every value in the tuple is offset by
// `[1]` (the slope reference by `[i_mtfSlopeLookback + 1]`) AND the call uses
// `lookahead = barmerge.lookahead_on` together — the official TradingView
// non-repainting pattern. Bare `lookahead_on` without an offset expression is
// forbidden by Madde 29 and is never used. One HTF bar of lag is accepted on
// purpose (Madde 29: no future leak for an earlier signal).
[htfClose, htfEma, htfEmaSlopeRef] = request.security(syminfo.tickerid, mtfResolvedTf,
     [close[1], ta.ema(close, i_mtfEmaLen)[1], ta.ema(close, i_mtfEmaLen)[i_mtfSlopeLookback + 1]],
     lookahead = barmerge.lookahead_on)

htfBiasRaw = htfClose > htfEma and htfEma > htfEmaSlopeRef ? StructureBias.BULLISH :
     htfClose < htfEma and htfEma < htfEmaSlopeRef ? StructureBias.BEARISH :
     StructureBias.NEUTRAL

mtfAgreement = not mtfAvailable ? MtfAgreement.UNAVAILABLE :
     htfBiasRaw == StructureBias.NEUTRAL or structureBias == StructureBias.NEUTRAL ? MtfAgreement.NEUTRAL :
     htfBiasRaw == structureBias ? MtfAgreement.AGREE :
     MtfAgreement.CONFLICT

mtfHtfText = mtfAvailable ? mtfResolvedTf + (i_mtfMode == "MANUAL" ? " (manual)" : " (auto)") :
     "N/A" + (i_mtfMode == "MANUAL" ? " (manual HTF <= chart TF)" : " (chart already >= 1D)")
mtfBiasText = mtfAvailable ? f_biasLabel(htfBiasRaw) + " vs chart " + f_biasLabel(structureBias) : "N/A"

// -----------------------------------------------------------------------------
// RISK ENGINE (Madde 44-49) — first item of Phase F. DIAGNOSTIC ONLY: no
// Setup Classifier exists yet, so this is not wired to any actual entry. It
// reuses the SAME nearestResIdx/nearestSupIdx the Zone module already
// computed (Madde 111 — no new zone search) as the structural stop/target
// reference; falls back to the last confirmed swing when no zone exists yet,
// and to a genuine "NO STRUCTURAL STOP" (never a fabricated number, Madde
// 139/140) when neither is available.
// -----------------------------------------------------------------------------
riskEntry = close

// array.get() must NEVER be called with an out-of-range index (-1 = "no
// zone yet"). Pine's ternary evaluates BOTH branches eagerly (same lesson
// as the v0.4.1 RE10045 fix — see header), so `idx >= 0 ? array.get(...) :
// fallback` would still call array.get() on -1 and crash. Explicit if/else
// statements are used instead so the invalid branch is never evaluated.

// LONG idea: invalidated below the nearest SUPPORT, targets the nearest
// RESISTANCE (its near edge, not a blind "entry + 2 ATR", Madde 46).
float longStopRaw = na
float longTargetRaw = na
if nearestSupIdx >= 0
    longStopRaw := array.get(supportZones, nearestSupIdx).zoneLow
else
    longStopRaw := lastSwingLowPrice
if nearestResIdx >= 0
    longTargetRaw := array.get(resistanceZones, nearestResIdx).zoneLow

// SHORT idea: invalidated above the nearest RESISTANCE, targets the nearest
// SUPPORT (its near edge). Same f_riskCalc function, just isLong=false
// (Madde 50 — no asymmetric long/short logic).
float shortStopRaw = na
float shortTargetRaw = na
if nearestResIdx >= 0
    shortStopRaw := array.get(resistanceZones, nearestResIdx).zoneHigh
else
    shortStopRaw := lastSwingHighPrice
if nearestSupIdx >= 0
    shortTargetRaw := array.get(supportZones, nearestSupIdx).zoneHigh

[longStopLevel, longTargetLevel, longStopDist, longRewardDist, longRR, longStatus] =
     f_riskCalc(true, riskEntry, longStopRaw, longTargetRaw, atrValue, i_riskAtrBufferMult, i_maxStopDistancePct, i_minRR)
[shortStopLevel, shortTargetLevel, shortStopDist, shortRewardDist, shortRR, shortStatus] =
     f_riskCalc(false, riskEntry, shortStopRaw, shortTargetRaw, atrValue, i_riskAtrBufferMult, i_maxStopDistancePct, i_minRR)

[longRiskAmount, longPosSize, longNotional, longMargin] = f_positionSize(i_accountEquity, i_riskPctPerTrade, longStopDist, riskEntry, i_leverage)
[shortRiskAmount, shortPosSize, shortNotional, shortMargin] = f_positionSize(i_accountEquity, i_riskPctPerTrade, shortStopDist, riskEntry, i_leverage)

riskLongText  = f_riskLine(longStopLevel, longTargetLevel, longRR, longStatus)
riskShortText = f_riskLine(shortStopLevel, shortTargetLevel, shortRR, shortStatus)

posSizeLongText  = f_posSizeLine(longPosSize, longNotional, longMargin)
posSizeShortText = f_posSizeLine(shortPosSize, shortNotional, shortMargin)
posSizeCompactText = "L " + (na(longPosSize) ? "N/A" : str.tostring(longPosSize, "#.####")) + " / S " + (na(shortPosSize) ? "N/A" : str.tostring(shortPosSize, "#.####")) + " BTC"

// -----------------------------------------------------------------------------
// SETUP CLASSIFIER (Madde 18-19) — "setup-specific decision rules", Phase F.
// Only BREAKOUT_RETEST is detected this turn (see the SetupType enum's
// header comment for why); it reuses the Breakout FSM (Madde 20-21) as its
// entire trigger/confirmation/invalidation/expiry machinery — no new state
// machine invented (Madde 111). Eligibility (Madde 19) is computed by
// f_breakoutRetestEligible above, purely from breakoutDir vs primaryRegime.
// -----------------------------------------------------------------------------
setupEligible = f_breakoutRetestEligible(breakoutDir, primaryRegime)
setupType = setupEligible and f_isActiveSetupState(breakoutState) ? SetupType.BREAKOUT_RETEST : SetupType.NONE

setupEligibilityText = breakoutDir == BreakoutDirection.NONE ? "N/A (no breakout attempt)" :
     setupEligible ? "ELIGIBLE (" + f_regimeLabel(primaryRegime) + ")" :
     "NOT ELIGIBLE (" + f_breakoutDirLabel(breakoutDir) + " vs " + f_regimeLabel(primaryRegime) + ", Madde 19)"

setupText = f_setupTypeLabel(setupType) + (setupType == SetupType.NONE ? "" : " " + f_breakoutDirLabel(breakoutDir)) +
     "  [" + setupEligibilityText + "]"

// Whichever Risk Engine side actually corresponds to this live setup's
// direction (Madde 111 — reuse the already-computed LONG/SHORT numbers,
// don't recompute a third time).
setupRiskText = setupType != SetupType.BREAKOUT_RETEST ? "N/A" :
     breakoutDir == BreakoutDirection.UP ? riskLongText : riskShortText

// -----------------------------------------------------------------------------
// VETO ENGINE (Madde 52-53) — Phase F, the piece that finally lets the chain
// (Regime -> Structure -> Zone -> Breakout FSM -> Setup Classifier -> Risk
// Engine) reach a real CONFIRMED_LONG/CONFIRMED_SHORT. Runs INDEPENDENTLY
// of score (Madde 52 — no scoring engine exists anyway, so this is
// trivially satisfied). Only the HARD VETO / SOFT PENALTY categories this
// script has actual evidence for are implemented (Madde 139/140 — no
// fabricated checks for EXECUTION INVALID, LEVERAGE CASCADE RISK, ACCOUNT
// CIRCUIT BREAKER, position/exposure violation, etc., none of which exist
// yet), evaluated in Madde 53's PRECEDENCE order:
//   RISK INVALID      = the live setup's Risk Engine status != OK (Madde
//                        111 — reuses f_riskCalc's status, already covers
//                        Madde 52's "poor R:R", stop/target problems,
//                        "entry too close"/already-invalidated cases).
//   STRUCTURE INVALID = severe MTF conflict (mtfAgreement == CONFLICT,
//                        Madde 52's explicit "severe MTF conflict" item).
//   SETUP INVALID     = Setup Classifier says not eligible, or the
//                        Breakout FSM already failed/is idle (Madde 19,
//                        Madde 52's "failed setup").
// SOFT PENALTIES (Madde 52) are informational only, never block CONFIRMED:
// weak participation, weak momentum, MTF NEUTRAL (as opposed to the hard
// CONFLICT), low regime confidence, elevated volatility.
//
// Per explicit user instruction: no NEW magic-number threshold is
// hardcoded here — R:R is already i_minRR (Risk Engine's own input), and
// the one new threshold this module introduces (the ENTRY_PENDING
// veto-blocked timeout, Madde 55 v3.1.1 EK) is i_entryPendingMaxBars
// below. A hard-vetoed setup is NEVER silently hidden: it stays visible at
// its current WATCH/SETUP/ENTRY_PENDING state with the reason shown in the
// VETO diagnostics row, only falling back to FLAT if fully expired.
// -----------------------------------------------------------------------------
liveRiskStatus = breakoutDir == BreakoutDirection.UP ? longStatus : shortStatus
riskInvalid = setupType == SetupType.BREAKOUT_RETEST and liveRiskStatus != "OK"
structureInvalid = setupType == SetupType.BREAKOUT_RETEST and mtfAgreement == MtfAgreement.CONFLICT
setupInvalid = setupType != SetupType.BREAKOUT_RETEST

hardVetoReasons = array.new<string>()
if riskInvalid
    array.push(hardVetoReasons, "RISK INVALID (" + liveRiskStatus + ")")
if structureInvalid
    array.push(hardVetoReasons, "STRUCTURE INVALID (severe MTF conflict)")
if setupInvalid
    array.push(hardVetoReasons, "SETUP INVALID (" + (not setupEligible ? "not eligible" : "no active setup") + ")")
hardVetoActive = array.size(hardVetoReasons) > 0

softPenalties = array.new<string>()
if lastParticipationState == ParticipationState.CONTRACTING
    array.push(softPenalties, "weak participation")
if lastMomentumState == MomentumState.WEAKENING or lastMomentumState == MomentumState.NEUTRAL
    array.push(softPenalties, "weak momentum")
if mtfAgreement == MtfAgreement.NEUTRAL
    array.push(softPenalties, "MTF unclear")
if regimeConfidence == ConfidenceLevel.LOW
    array.push(softPenalties, "low regime confidence")
if volRegime == VolRegime.HIGH_VOL or volRegime == VolRegime.EXTREME_VOL
    array.push(softPenalties, "elevated volatility")

softPenaltyText = array.size(softPenalties) > 0 ? array.join(softPenalties, ", ") : "none"
hardVetoText = array.size(hardVetoReasons) > 0 ? array.join(hardVetoReasons, "; ") : "none"
// Full text collapses to a plain "N/A" while nothing is even attempting a
// setup — showing "HARD VETO: SETUP INVALID" through every idle FLAT bar
// would be technically true but pure noise (Madde 10).
vetoText = breakoutDir == BreakoutDirection.NONE ? "N/A (no active setup)" :
     hardVetoActive ? "HARD VETO: " + hardVetoText + (array.size(softPenalties) > 0 ? "  [soft: " + softPenaltyText + "]" : "") :
     array.size(softPenalties) > 0 ? "no hard veto  [soft: " + softPenaltyText + "]" :
     "CLEAN"

// -----------------------------------------------------------------------------
// STATE MACHINE — WATCH/SETUP/ENTRY_PENDING/CONFIRMED_LONG/CONFIRMED_SHORT
// (Madde 18-19, 52-53, 55). Second confirmed-bar block (the first, above,
// only owns the DATA_INVALID gate — see its comment) since it needs
// breakoutState/setupEligible/hardVetoActive, all computed later in the
// script than that block. A structural ENTRY (retest accepted) becomes a
// real CONFIRMED_LONG/CONFIRMED_SHORT only when the Veto Engine has NO hard
// veto — this is the first module where that transition can happen at all.
// If hard-vetoed, state stays at ENTRY_PENDING (never silently hidden, see
// VETO row) until i_entryPendingMaxBars bars pass, then reverts to FLAT
// (Madde 55 v3.1.1 EK's previously-open question: WATCH or FLAT — FLAT
// chosen for consistency with how FAILED_BREAKOUT/REVERSAL_CANDIDATE/STALE
// already all resolve to FLAT, Madde 10 simplicity). The single
// currentState variable can only ever hold ONE value, so CONFIRMED_LONG
// and CONFIRMED_SHORT can structurally never coexist on the same bar
// (Madde 51 v3.1.1 EK invariant, satisfied by construction).
// -----------------------------------------------------------------------------
var int entryPendingBlockedBars = 0
bool newlyConfirmed = false

if barstate.isconfirmed and currentState != EngineState.DATA_INVALID
    provisionalState = not setupEligible ? EngineState.FLAT :
         breakoutState == BreakoutFSMState.BREAKOUT_CANDIDATE ? EngineState.WATCH :
         breakoutState == BreakoutFSMState.CONFIRMED_BREAKOUT ? EngineState.SETUP :
         breakoutState == BreakoutFSMState.RETEST_PENDING ? EngineState.ENTRY_PENDING :
         breakoutState == BreakoutFSMState.ENTRY ? EngineState.ENTRY_PENDING :
         EngineState.FLAT

    if provisionalState == EngineState.ENTRY_PENDING and breakoutState == BreakoutFSMState.ENTRY and not hardVetoActive
        wasAlreadyConfirmed = currentState == EngineState.CONFIRMED_LONG or currentState == EngineState.CONFIRMED_SHORT
        currentState := breakoutDir == BreakoutDirection.UP ? EngineState.CONFIRMED_LONG : EngineState.CONFIRMED_SHORT
        newlyConfirmed := not wasAlreadyConfirmed
        entryPendingBlockedBars := 0
    else if provisionalState == EngineState.ENTRY_PENDING and breakoutState == BreakoutFSMState.ENTRY and hardVetoActive
        entryPendingBlockedBars := entryPendingBlockedBars + 1
        currentState := entryPendingBlockedBars > i_entryPendingMaxBars ? EngineState.FLAT : EngineState.ENTRY_PENDING
    else
        entryPendingBlockedBars := 0
        currentState := provisionalState

// -----------------------------------------------------------------------------
// DIAGNOSTICS (temporary — NOT the Madde 114 panel)
// -----------------------------------------------------------------------------
reasons = array.new<string>()
if not instrumentOK
    array.push(reasons, "INSTRUMENT MISMATCH")
if not exchangeOK
    array.push(reasons, "EXCHANGE WARNING")
if not ohlcValid
    array.push(reasons, "OHLC INVALID")
if not volumeValid
    array.push(reasons, "VOLUME NA")
if not sufficientHistory
    array.push(reasons, "INSUFFICIENT HISTORY")
if not atrValid
    array.push(reasons, "ATR UNAVAILABLE")
if not chartTypeOK
    array.push(reasons, "NON-TIME-BASED CHART (GAP CHECK DISABLED)")
if dataGapDetected
    array.push(reasons, "DATA GAP")
if abnormalBar
    array.push(reasons, "ABNORMAL BAR")
if staleDataDetected
    array.push(reasons, "STALE FEED")
reasonsText = array.size(reasons) > 0 ? array.join(reasons, ", ") : "NONE"

// Row count depends on i_diagDetail, resolved once at table creation (inputs
// are known constants throughout the run, so this ternary is safe here).
var table debugTable = table.new(position.top_right, 2, i_diagDetail == "COMPACT" ? 20 : 44, border_width = 1)

if i_showDebug and barstate.islast and i_diagDetail == "COMPACT"
    // Curated 10-row summary — added per user request once the FULL table
    // (28 rows) started risking overflow on smaller screens/panes; FULL
    // still has everything below for deeper debugging.
    table.cell(debugTable, 0, 0, "ENGINE", text_size = size.tiny, text_color = color.white, bgcolor = color.new(color.navy, 0), text_halign = text.align_left)
    table.cell(debugTable, 1, 0, ENGINE_VERSION, text_size = size.tiny, text_color = color.white, bgcolor = color.new(color.navy, 0), text_halign = text.align_left)

    table.cell(debugTable, 0, 1, "STATE", text_size = size.tiny, text_halign = text.align_left)
    table.cell(debugTable, 1, 1, f_stateLabel(currentState), text_size = size.tiny, text_color = f_stateColor(currentState), text_halign = text.align_left)

    table.cell(debugTable, 0, 2, "DATA GATE", text_size = size.tiny, text_halign = text.align_left)
    table.cell(debugTable, 1, 2, liveDataValid ? "VALID" : "INVALID", text_size = size.tiny, text_color = liveDataValid ? color.lime : color.red, text_halign = text.align_left)

    table.cell(debugTable, 0, 3, "ISSUES", text_size = size.tiny, text_halign = text.align_left)
    table.cell(debugTable, 1, 3, reasonsText, text_size = size.tiny, text_color = array.size(reasons) > 0 ? color.orange : color.gray, text_halign = text.align_left)

    table.cell(debugTable, 0, 4, "REGIME", text_size = size.tiny, text_halign = text.align_left)
    table.cell(debugTable, 1, 4, f_regimeLabel(primaryRegime) + " / " + f_confLabel(regimeConfidence), text_size = size.tiny,
         text_color = primaryRegime == RegimeType.BULL_TREND ? color.lime : primaryRegime == RegimeType.BEAR_TREND ? color.red : color.gray,
         text_halign = text.align_left)

    table.cell(debugTable, 0, 5, "STRUCTURE BIAS", text_size = size.tiny, text_halign = text.align_left)
    table.cell(debugTable, 1, 5, f_biasLabel(structureBias), text_size = size.tiny,
         text_color = structureBias == StructureBias.BULLISH ? color.lime : structureBias == StructureBias.BEARISH ? color.red : color.gray,
         text_halign = text.align_left)

    table.cell(debugTable, 0, 6, "BREAKOUT FSM", text_size = size.tiny, text_halign = text.align_left)
    table.cell(debugTable, 1, 6, f_breakoutStateLabel(breakoutState) + (breakoutDir == BreakoutDirection.NONE ? "" : " " + f_breakoutDirLabel(breakoutDir)), text_size = size.tiny, text_halign = text.align_left)

    table.cell(debugTable, 0, 7, "NEAREST RESISTANCE", text_size = size.tiny, text_halign = text.align_left)
    table.cell(debugTable, 1, 7, resZoneText, text_size = size.tiny, text_color = resZoneText == "NONE" ? color.gray : color.red, text_halign = text.align_left)

    table.cell(debugTable, 0, 8, "NEAREST SUPPORT", text_size = size.tiny, text_halign = text.align_left)
    table.cell(debugTable, 1, 8, supZoneText, text_size = size.tiny, text_color = supZoneText == "NONE" ? color.gray : color.lime, text_halign = text.align_left)

    table.cell(debugTable, 0, 9, "PRICE ACTION", text_size = size.tiny, text_halign = text.align_left)
    table.cell(debugTable, 1, 9, lastPriceActionPatterns, text_size = size.tiny, text_color = lastPriceActionPatterns == "NONE" ? color.gray : color.yellow, text_halign = text.align_left)

    table.cell(debugTable, 0, 10, "MOMENTUM", text_size = size.tiny, text_halign = text.align_left)
    table.cell(debugTable, 1, 10, momentumText, text_size = size.tiny,
         text_color = lastMomentumState == MomentumState.RECOVERING or lastMomentumState == MomentumState.ACCELERATING ? color.lime :
                       lastMomentumState == MomentumState.WEAKENING ? color.orange : color.gray,
         text_halign = text.align_left)

    table.cell(debugTable, 0, 11, "PARTICIPATION", text_size = size.tiny, text_halign = text.align_left)
    table.cell(debugTable, 1, 11, participationText, text_size = size.tiny,
         text_color = lastParticipationState == ParticipationState.CONFIRMING ? color.lime : lastParticipationState == ParticipationState.DIVERGING ? color.orange : color.gray,
         text_halign = text.align_left)

    table.cell(debugTable, 0, 12, "MTF HTF", text_size = size.tiny, text_halign = text.align_left)
    table.cell(debugTable, 1, 12, mtfHtfText, text_size = size.tiny, text_color = mtfAvailable ? color.gray : color.silver, text_halign = text.align_left)

