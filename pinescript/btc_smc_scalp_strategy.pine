// © BTC Al/Sat Sinyal Sistemi - kişisel araştırma/analiz projesi. Yatırım tavsiyesi değildir.
//
// ============================================================================
// BTC SMC Scalp Stratejisi v2 (BOS/CHoCH + Order Block + FVG + Momentum + Trend)
// ============================================================================
//
// v2 DEĞİŞİKLİKLERİ (v1'de bulunan sorunlara karşı):
// 1. GİRİŞ ONAYI GÜÇLENDİRİLDİ: v1'de fiyat order block/FVG'ye sadece
//    "değip" o bar biraz yeşil kapanınca hemen giriş veriliyordu - bu, kısa
//    vadeli/gürültülü grafiklerde tam tepe/dip noktasında (henüz gerçek bir
//    tepki oluşmadan) tetiklenmeye çok açıktı ("düşeceği yerde al" sorunu).
//    Artık İKİ AŞAMALI: (a) fiyat bölgeye dokunur -> "beklemede" işaretlenir,
//    (b) belirli bir bar penceresi içinde (confirmMaxBars) fiyat bölgenin
//    ÜST sınırını gerçek bir kapanışla GERİ KAZANIRSA (reclaim) giriş onaylanır.
// 2. MOMENTUM ONAYI EKLENDİ: RSI + MACD histogram artık zorunlu bir ek
//    confluence katmanı (en başta konuşulan "MACD + Stokastik/momentum +
//    SMC" fikrinin momentum ayağı).
// 3. AL/SAT/BEKLE + EN DETAYLI GEREKÇE PANELİ: Grafiğin köşesinde sürekli
//    görünen bir tablo - anlık sinyal, trend/yapı/bölge/momentum durumu,
//    Long/Short skorları (X/5), eksik koşullar, nihai kararın gerekçesi.
// 4. GRAFİK SADELEŞTİRİLDİ: BOS/CHoCH etiketleri ve OB/FVG kutuları
//    varsayılan KAPALI (isteğe bağlı açılabilir) - varsayılan görünümde
//    sadece AL/SAT/ÇIKIŞ etiketleri ve detay paneli var.
//
// DÜRÜSTLÜK / SINIRLAMALAR (lütfen okuyun):
// - Swing high/low tespiti doğası gereği `swingLen` bar GECİKMELİ onaylanır.
//   Bu REPAINT değildir (bir kez onaylanan değer değişmez) ama gerçek
//   zamanlı sinyal her zaman birkaç bar gecikmeli gelir - SMC'nin doğasında
//   var, v2'deki reclaim+momentum onayı bunu AZALTIR ama SIFIRLAMAZ.
// - Order Block/FVG tanımları SMC topluluğunda tartışmalıdır, "tek doğru"
//   tanım yoktur - burada yaygın kullanılan bir versiyon uygulandı.
// - Parametreler (swingLen, trendLen, confirmMaxBars, risk oranları) HİÇBİR
//   VERİYE OPTİMİZE EDİLMEMİŞTİR. Kendi sembolünüzde/zaman diliminizde
//   Strategy Tester ile test edip overfitting riskine dikkat edin (çok
//   fazla parametre ayarlayıp geçmişe "uydurmayın").
// - Emir gerçekleştirme: sinyal bar KAPANIŞINDA üretilir, emir bir SONRAKİ
//   barın AÇILIŞINDA dolar (Python backtest motoruyla aynı "look-ahead
//   önleme" felsefesi).
// - Slipaj Pine'da TICK cinsinden verilir (yüzde değil) - yaklaşık bir
//   varsayımdır.
// - Bu script TradingView'de derlenerek TEST EDİLDİ Mİ: v1 derlendi ve
//   çalıştı (kullanıcı ekran görüntüsüyle doğruladı). Bu v2 değişikliği
//   BENİM TARAFIMDAN derlenip test EDİLMEDİ (bu ortamda Pine Script
//   çalıştıramıyorum) - lütfen derleyip test edin, hata/beklenmedik
//   davranış olursa bildirin.
//
//@version=6
strategy(
     title="BTC SMC Scalp Stratejisi v2",
     shorttitle="BTC-SMC-Scalp-v2",
     overlay=true,
     initial_capital=10000,
     currency=currency.USD,
     commission_type=strategy.commission.percent,
     commission_value=0.1,
     slippage=3,
     calc_on_every_tick=false,
     pyramiding=0,
     max_boxes_count=500,
     max_labels_count=500,
     max_lines_count=500,
     max_bars_back=1000)

// ============================================================================
// AYARLAR
// ============================================================================

// --- Piyasa Yapısı (SMC) ---
swingLen       = input.int(5, "Swing (Yapı) Tespit Penceresi", minval=1, group="Piyasa Yapısı (SMC)",
     tooltip="Bir tepe/dip noktasının onaylanması için her iki yanında kaç bar olması gerektiği. Küçük = daha hızlı ama daha gürültülü.")
obSearchLimit  = input.int(15, "Order Block Arama Mesafesi (bar)", minval=1, group="Piyasa Yapısı (SMC)")
obExtendBars   = input.int(50, "Order Block/FVG Kutusu Uzatma (bar)", minval=1, group="Piyasa Yapısı (SMC)")
obMaxAge       = input.int(300, "Order Block/FVG Maks. Geçerlilik Yaşı (bar)", minval=10, group="Piyasa Yapısı (SMC)",
     tooltip="Bu kadar bar test edilmeden beklerse bölge artık 'bayat' kabul edilip pasifleştirilir.")
useOrderBlocks = input.bool(true, "Order Block girişlerini kullan", group="Piyasa Yapısı (SMC)")
useFVG         = input.bool(true, "Fair Value Gap girişlerini kullan", group="Piyasa Yapısı (SMC)")
fvgMinAtrMult  = input.float(0.0, "Min. FVG Boyutu (ATR katsayısı, 0 = filtre yok)", minval=0.0, step=0.05, group="Piyasa Yapısı (SMC)")

// --- Giriş Onayı ---
confirmMaxBars = input.int(6, "Bölgeye Dokunuştan Sonra Onay Bekleme Süresi (bar)", minval=1, group="Giriş Onayı",
     tooltip="Fiyat bölgeye değdikten sonra bu kadar bar içinde bölgenin üst/alt sınırını geri kazanmazsa (reclaim) sinyal iptal olur.")

// --- Trend Filtresi ---
trendLen       = input.int(200, "Trend Filtresi SMA Periyodu (bar)", minval=1, group="Trend Filtresi",
     tooltip="Bar sayısı - farklı grafik zaman dilimlerinde farklı bir 'uzun vade' anlamına gelir, ona göre ayarlayın.")
useTrendFilter = input.bool(true, "Trend filtresini zorunlu kıl", group="Trend Filtresi")

// --- Momentum Onayı ---
useMomentumFilter = input.bool(true, "Momentum onayını zorunlu kıl (RSI + MACD)", group="Momentum Onayı")
rsiLen             = input.int(14, "RSI Periyodu", minval=1, group="Momentum Onayı")
macdFast           = input.int(12, "MACD Hızlı EMA", minval=1, group="Momentum Onayı")
macdSlow           = input.int(26, "MACD Yavaş EMA", minval=1, group="Momentum Onayı")
macdSignalLen      = input.int(9, "MACD Sinyal EMA", minval=1, group="Momentum Onayı")

// --- Yön ---
allowLongs     = input.bool(true, "Long (alış) işlemlerine izin ver", group="Yön")
allowShorts    = input.bool(false, "Short (satış) işlemlerine izin ver", group="Yön",
     tooltip="OKX spot hesabı short desteklemez - sadece margin/futures kullanıyorsanız açın.")

// --- Risk Yönetimi ---
riskPercent      = input.float(1.0, "İşlem Başına Risk (%)", minval=0.1, maxval=10.0, step=0.1, group="Risk Yönetimi")
rewardRiskRatio  = input.float(2.0, "Risk:Ödül Oranı (Take-Profit)", minval=0.5, step=0.5, group="Risk Yönetimi")
useStructureExit = input.bool(false, "Ek olarak ters BOS/CHoCH oluşunca da çık", group="Risk Yönetimi")

// --- Görsel ---
showSignalLabels = input.bool(true, "AL/SAT/ÇIKIŞ etiketlerini grafikte göster", group="Görsel")
showDashboard    = input.bool(true, "Detay panelini (AL/SAT/BEKLE + gerekçe) göster", group="Görsel")
showOrderBlocks  = input.bool(false, "Order Block kutularını göster (hata ayıklama)", group="Görsel")
showFVG          = input.bool(false, "FVG kutularını göster (hata ayıklama)", group="Görsel")
showStructure    = input.bool(false, "BOS/CHoCH etiketlerini göster (hata ayıklama)", group="Görsel")
showTrendLine    = input.bool(true, "Trend filtresi çizgisini göster", group="Görsel")

// ============================================================================
// TREND FİLTRESİ
// ============================================================================

trendMA = ta.sma(close, trendLen)
plot(showTrendLine ? trendMA : na, title="Trend Filtresi (SMA)", color=color.new(color.orange, 0), linewidth=2)

bullishBias = not useTrendFilter or close > trendMA
bearishBias = not useTrendFilter or close < trendMA

// ============================================================================
// MOMENTUM ONAYI: RSI + MACD
// ============================================================================

rsiVal = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignalLen)

momentumBullish = macdHist > 0 and rsiVal > 50
momentumBearish = macdHist < 0 and rsiVal < 50

momentumOkLong  = not useMomentumFilter or momentumBullish
momentumOkShort = not useMomentumFilter or momentumBearish

// ============================================================================
// PİYASA YAPISI: SWING HIGH/LOW, BOS / CHoCH
// ============================================================================

ph = ta.pivothigh(high, swingLen, swingLen)
pl = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh   = na
var bool  swingHighBroken = true
var float lastSwingLow    = na
var bool  swingLowBroken  = true
var int   structureTrend  = 0   // 1 = boğa yapısı, -1 = ayı yapısı, 0 = henüz belirsiz

if not na(ph)
    lastSwingHigh   := ph
    swingHighBroken := false

if not na(pl)
    lastSwingLow   := pl
    swingLowBroken := false

bullishBreak = not swingHighBroken and not na(lastSwingHigh) and close > lastSwingHigh
bearishBreak = not swingLowBroken and not na(lastSwingLow) and close < lastSwingLow

isCHoCHUp   = bullishBreak and structureTrend == -1
isBOSUp     = bullishBreak and structureTrend != -1
isCHoCHDown = bearishBreak and structureTrend == 1
isBOSDown   = bearishBreak and structureTrend != 1

if bullishBreak
    structureTrend  := 1
    swingHighBroken := true
    if showStructure
        label.new(bar_index, high, isCHoCHUp ? "CHoCH↑" : "BOS↑",
             style=label.style_label_down, color=color.new(color.lime, 20), textcolor=color.black, size=size.small)

if bearishBreak
    structureTrend := -1
    swingLowBroken := true
    if showStructure
        label.new(bar_index, low, isCHoCHDown ? "CHoCH↓" : "BOS↓",
             style=label.style_label_up, color=color.new(color.red, 20), textcolor=color.white, size=size.small)

// ============================================================================
// ORDER BLOCK: kırılıma yol açan hareketten önceki son ters renkli mum
// ============================================================================

findOppositeCandle(isBullishOB, searchLimit) =>
    float obTop = na
    float obBottom = na
    int obBar = na
    for i = 1 to searchLimit
        isBearishCandle = close[i] < open[i]
        isBullishCandle = close[i] > open[i]
        if (isBullishOB and isBearishCandle) or (not isBullishOB and isBullishCandle)
            obTop := high[i]
            obBottom := low[i]
            obBar := bar_index - i
            break
    [obTop, obBottom, obBar]

var float bullOB_top    = na
var float bullOB_bottom = na
var int   bullOB_bar    = na
var bool  bullOB_active = false
var box   bullOB_box    = na

var float bearOB_top    = na
var float bearOB_bottom = na
var int   bearOB_bar    = na
var bool  bearOB_active = false
var box   bearOB_box    = na

if bullishBreak
    [obTop, obBottom, obBar] = findOppositeCandle(true, obSearchLimit)
    if not na(obTop)
        bullOB_top    := obTop
        bullOB_bottom := obBottom
        bullOB_bar    := obBar
        bullOB_active := true
        if showOrderBlocks
            bullOB_box := box.new(left=obBar, top=obTop, right=bar_index + obExtendBars, bottom=obBottom,
                 bgcolor=color.new(color.teal, 85), border_color=color.new(color.teal, 40))

if bearishBreak
    [obTop, obBottom, obBar] = findOppositeCandle(false, obSearchLimit)
    if not na(obTop)
        bearOB_top    := obTop
        bearOB_bottom := obBottom
        bearOB_bar    := obBar
        bearOB_active := true
        if showOrderBlocks
            bearOB_box := box.new(left=obBar, top=obTop, right=bar_index + obExtendBars, bottom=obBottom,
                 bgcolor=color.new(color.maroon, 85), border_color=color.new(color.maroon, 40))

// Mitigasyon: fiyat bölgenin İÇİNDEN kapanışla geçerse bölge geçersizleşir
if bullOB_active and not na(bullOB_bottom) and close < bullOB_bottom
    bullOB_active := false
    if not na(bullOB_box)
        box.set_right(bullOB_box, bar_index)
        box.set_bgcolor(bullOB_box, color.new(color.gray, 92))
        box.set_border_color(bullOB_box, color.new(color.gray, 60))

if bearOB_active and not na(bearOB_top) and close > bearOB_top
    bearOB_active := false
    if not na(bearOB_box)
        box.set_right(bearOB_box, bar_index)
        box.set_bgcolor(bearOB_box, color.new(color.gray, 92))
        box.set_border_color(bearOB_box, color.new(color.gray, 60))

// Yaşlanma: uzun süredir test edilmemiş "bayat" bölgeleri pasifleştir
if bullOB_active and not na(bullOB_bar) and (bar_index - bullOB_bar) > obMaxAge
    bullOB_active := false

if bearOB_active and not na(bearOB_bar) and (bar_index - bearOB_bar) > obMaxAge
    bearOB_active := false

// ============================================================================
// FAIR VALUE GAP (FVG): 3 mumluk fiyat boşluğu
// ============================================================================

atrVal = ta.atr(14)

bullishFVG = low > high[2] and (fvgMinAtrMult == 0 or (low - high[2]) > atrVal * fvgMinAtrMult)
bearishFVG = high < low[2] and (fvgMinAtrMult == 0 or (low[2] - high) > atrVal * fvgMinAtrMult)

var float fvgBull_top    = na
var float fvgBull_bottom = na
var int   fvgBull_bar    = na
var bool  fvgBull_active = false
var box   fvgBull_box    = na

var float fvgBear_top    = na
var float fvgBear_bottom = na
var int   fvgBear_bar    = na
var bool  fvgBear_active = false
var box   fvgBear_box    = na

if bullishFVG
    fvgBull_top    := low
    fvgBull_bottom := high[2]
    fvgBull_bar    := bar_index
    fvgBull_active := true
    if showFVG
        fvgBull_box := box.new(left=bar_index - 2, top=fvgBull_top, right=bar_index + obExtendBars, bottom=fvgBull_bottom,
             bgcolor=color.new(color.blue, 85), border_color=color.new(color.blue, 50))

if bearishFVG
    fvgBear_top    := low[2]
    fvgBear_bottom := high
    fvgBear_bar    := bar_index
    fvgBear_active := true
    if showFVG
        fvgBear_box := box.new(left=bar_index - 2, top=fvgBear_top, right=bar_index + obExtendBars, bottom=fvgBear_bottom,
             bgcolor=color.new(color.purple, 85), border_color=color.new(color.purple, 50))

if fvgBull_active and not na(fvgBull_bottom) and close < fvgBull_bottom
    fvgBull_active := false
    if not na(fvgBull_box)
        box.set_right(fvgBull_box, bar_index)
        box.set_bgcolor(fvgBull_box, color.new(color.gray, 92))

if fvgBear_active and not na(fvgBear_top) and close > fvgBear_top
    fvgBear_active := false
    if not na(fvgBear_box)
        box.set_right(fvgBear_box, bar_index)
        box.set_bgcolor(fvgBear_box, color.new(color.gray, 92))

if fvgBull_active and not na(fvgBull_bar) and (bar_index - fvgBull_bar) > obMaxAge
    fvgBull_active := false

if fvgBear_active and not na(fvgBear_bar) and (bar_index - fvgBear_bar) > obMaxAge
    fvgBear_active := false

// ============================================================================
// GİRİŞ ONAYI: bölgeye dokunuş -> belirli süre içinde ÜST/ALT sınırı GERİ
// KAZANMA (reclaim). Sadece "değme" YETERLİ DEĞİL - v1'in sorunu buydu.
// ============================================================================

touchingBullOB   = useOrderBlocks and bullOB_active and low <= bullOB_top and low >= bullOB_bottom
touchingBullFVG  = useFVG and fvgBull_active and low <= fvgBull_top and low >= fvgBull_bottom
touchingBullZone = touchingBullOB or touchingBullFVG

touchingBearOB   = useOrderBlocks and bearOB_active and high >= bearOB_bottom and high <= bearOB_top
touchingBearFVG  = useFVG and fvgBear_active and high >= fvgBear_bottom and high <= fvgBear_top
touchingBearZone = touchingBearOB or touchingBearFVG

var bool  bullZonePending    = false
var int   bullZonePendingBar = na
var float bullZonePendingTop = na

var bool  bearZonePending       = false
var int   bearZonePendingBar    = na
var float bearZonePendingBottom = na

// Yapı ters yöne dönerse bekleyen kurulumu iptal et
if bearishBreak
    bullZonePending := false
if bullishBreak
    bearZonePending := false

if touchingBullZone and structureTrend == 1 and not bullZonePending
    bullZonePending    := true
    bullZonePendingBar := bar_index
    bullZonePendingTop := touchingBullOB ? bullOB_top : fvgBull_top

if bullZonePending and (bar_index - bullZonePendingBar) > confirmMaxBars
    bullZonePending := false

if touchingBearZone and structureTrend == -1 and not bearZonePending
    bearZonePending       := true
    bearZonePendingBar    := bar_index
    bearZonePendingBottom := touchingBearOB ? bearOB_bottom : fvgBear_bottom

if bearZonePending and (bar_index - bearZonePendingBar) > confirmMaxBars
    bearZonePending := false

bullReclaimConfirmed = bullZonePending and not na(bullZonePendingTop) and close > bullZonePendingTop and close > open
bearReclaimConfirmed = bearZonePending and not na(bearZonePendingBottom) and close < bearZonePendingBottom and close < open

if bullReclaimConfirmed
    bullZonePending := false
if bearReclaimConfirmed
    bearZonePending := false

// ============================================================================
// GİRİŞ MANTIĞI: yapı yönü + trend filtresi + bölge onayı + momentum
// ============================================================================

longCondition  = allowLongs and bullishBias and structureTrend == 1 and bullReclaimConfirmed and momentumOkLong and strategy.position_size == 0
shortCondition = allowShorts and bearishBias and structureTrend == -1 and bearReclaimConfirmed and momentumOkShort and strategy.position_size == 0

// ============================================================================
// RİSK YÖNETİMİ: stop-loss'a olan mesafeye göre pozisyon boyutu (%risk sabit)
// ============================================================================

longStop  = useOrderBlocks and bullOB_active ? bullOB_bottom : fvgBull_bottom
shortStop = useOrderBlocks and bearOB_active ? bearOB_top : fvgBear_top

longRiskPerUnit  = close - longStop
shortRiskPerUnit = shortStop - close

riskAmount = strategy.equity * (riskPercent / 100)
longQty  = longRiskPerUnit > 0 ? riskAmount / longRiskPerUnit : na
shortQty = shortRiskPerUnit > 0 ? riskAmount / shortRiskPerUnit : na

if longCondition and not na(longQty) and longQty > 0
    strategy.entry("Long", strategy.long, qty=longQty)
    takeProfitPrice = close + longRiskPerUnit * rewardRiskRatio
    strategy.exit("Long Exit", from_entry="Long", stop=longStop, limit=takeProfitPrice)
    alert("BTC LONG sinyali: yapı+bölge+momentum confluence, fiyat=" + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

if shortCondition and not na(shortQty) and shortQty > 0
    strategy.entry("Short", strategy.short, qty=shortQty)
    takeProfitPriceShort = close - shortRiskPerUnit * rewardRiskRatio
    strategy.exit("Short Exit", from_entry="Short", stop=shortStop, limit=takeProfitPriceShort)
    alert("BTC SHORT sinyali: yapı+bölge+momentum confluence, fiyat=" + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

if useStructureExit and strategy.position_size > 0 and bearishBreak
    strategy.close("Long", comment="Ters BOS/CHoCH")

if useStructureExit and strategy.position_size < 0 and bullishBreak
    strategy.close("Short", comment="Ters BOS/CHoCH")

// ============================================================================
// SİNYAL DURUMU: AL / SAT / BEKLE (kullanıcının istediği 3 durum)
// ============================================================================

positionChanged = strategy.position_size != strategy.position_size[1]
justClosedLong  = positionChanged and strategy.position_size == 0 and strategy.position_size[1] > 0
justClosedShort = positionChanged and strategy.position_size == 0 and strategy.position_size[1] < 0

var string currentSignal = "BEKLE"

if longCondition
    currentSignal := "AL"
else if shortCondition
    currentSignal := "SAT"
else if justClosedLong
    currentSignal := "SAT"
else if justClosedShort
    currentSignal := "AL"
else if strategy.position_size > 0
    currentSignal := "AL"
else if strategy.position_size < 0
    currentSignal := "SAT"
else
    currentSignal := "BEKLE"

if showSignalLabels and longCondition
    label.new(bar_index, low, "AL", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.normal)
if showSignalLabels and shortCondition
    label.new(bar_index, high, "SAT", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.normal)
if showSignalLabels and (justClosedLong or justClosedShort)
    label.new(bar_index, justClosedLong ? high : low, "ÇIKIŞ",
         style=justClosedLong ? label.style_label_down : label.style_label_up,
         color=color.new(color.orange, 0), textcolor=color.black, size=size.small)

// ============================================================================
// DETAYLI GEREKÇE: her koşulun tek tek durumu + Long/Short skoru
// ============================================================================

countAndMissing(c1, n1, c2, n2, c3, n3, c4, n4, c5, n5) =>
    int passed = 0
    string missing = ""
    if c1
        passed += 1
    else
        missing += n1 + ", "
    if c2
        passed += 1
    else
        missing += n2 + ", "
    if c3
        passed += 1
    else
        missing += n3 + ", "
    if c4
        passed += 1
    else
        missing += n4 + ", "
    if c5
        passed += 1
    else
        missing += n5 + ", "
    [passed, missing]

bullZoneAvailable = (useOrderBlocks and bullOB_active) or (useFVG and fvgBull_active)
bearZoneAvailable = (useOrderBlocks and bearOB_active) or (useFVG and fvgBear_active)

[longPassed, longMissing]   = countAndMissing(bullishBias, "Trend(Boğa)", structureTrend == 1, "Yapı(BOS/CHoCH↑)", bullZoneAvailable, "Bölge(OB/FVG)", bullZonePending or bullReclaimConfirmed, "Dokunuş+Onay(Reclaim)", momentumOkLong, "Momentum(RSI/MACD)")
[shortPassed, shortMissing] = countAndMissing(bearishBias, "Trend(Ayı)", structureTrend == -1, "Yapı(BOS/CHoCH↓)", bearZoneAvailable, "Bölge(OB/FVG)", bearZonePending or bearReclaimConfirmed, "Dokunuş+Onay(Reclaim)", momentumOkShort, "Momentum(RSI/MACD)")

string decisionReason = ""
if currentSignal == "AL" and longCondition
    decisionReason := "YENİ LONG GİRİŞİ: " + str.tostring(longPassed) + "/5 koşul sağlandı (trend+yapı+bölge+onay+momentum aynı yönde)."
else if currentSignal == "AL"
    decisionReason := "LONG pozisyonda tutuluyor (stop-loss veya take-profit bekleniyor)."
else if currentSignal == "SAT" and shortCondition
    decisionReason := "YENİ SHORT GİRİŞİ: " + str.tostring(shortPassed) + "/5 koşul sağlandı."
else if currentSignal == "SAT" and justClosedLong
    decisionReason := "LONG POZİSYON KAPANDI (stop-loss veya take-profit tetiklendi)."
else if currentSignal == "SAT" and justClosedShort
    decisionReason := "SHORT POZİSYON KAPANDI."
else if currentSignal == "SAT"
    decisionReason := "SHORT pozisyonda tutuluyor (stop-loss veya take-profit bekleniyor)."
else
    decisionReason := "BEKLE: confluence tamamlanmadı, aşağıdaki eksik koşullara bakın."

string detailText = "TREND: " + (bullishBias ? "Fiyat SMA üzerinde (Boğa)" : bearishBias ? "Fiyat SMA altında (Ayı)" : "Nötr") + "\n" +
     "YAPI: " + (structureTrend == 1 ? "Son kırılım ↑ (Boğa yapısı)" : structureTrend == -1 ? "Son kırılım ↓ (Ayı yapısı)" : "Henüz belirsiz") + "\n" +
     "ORDER BLOCK: Boğa=" + (bullOB_active ? "Aktif" : "Yok") + " | Ayı=" + (bearOB_active ? "Aktif" : "Yok") + "\n" +
     "FVG: Boğa=" + (fvgBull_active ? "Aktif" : "Yok") + " | Ayı=" + (fvgBear_active ? "Aktif" : "Yok") + "\n" +
     "MOMENTUM: RSI=" + str.tostring(rsiVal, "#.#") + " MACD Hist=" + str.tostring(macdHist, "#.##") + "\n" +
     "LONG: " + str.tostring(longPassed) + "/5" + (longPassed < 5 ? " (eksik: " + longMissing + ")" : " ✓ TAMAMLANDI") + "\n" +
     "SHORT: " + str.tostring(shortPassed) + "/5" + (shortPassed < 5 ? " (eksik: " + shortMissing + ")" : " ✓ TAMAMLANDI")

// ============================================================================
// PANEL: AL / SAT / BEKLE + en detaylı gerekçe
// ============================================================================

var table dash = table.new(position.top_right, 2, 7, border_width=1, border_color=color.gray, frame_color=color.gray, frame_width=1)

signalColor = currentSignal == "AL" ? color.new(color.green, 0) : currentSignal == "SAT" ? color.new(color.red, 0) : color.new(color.gray, 30)

if showDashboard and barstate.islast
    table.cell(dash, 0, 0, "SİNYAL", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.normal)
    table.cell(dash, 1, 0, currentSignal, text_color=color.white, bgcolor=signalColor, text_size=size.large)

    table.cell(dash, 0, 1, "Trend", text_color=color.silver, bgcolor=color.new(color.black, 0), text_size=size.small)
    table.cell(dash, 1, 1, bullishBias ? "BOĞA" : bearishBias ? "AYI" : "YATAY", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small)

    table.cell(dash, 0, 2, "Yapı", text_color=color.silver, bgcolor=color.new(color.black, 0), text_size=size.small)
    table.cell(dash, 1, 2, structureTrend == 1 ? "BOĞA (↑)" : structureTrend == -1 ? "AYI (↓)" : "BELİRSİZ", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small)

    table.cell(dash, 0, 3, "Long / Short Skoru", text_color=color.silver, bgcolor=color.new(color.black, 0), text_size=size.small)
    table.cell(dash, 1, 3, str.tostring(longPassed) + "/5  |  " + str.tostring(shortPassed) + "/5", text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.small)

    table.cell(dash, 0, 4, "Karar", text_color=color.silver, bgcolor=color.new(color.black, 0), text_size=size.small)
    table.cell(dash, 1, 4, decisionReason, text_color=color.yellow, bgcolor=color.new(color.black, 0), text_size=size.small)

    table.cell(dash, 0, 5, "Detay", text_color=color.silver, bgcolor=color.new(color.black, 0), text_size=size.small)
    table.cell(dash, 1, 5, detailText, text_color=color.white, bgcolor=color.new(color.black, 0), text_size=size.tiny, text_halign=text.align_left)
